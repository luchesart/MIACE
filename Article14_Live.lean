/- BEGIN SOURCE: Article14/PhysicalStep.lean -/
section
                                   

/-!
# The actual zero-history unit-step trajectory

This file starts from the implemented, uncentered finite-dimensional plant and
shared-D controller.  Centering, the homogeneous after-delay equation, and all
signal hypotheses are conclusions.  Existence of the forced trajectory is not
asserted: the results apply to each actual solution with the stated regularity.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open scoped Topology
open PhysicalPlant PhysicalLaplace
variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The actual physical command generated by the unit-step controller. -/
noncomputable def stepCommand (C : n → ℝ) (Kp Ti Td Tf b c : ℝ)
    (q : ℝ → (n → ℝ) × ℝ × ℝ) (t : ℝ) : ℝ :=
  (sharedControllerRhs Kp Ti Td Tf b c 1 (finitePlantOutput C (q t).1)
    (q t).2.1 (q t).2.2).2.2

/-- A given physical zero-history step response.  The initial transport
interval receives zero input.  After its endpoint the ordinary vector equation
holds classically, as expected for a continuous command and a retarded plant.
No transform, asymptotic limit, integrability, or exponential estimate is a
field of this predicate. -/
structure StepLoopDynamics (A : Matrix n n ℝ) (B C : n → ℝ)
    (Kp Ti Td Tf L b c : ℝ) (q : ℝ → (n → ℝ) × ℝ × ℝ) : Prop where
  continuous : ContinuousOn q (Ici 0)
  state_ac : ∀ j T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => (q t).1 j) 0 T
  integral_ac : ∀ T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => (q t).2.1) 0 T
  filter_ac : ∀ T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => (q t).2.2) 0 T
  initial : q 0 = 0
  state_ode : ∀ j, ∀ᵐ t : ℝ, 0 < t →
    deriv (fun s => (q s).1 j) t = (∑ l, A j l * (q t).1 l) +
      B j * (if t ≤ L then 0 else stepCommand C Kp Ti Td Tf b c q (t-L))
  integral_ode : ∀ᵐ t : ℝ, 0 < t → deriv (fun s => (q s).2.1) t =
    (sharedControllerRhs Kp Ti Td Tf b c 1 (finitePlantOutput C (q t).1)
      (q t).2.1 (q t).2.2).1
  filter_ode : ∀ᵐ t : ℝ, 0 < t → deriv (fun s => (q s).2.2) t =
    (sharedControllerRhs Kp Ti Td Tf b c 1 (finitePlantOutput C (q t).1)
      (q t).2.1 (q t).2.2).2.1
  after_delay : ∀ t, L < t → HasDerivAt q
    (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c (fun _ => 1) (fun θ => q (t+θ))) t

-- The error observation of the translated plant state is the physical error.
omit [DecidableEq n] in
theorem step_centered_error (C xInf : n → ℝ) (Ti k Kp b c : ℝ)
    (hout : (∑ j, C j*xInf j) = 1) (q : (n → ℝ) × ℝ × ℝ) :
    errorObservation C (q-pidfEquilibrium xInf Ti k Kp b c) =
      1-finitePlantOutput C q.1 := by
  rw [errorObservation_apply]
  simp only [pidfEquilibrium, Prod.fst_sub, Pi.sub_apply, mul_sub,
    Finset.sum_sub_distrib, hout, finitePlantOutput]
  ring

-- The same translated state gives the actual normalized physical command.
omit [DecidableEq n] in
theorem step_centered_command (C xInf : n → ℝ) (Kp Ti Td Tf k b c : ℝ)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0)
    (hout : (∑ j, C j*xInf j) = 1) (q : ℝ → (n → ℝ) × ℝ × ℝ) (t : ℝ) :
    commandObservation C k Kp Ti Td Tf (q t-pidfEquilibrium xInf Ti k Kp b c) =
      k*stepCommand C Kp Ti Td Tf b c q t-1 := by
  rw [commandObservation_apply, step_centered_error C xInf Ti k Kp b c hout]
  have hh := (sharedController_step_centered Kp Ti Td Tf k b c
    (1-finitePlantOutput C (q t).1) ((q t).2.1-meanTime Ti k Kp b)
    ((q t).2.2-(c-1)) hTi hk hKp).2.2
  simpa only [sub_sub_cancel, sub_add_cancel, pidfEquilibrium, Prod.snd_sub,
    Prod.fst_sub, stepCommand] using hh.symm

-- Article 14, Theorems 14–17: zero-state physical equations supply every
-- centered differential equation and initial condition used in the bridge.
omit [DecidableEq n] in
theorem centeredLoopDynamics_of_step
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c
      (fun t => q t-pidfEquilibrium xInf Ti k Kp b c) := by
  constructor
  · intro j T hT
    exact (h.state_ac j T hT).sub
      (ContDiffOn.absolutelyContinuousOnInterval (by fun_prop))
  · intro j
    simp [h.initial, pidfEquilibrium]
  · intro j
    filter_upwards [h.state_ode j] with t ht hpos
    change deriv (fun s => (q s).1 j-xInf j) t = _
    rw [deriv_sub_const, ht hpos]
    simp only [pidfEquilibrium, Prod.fst_sub, Pi.sub_apply, mul_sub,
      Finset.sum_sub_distrib, centeredDelay]
    by_cases hwait : t ≤ L
    · simp only [hwait, ite_true, mul_zero, add_zero]
      linarith [heq j]
    · simp only [hwait, ite_false]
      have hcmd := step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout q (t-L)
      change commandObservation C k Kp Ti Td Tf
        (q (t-L)-(xInf, meanTime Ti k Kp b, c-1)) = _ at hcmd
      rw [hcmd]
      have heqj := heq j
      field_simp at heqj ⊢
      nlinarith
  · have hc := centeredPIDFDynamics_of_step
      (y := fun t => finitePlantOutput C (q t).1)
      (u := stepCommand C Kp Ti Td Tf b c q)
      (I := fun t => (q t).2.1) (F := fun t => (q t).2.2)
      Kp Ti Td Tf k b c hTi hk hKp h.integral_ac h.filter_ac
      h.integral_ode h.filter_ode
      (by simp [h.initial]) (by simp [h.initial]) (by exact Filter.Eventually.of_forall (fun _ => rfl))
    simp only [step_centered_error C xInf Ti k Kp b c hout,
      step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout]
    simpa only [pidfEquilibrium, Prod.snd_sub, Prod.fst_sub] using hc

/-- Continuous linear realization of the finite plant state matrix. -/
noncomputable def finiteStateMap (A : Matrix n n ℝ) : (n → ℝ) →L[ℝ] (n → ℝ) :=
  ContinuousLinearMap.pi (fun j => ∑ l, A j l • ContinuousLinearMap.proj l)

/-- Continuous linear input map of the finite plant. -/
noncomputable def finiteInputMap (B : n → ℝ) : ℝ →L[ℝ] (n → ℝ) :=
  ContinuousLinearMap.pi (fun j => B j • ContinuousLinearMap.id ℝ ℝ)

/-- Continuous linear strictly proper output map of the finite plant. -/
noncomputable def finiteOutputMap (C : n → ℝ) : (n → ℝ) →L[ℝ] ℝ :=
  ∑ j, C j • ContinuousLinearMap.proj j

omit [DecidableEq n] in
theorem finiteStateMap_apply (A : Matrix n n ℝ) (x : n → ℝ) (j : n) :
    finiteStateMap A x j = ∑ l, A j l*x l := by simp [finiteStateMap]

omit [Fintype n] [DecidableEq n] in
theorem finiteInputMap_apply (B : n → ℝ) (u : ℝ) (j : n) :
    finiteInputMap B u j = B j*u := by simp [finiteInputMap]

omit [DecidableEq n] in
theorem finiteOutputMap_eq (C : n → ℝ) :
    ⇑(finiteOutputMap C) = finitePlantOutput C := by
  funext x
  simp [finiteOutputMap, finitePlantOutput]

omit [DecidableEq n] in
theorem finiteLinearPlantDynamics_eq (A : Matrix n n ℝ) (B : n → ℝ) :
    linearPlantDynamics (finiteStateMap A) (finiteInputMap B) =
      finitePlantDynamics A B := by
  funext x u
  ext j
  simp [linearPlantDynamics, finitePlantDynamics, finiteStateMap_apply, finiteInputMap_apply]

-- The actual raw post-delay equation, translated about the verified plant
-- and controller equilibrium, is exactly the homogeneous delayed equation
-- used by the all-history internal exponential stability predicate.
omit [DecidableEq n] in
theorem centeredStep_after_delay
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    ∀ t, L < t → HasDerivAt (fun s => q s-pidfEquilibrium xInf Ti k Kp b c)
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0)
        (fun θ => q (t+θ)-pidfEquilibrium xInf Ti k Kp b c)) t := by
  have heq' : finiteStateMap A xInf + finiteInputMap B (1/k) = 0 := by
    ext j
    simpa [finiteStateMap_apply, finiteInputMap_apply, div_eq_mul_inv] using heq j
  have hout' : finiteOutputMap C xInf = 1 := by
    simpa [finiteOutputMap_eq, finitePlantOutput] using hout
  intro t ht
  have hraw : HasDerivAt q
      (retardedSharedRhs (finiteOutputMap C)
        (linearPlantDynamics (finiteStateMap A) (finiteInputMap B))
        Kp Ti Td Tf L b c (fun _ => 1) (fun θ => q (t+θ))) t := by
    simpa only [finiteOutputMap_eq, finiteLinearPlantDynamics_eq] using h.after_delay t ht
  simpa only [finiteOutputMap_eq, finiteLinearPlantDynamics_eq] using
    centeredTrajectory_hasDerivAt (finiteStateMap A) (finiteInputMap B) (finiteOutputMap C)
      Kp Ti Td Tf L k b c xInf hk hKp hTi heq' hout' q t hraw

-- Article 14, Theorems 14–17: end-to-end physical zero-history response
-- theorem.  Its assumptions are the actual raw equations, the same-loop
-- all-history exponential stability, and elementary plant equilibrium/DC
-- regularity.  Local transfer and actual error area are both proved results.
theorem stable_step_transfer_and_area
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0) :
    LocalTransferResponse (fun t => 1-finitePlantOutput C (q t).1)
      (fun t => k*stepCommand C Kp Ti Td Tf b c q t-1)
      (normalizedTransfer A B C k) L ∧
    (∫ t, (1-finitePlantOutput C (q t).1) ∂halfLine) = meanTime Ti k Kp b := by
  have hd := centeredLoopDynamics_of_step h hTi hk hKp heq hout
  have hc : ContinuousOn (fun t => q t-pidfEquilibrium xInf Ti k Kp b c) (Ici 0) :=
    h.continuous.sub continuousOn_const
  have hz := stable_centeredLoop_transfer_and_area hd hL hc hs
    (centeredStep_after_delay h hTi hk hKp heq hout) heq hout hA
  simpa only [step_centered_error C xInf Ti k Kp b c hout,
    step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout] using hz

-- Article 14, Proposition 15 and Theorem 17: both actual signed areas and
-- the exact error transform follow from the raw stable physical response.
theorem stable_step_signal_identities
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0) :
    let e := fun t => 1-finitePlantOutput C (q t).1
    let v := fun t => k*stepCommand C Kp Ti Td Tf b c q t-1
    (∫ t, e t ∂halfLine) = meanTime Ti k Kp b ∧
    (∫ t, v t ∂halfLine) = residenceTime A C xInf + L - meanTime Ti k Kp b ∧
    laplace e =ᶠ[𝓝[>] (0 : ℝ)]
      clearedError (inverseDelayedPlant (normalizedTransfer A B C k) k L)
        Kp (Kp/Ti) (Kp*Td) Tf b c := by
  have hd := centeredLoopDynamics_of_step h hTi hk hKp heq hout
  have hc : ContinuousOn (fun t => q t-pidfEquilibrium xInf Ti k Kp b c) (Ici 0) :=
    h.continuous.sub continuousOn_const
  have hz := stable_centeredLoop_signal_identities hd hL hc hs
    (centeredStep_after_delay h hTi hk hKp heq hout) heq hout hA hk hKp hTi hTf
  simpa only [step_centered_error C xInf Ti k Kp b c hout,
    step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout] using hz

-- Article 14, Theorem 17: actual raw unit-step error and normalized command
-- satisfy the universal MIACE estimate; no signal balance is an assumption.
theorem stable_step_miace_bound
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (α : ℝ) (hα : 0 < α) (hΓ : 0 ≤ residenceTime A C xInf + L) :
    (residenceTime A C xInf + L)*Real.sqrt (α/(1+α)) ≤
      miace α (fun t => 1-finitePlantOutput C (q t).1)
        (fun t => k*stepCommand C Kp Ti Td Tf b c q t-1) halfLine := by
  have hd := centeredLoopDynamics_of_step h hTi hk hKp heq hout
  have hc : ContinuousOn (fun t => q t-pidfEquilibrium xInf Ti k Kp b c) (Ici 0) :=
    h.continuous.sub continuousOn_const
  have hz := stable_centeredLoop_miace_bound hd hL hc hs
    (centeredStep_after_delay h hTi hk hKp heq hout) heq hout hA α hα hΓ
  simpa only [step_centered_error C xInf Ti k Kp b c hout,
    step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout] using hz

-- Article 14, Proposition 15: the first error moment of the raw physical
-- step response, with its decay derived entirely from internal stability.
theorem stable_step_first_error_moment
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0) :
    (∫ t, t*(1-finitePlantOutput C (q t).1) ∂halfLine) =
      secondErrorMoment Kp (Kp/Ti) (Kp*Td) k (residenceTime A C xInf+L)
        (meanTime Ti k Kp b) c := by
  have hd := centeredLoopDynamics_of_step h hTi hk hKp heq hout
  have hc : ContinuousOn (fun t => q t-pidfEquilibrium xInf Ti k Kp b c) (Ici 0) :=
    h.continuous.sub continuousOn_const
  have hz := stable_centeredLoop_first_error_moment hd hL hc hs
    (centeredStep_after_delay h hTi hk hKp heq hout) heq hout hA hk hKp hTi hTf
  simpa only [step_centered_error C xInf Ti k Kp b c hout] using hz

-- Article 14, Proposition 15: the resulting exact ITAE formula requires
-- positivity only for the actual output error, independently of the command.
theorem stable_step_itae
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (he : ∀ᵐ t ∂halfLine, 0 ≤ 1-finitePlantOutput C (q t).1) :
    (∫ t, t*|1-finitePlantOutput C (q t).1| ∂halfLine) =
      secondErrorMoment Kp (Kp/Ti) (Kp*Td) k (residenceTime A C xInf+L)
        (meanTime Ti k Kp b) c := by
  calc
    (∫ t, t*|1-finitePlantOutput C (q t).1| ∂halfLine) =
        (∫ t, t*(1-finitePlantOutput C (q t).1) ∂halfLine) := by
      apply integral_congr_ae
      filter_upwards [he] with t ht
      rw [abs_of_nonneg ht]
    _ = _ := stable_step_first_error_moment h hTi hk hKp hTf hL hs heq hout hA

-- Article 14, Theorem 17: the exact MIACE objective for the actual physical
-- signals when both output error and centered command are nonnegative.
theorem stable_step_nonnegative_miace
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (he : ∀ᵐ t ∂halfLine, 0 ≤ 1-finitePlantOutput C (q t).1)
    (hv : ∀ᵐ t ∂halfLine, 0 ≤ k*stepCommand C Kp Ti Td Tf b c q t-1) (α : ℝ) :
    miace α (fun t => 1-finitePlantOutput C (q t).1)
      (fun t => k*stepCommand C Kp Ti Td Tf b c q t-1) halfLine =
    Real.sqrt ((meanTime Ti k Kp b)^2+
      α*(residenceTime A C xInf+L-meanTime Ti k Kp b)^2) := by
  have hd := centeredLoopDynamics_of_step h hTi hk hKp heq hout
  have hc : ContinuousOn (fun t => q t-pidfEquilibrium xInf Ti k Kp b c) (Ici 0) :=
    h.continuous.sub continuousOn_const
  have he' : ∀ᵐ t ∂halfLine, 0 ≤
      errorObservation C (q t-pidfEquilibrium xInf Ti k Kp b c) := by
    simpa only [step_centered_error C xInf Ti k Kp b c hout] using he
  have hv' : ∀ᵐ t ∂halfLine, 0 ≤ commandObservation C k Kp Ti Td Tf
      (q t-pidfEquilibrium xInf Ti k Kp b c) := by
    simpa only [step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout] using hv
  have hz := stable_centeredLoop_nonnegative_miace hd hL hc hs
    (centeredStep_after_delay h hTi hk hKp heq hout) heq hout hA he' hv' α
  simpa only [step_centered_error C xInf Ti k Kp b c hout,
    step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout] using hz

-- Article 14, Theorem 17: exact excess over the MIACE lower bound for the
-- actual raw physical step response, including both negative signal areas.
theorem stable_step_miace_gap
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (α : ℝ) (hα : 0 < α) :
    let e := fun t => 1-finitePlantOutput C (q t).1
    let v := fun t => k*stepCommand C Kp Ti Td Tf b c q t-1
    let Γ := residenceTime A C xInf+L
    (miace α e v halfLine)^2-α*Γ^2/(1+α) =
      4*α/(1+α)*(negArea e halfLine+negArea v halfLine)*
        (Γ+(negArea e halfLine+negArea v halfLine))+
      (absArea e halfLine-α*absArea v halfLine)^2/(1+α) := by
  have hp := (stable_step_transfer_and_area h hTi hk hKp hL hs heq hout hA).1
  exact local_transfer_miace_gap hp α (residenceTime A C xInf) hα
    (normalizedTransfer_hasDerivAt_zero heq hout hA) (normalizedTransfer_zero heq hout hA)

end Article14
end
