  have hd := (compactLaplace_deriv (remainderJ_continuous r n δ) δ (0 : ℂ)).real_of_complex
  have he : (∫ t in 0..δ, -(t : ℂ)*Complex.exp (-(0 : ℂ)*(t : ℂ))*(remainderJ r n δ t : ℂ))=
      (-compactMoment (remainderJ r n δ) δ 1 : ℝ) := by
    simp only [neg_zero,zero_mul,Complex.exp_zero,mul_one,compactMoment,pow_one]
    rw [← intervalIntegral.integral_neg,← intervalIntegral.integral_ofReal]
    apply intervalIntegral.integral_congr
