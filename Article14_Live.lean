theorem weightedControl_zero (η : ℝ) : WeightedControl η (fun _ => 0) 0 := by
  have he : expWeight η (fun _ => 0)=(fun _ : ℝ => (0 : ℝ)) := by funext t; simp [expWeight]
  refine ⟨le_rfl,?_,?_,?_⟩
  · rw [he]; exact integrable_zero _ _ _
  · rw [he]; simp
  · rw [he]; simp

