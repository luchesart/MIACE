  let f := fun t => ∑ i, |x i t|
  have hf : Continuous f := continuous_finsetSum _ (fun i _ => (hc i).abs)
  have hn (t : ℝ) : 0≤f t := Finset.sum_nonneg (fun i _ => abs_nonneg _)
  intro T hT
