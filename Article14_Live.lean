/-! Construct the ordinary fundamental solution in the nonoscillatory
range from a positive renewal kernel. The spectral criterion alone is
not used as a time-domain stability theorem. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

-- @paper-step lem:delayed_cancellation/positive_scalar_renewal_kernel
theorem scalarDelay_kernel_nonneg {l : ℝ} (hl : 0<l) (δ t : ℝ) :
    0≤twoRateK 1 l l δ t := by
  by_cases ht : t∈Ico (0 : ℝ) δ
  · simp only [twoRateK,twoRateD,indicator_of_mem ht,one_mul,mul_one,sub_self,mul_zero,zero_mul,add_zero]
    positivity
  · simp [twoRateK,ht]

-- @paper-step lem:delayed_cancellation/constructed_positive_decaying_fundamental
theorem scalarDelay_positive_resolvent {x δ l : ℝ} (hx : 0<x) (hδ : 0≤δ)
    (hl : 0<l) (he : l*Real.exp (-l*δ)=x) :
    ∃ E : ℝ → ℝ, Continuous E ∧
      (∀ a b, AbsolutelyContinuousOnInterval E a b) ∧ E 0=1 ∧
      (∀ t, 0≤t → 0<E t) ∧ Integrable E halfLine ∧
      (∃ η C : ℝ, 0<η ∧ 0≤C ∧
        Integrable (expWeight η (causalize E)) ∧
        ∀ t, 0≤t → |E t|≤C*Real.exp (-η*t)) ∧
      (∀ p : ℝ, 0≤p → (p+x*Real.exp (-δ*p))*laplace E p=1) := by
  let K := twoRateK 1 l l δ
  let G := twoRateG 1 l l
  have hK := twoRateK_integrable 1 l l δ
  have hKc := twoRateK_causal 1 l l δ
  have hKn : ∀ᵐ t, 0≤K t := ae_of_all _ (scalarDelay_kernel_nonneg hl δ)
  have hq : (∫ t, K t)<1 := twoRateK_small (by norm_num) le_rfl hδ
  have hG : Integrable (causalize G) := twoRateG_integrable 1 hl hl
  let g := hG.toL1 (causalize G)
  have hgc : Causal g := causal_congr (causalize_causal G) hG.coeFn_toL1.symm
  have hgn : 0≤g := by
    rw [← Lp.coeFn_nonneg]
    filter_upwards [hG.coeFn_toL1] with t ht
    rw [ht]
    by_cases ht0 : 0≤t <;> simp [G,causalize,twoRateG,ht0,Real.exp_nonneg]
  let z : RealL1 := (∑' n : ℕ, (convOp hK)^n) g
  obtain ⟨_,hzn,hzc,hze,_,_,_⟩ := positive_resolvent_all_parts hK hKn hKc hq g hgn hgc
  let E := twoRateErrorRep 1 l l δ z
  have hEa : (z : ℝ → ℝ)=ᵐ[volume] causalize E :=
    renewal_representative_ae hK hKc hG hzc hze
  have hEh := representative_halfLine_ae hEa
  have hr := twoRateErrorRep_regularity (L1.integrable_coeFn z) 1 l l hδ
  have hEi : Integrable E halfLine :=
