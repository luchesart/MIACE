/-! Identification with the ordinary plant states. Positivity of a formal
transfer is not assumed to identify an output: Laplace uniqueness supplies
the first lag identity, and the remaining states are actual lag solutions. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

-- @paper-step thm:n_construction/actual_command_transform
theorem cascadeCommand_laplace {J : ℝ → ℝ} (hc : Continuous J) {δ : ℝ} (hδ : 0≤δ)
    (a ε : ℝ) {R : ℝ → ℝ} (hi : Integrable (causalize R)) {p : ℝ} (hp : 0≤p) :
    laplace (cascadeCommand J δ a ε R) p=
      (1-a+ε*compactExpMoment (compactTail J δ) δ (-p))*laplace R p := by
  have hK := compactKernel_integrable (compactTail_continuous hc δ) δ
  have hconv := hK.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hi
  have hRhalf : Integrable R halfLine := by
    apply (hi.mono_measure Measure.restrict_le_self).congr
    exact representative_halfLine_ae (EventuallyEq.rfl (f := causalize R))
  unfold cascadeCommand laplace
  simp_rw [mul_add,mul_left_comm (Real.exp (-p*_)) ε,
    mul_left_comm (Real.exp (-p*_)) (1-a)]
  rw [integral_add ((laplace_integrable hRhalf hp).const_mul (1-a))
    ((laplace_integrable (hconv.mono_measure Measure.restrict_le_self) hp).const_mul ε)]
  rw [integral_const_mul,integral_const_mul]
  change (1-a)*laplace R p+ε*laplace
    (compactKernel (compactTail J δ) δ ⋆ causalize R) p=_
  rw [causal_convolution_laplace hK hi (compactKernel_causal _ δ) (causalize_causal R) hp,
    compactKernel_laplace _ hδ,laplace_congr_halfLine
      (representative_halfLine_ae (EventuallyEq.rfl (f := causalize R)))]
  dsimp only [laplace]
  ring

-- @paper-step thm:n_construction/resolvent_command_first_lag_identity
theorem cascadeCommand_resolvent_identity {J : ℝ → ℝ} (hc : Continuous J)
    {δ a ε : ℝ} (hδ : 0≤δ) {R : ℝ → ℝ} (hi : Integrable (causalize R))
    (hT : ∀ p : ℝ, 0≤p →
      (a*p+1-ε*compactMoment J δ 0+ε*compactExpMoment J δ (-p))*laplace R p=1)
