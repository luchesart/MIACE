-- За t>δ и двете точки t и t-δ принадлежат на решението, а не на
-- произволно зададената история. На първия интервал остава входът Hφ.
-- @paper-step thm:pid_two_rate_optimum/actual_second_order_delay_equation
theorem pid_reduced_actual_scalar_DDE {a b : ℝ → ℝ} {i ρ ell δ t : ℝ}
    (hρ : ρ ≠ 0) (hδ : 0≤δ) (ht : δ<t)
    (ha : ∀ s, 0<s → HasDerivAt a (-(a s+b s)/ρ) s)
