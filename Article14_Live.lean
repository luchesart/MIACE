section
                           
                              
                                    

/-!+# The initial transport interval of every physical response

Local absolute continuity and the actual differential equations force the
initial plant state to remain zero until the command reaches the plant.
This supplies the initial history needed for uniqueness of the subsequent
homogeneous delayed equation.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open scoped Topology
variable {n : Type*} [Fintype n]

/-- A finite linear homogeneous ODE with zero initial state has only the zero
locally absolutely continuous solution.  The classical Grönwall theorem is
applied to the integral primitive, whose differentiability is derived by FTC. -/
theorem locallyAC_finite_linear_zero (A : Matrix n n ℝ) {x : ℝ → n → ℝ} {L : ℝ}
    (hx : ContinuousOn x (Ici 0))
    (hac : ∀ j T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => x t j) 0 T)
    (hzero : x 0 = 0)
    (hode : ∀ j, ∀ᵐ t : ℝ, t ∈ Ioc 0 L →
      deriv (fun s => x s j) t = ∑ l, A j l*x t l) :
    ∀ t ∈ Icc 0 L, x t = 0 := by
  let f : ℝ → n → ℝ := fun t => finiteStateMap A (x (max t 0))
  have hf : Continuous f := (finiteStateMap A).continuous.comp
    (hx.comp_continuous (continuous_id.max continuous_const) (fun t => le_max_right t 0))
  let G : ℝ → n → ℝ := fun t j => ∫ s in 0..t, f s j
  have hdG : ∀ t, HasDerivAt G (f t) t := by
    intro t
    apply hasDerivAt_pi.mpr
    intro j
    exact ((continuous_apply j).comp hf).integral_hasStrictDerivAt 0 t |>.hasDerivAt
  have hG : Continuous G := continuous_iff_continuousAt.mpr
    (fun t => (hdG t).continuousAt)
  have heq : ∀ t ∈ Icc 0 L, x t = G t := by
    intro t ht
    ext j
    have hh := (hac j t ht.1).integral_deriv_eq_sub
    have hi : (∫ s in 0..t, deriv (fun z => x z j) s) = ∫ s in 0..t, f s j := by
      apply intervalIntegral.integral_congr_ae
      filter_upwards [hode j] with s hs hst
      rw [uIoc_of_le ht.1] at hst
      rw [hs ⟨hst.1, hst.2.trans ht.2⟩]
      simp only [f, max_eq_left hst.1.le, finiteStateMap_apply]
    rw [hi, hzero, Pi.zero_apply, sub_zero] at hh
    exact hh.symm
  have hGzero : G 0 = 0 := by ext j; simp [G]
  have hbound : ∀ t ∈ Ico 0 L, ‖f t‖ ≤ ‖finiteStateMap A‖*‖G t‖ := by
    intro t ht
    simpa only [f, max_eq_left ht.1, heq t ⟨ht.1, ht.2.le⟩] using
      (finiteStateMap A).le_opNorm (G t)
  have hGzeroAll := eq_zero_of_abs_deriv_le_mul_abs_self_of_eq_zero_right
    hG.continuousOn (fun t _ => (hdG t).hasDerivWithinAt) hGzero hbound
  intro t ht
  rw [heq t ht]
  exact hGzeroAll t ht

/-- The actual zero-history plant cannot move before its delayed input arrives. -/
theorem step_state_zero_before_delay
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ t ∈ Icc 0 L, (q t).1 = 0 := by
  apply locallyAC_finite_linear_zero A h.continuous.fst h.state_ac
    (by simp [h.initial])
  intro j
  filter_upwards [h.state_ode j] with t ht htmem
  simpa only [htmem.2, ite_true, mul_zero, add_zero] using ht htmem.1

theorem step_integral_before_delay
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ t ∈ Icc 0 L, (q t).2.1 = t := by
  intro t ht
  have hh := (h.integral_ac t ht.1).integral_deriv_eq_sub
  have hi : (∫ s in 0..t, deriv (fun z => (q z).2.1) s) = ∫ s in 0..t, (1 : ℝ) := by
    apply intervalIntegral.integral_congr_ae
    filter_upwards [h.integral_ode] with s hs hst
    rw [uIoc_of_le ht.1] at hst
    rw [hs hst.1]
    simp [sharedControllerRhs, step_state_zero_before_delay h s ⟨hst.1.le, hst.2.trans ht.2⟩,
      finitePlantOutput]
  simpa [hi, h.initial] using hh.symm

theorem step_filter_before_delay
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ t ∈ Icc 0 L, (q t).2.2 = c*(1-Real.exp (-t/Tf)) := by
  let x : ℝ → Unit → ℝ := fun t _ => (q t).2.2-c*(1-Real.exp (-t/Tf))
  have hcont : ContinuousOn x (Ici 0) := by
    apply continuousOn_pi.mpr
    intro j
    exact h.continuous.snd.snd.sub (by fun_prop)
  have hac : ∀ j T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => x t j) 0 T := by
    intro j T hT
    exact (h.filter_ac T hT).sub (ContDiffOn.absolutelyContinuousOnInterval (by fun_prop))
  have hz : x 0 = 0 := by ext j; simp [x, h.initial]
  have hode : ∀ j, ∀ᵐ t : ℝ, t ∈ Ioc 0 L →
      deriv (fun s => x s j) t = ∑ l : Unit, (-1/Tf)*x t l := by
    intro j
    filter_upwards [h.filter_ode, local_ac_ae_differentiable h.filter_ac]
      with t ho hd ht
    have he := (transportStep_hasDerivAt (n := Unit) c Tf t).snd.snd
    have hdif := (hd ht.1).hasDerivAt.sub he
    change HasDerivAt (fun s => x s j) _ t at hdif
    rw [hdif.deriv, ho ht.1]
    simp only [sharedControllerRhs, step_state_zero_before_delay h t ⟨ht.1.le, ht.2⟩,
      finitePlantOutput, Pi.zero_apply, mul_zero, Finset.sum_const_zero,
      mul_one, sub_zero, Fintype.sum_unique, x]
    ring
  have hzero := locallyAC_finite_linear_zero (fun _ _ : Unit => -1/Tf) hcont hac hz hode
  intro t ht
  have hh := congrFun (hzero t ht) ()
  simpa only [x, Pi.zero_apply, sub_eq_zero] using hh

/-- Every physical solution has the explicit transport prefix, derived from
its zero initial state and its almost-everywhere differential equations. -/
theorem stepLoopDynamics_transport_prefix
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ t ∈ Icc 0 L, q t = transportStep c Tf t := by
  intro t ht
  exact Prod.ext (step_state_zero_before_delay h t ht)
    (Prod.ext (step_integral_before_delay h t ht) (step_filter_before_delay h t ht))

-- Equal references cancel in every actual shared-controller equation.
theorem sharedController_step_difference (Kp Ti Td Tf b c y i f Y I F : ℝ) :
    sharedControllerRhs Kp Ti Td Tf b c 1 y i f -
      sharedControllerRhs Kp Ti Td Tf b c 1 Y I F =
    sharedControllerRhs Kp Ti Td Tf b c 0 (y-Y) (i-I) (f-F) := by
  ext <;> simp only [sharedControllerRhs, Prod.fst_sub, Prod.snd_sub] <;> ring

-- This identity requires linearity only, not a plant DC gain or equilibrium.
theorem retardedShared_step_difference
    (A : Matrix n n ℝ) (B C : n → ℝ) (Kp Ti Td Tf L b c : ℝ)
    (q r : ℝ → (n → ℝ) × ℝ × ℝ) :
    retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c (fun _ => 1) q -
      retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c (fun _ => 1) r =
    retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c (fun _ => 0) (fun t => q t-r t) := by
  simp only [retardedSharedRhs, Prod.fst_sub, Prod.snd_sub]
  have hout (t : ℝ) : finitePlantOutput C ((q t).1-(r t).1) =
      finitePlantOutput C (q t).1-finitePlantOutput C (r t).1 := by
    rw [← finiteOutputMap_eq C]
    exact map_sub _ _ _
  rw [hout 0, hout (-L), ← sharedController_step_difference,
    ← sharedController_step_difference]
  apply Prod.ext
  · rw [← finiteLinearPlantDynamics_eq]
    simp only [linearPlantDynamics, map_sub, Prod.snd_sub, Prod.fst_sub]
    abel
  · rfl

/-- Uniqueness of physical step trajectories needs only homogeneous
well-posedness.  The plant may have an origin pole or zero DC gain; no
equilibrium or inverse plant matrix is used. -/
theorem stepLoopDynamics_unique_of_wellPosed
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q r : ℝ → (n → ℝ) × ℝ × ℝ}
    (hwp : IsRetardedSharedWellPosed (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c)
    (hq : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hr : StepLoopDynamics A B C Kp Ti Td Tf L b c r) : EqOn q r (Ici 0) := by
  let z := fun t => q t-r t
  have hz : ContinuousOn z (Ici 0) := hq.continuous.sub hr.continuous
  have hd : ∀ t, L<t → HasDerivAt z
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => z (t+θ))) t := by
    intro t ht
    have hh := (hq.after_delay t ht).sub (hr.after_delay t ht)
    rwa [retardedShared_step_difference] at hh
  have hs := retardedShared_shifted_solution _ _ Kp Ti Td Tf L b c z hz hd
  have hs' : IsRetardedSharedSolution (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c (fun _ => 0) (fun t => z (t+L)) := by
    refine ⟨hs.1, ?_, hs.2.2⟩
    intro t ht
    dsimp [z]
    have hmem : t+L ∈ Icc 0 L := by constructor <;> linarith [ht.1,ht.2]
    rw [stepLoopDynamics_transport_prefix hq (t+L) hmem,
      stepLoopDynamics_transport_prefix hr (t+L) hmem, sub_self]
  have hzero : IsRetardedSharedSolution (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c (fun _ => 0) (fun _ => 0) := by
    refine ⟨continuousOn_const, fun _ _ => rfl, ?_⟩
    intro t ht
    convert hasDerivAt_const t (0 : (n → ℝ) × ℝ × ℝ) using 1
    ext j <;> simp [retardedSharedRhs, sharedControllerRhs, finitePlantOutput,
      finitePlantDynamics]
  obtain ⟨u, _, huniq⟩ := hwp (fun _ => 0) continuousOn_const
  have hequal := (huniq (fun t => z (t+L)) hs').trans (huniq (fun _ => 0) hzero).symm
  intro t ht
  have hh := hequal (show t-L ∈ Ici (-L) by change -L ≤ t-L; change 0 ≤ t at ht; linarith)
  simpa only [sub_add_cancel, z, sub_eq_zero] using hh

theorem stepLoopDynamics_eq_affine_family_of_wellPosed
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q q00 q10 q01 : ℝ → (n → ℝ) × ℝ × ℝ}
    (hwp : IsRetardedSharedWellPosed (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c)
    (hq : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (h00 : StepLoopDynamics A B C Kp Ti Td Tf L 0 0 q00)
    (h10 : StepLoopDynamics A B C Kp Ti Td Tf L 1 0 q10)
    (h01 : StepLoopDynamics A B C Kp Ti Td Tf L 0 1 q01) :
    EqOn q (stepAffineFamily q00 q10 q01 b c) (Ici 0) :=
  stepLoopDynamics_unique_of_wellPosed hwp hq (stepLoopDynamics_affine_family h00 h10 h01 b c)

/-- Uniqueness among arbitrary physical step responses follows from the
homogeneous well-posedness property; equality of their prefix is a conclusion. -/
theorem stepLoopDynamics_unique
    {A : Matrix n n ℝ} {B C xe : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q r : ℝ → (n → ℝ) × ℝ × ℝ}
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0)
    (heq : ∀ j, (∑ l, A j l*xe l)+B j/k=0)
    (hout : (∑ j, C j*xe j) = 1)
    (hwp : IsRetardedSharedWellPosed (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c)
    (hq : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hr : StepLoopDynamics A B C Kp Ti Td Tf L b c r) : EqOn q r (Ici 0) := by
  apply stepLoopDynamics_unique_of_prefix hTi hk hKp heq hout hwp hq hr
  intro t ht
  rw [stepLoopDynamics_transport_prefix hq t ht, stepLoopDynamics_transport_prefix hr t ht]

/-- The affine construction equals every actual physical step response on
nonnegative time, so it is independent of the choice of the three solutions. -/
theorem stepLoopDynamics_eq_affine_family
    {A : Matrix n n ℝ} {B C xe : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q q00 q10 q01 : ℝ → (n → ℝ) × ℝ × ℝ}
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0)
    (heq : ∀ j, (∑ l, A j l*xe l)+B j/k=0)
    (hout : (∑ j, C j*xe j) = 1)
    (hwp : IsRetardedSharedWellPosed (finitePlantOutput C) (finitePlantDynamics A B)
      Kp Ti Td Tf L b c)
    (hq : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (h00 : StepLoopDynamics A B C Kp Ti Td Tf L 0 0 q00)
    (h10 : StepLoopDynamics A B C Kp Ti Td Tf L 1 0 q10)
    (h01 : StepLoopDynamics A B C Kp Ti Td Tf L 0 1 q01) :
    EqOn q (stepAffineFamily q00 q10 q01 b c) (Ici 0) :=
  stepLoopDynamics_unique hTi hk hKp heq hout hwp hq
    (stepLoopDynamics_affine_family h00 h10 h01 b c)

end Article14
end
/- END SOURCE: Article14.StepUniqueness -/

/- BEGIN SOURCE: Article14/KernelMomentGeometry.lean -/
section
                                
                                 

/-!
The ordinary impulse kernel, rather than a formal transfer expansion, controls
variance and parameter identifiability.  The first two results hold for any
measure; the L¹ specialization uses the inherited whole-line `MIACE.RealL1`.
No positivity is needed for identifiability.  Positivity and unit mass are
needed for variance, exactly as for a probability density.
-/
namespace Article14
open MeasureTheory Filter Set MIACE

-- @article14 prop:delay-second-moment/actual_kernel_variance_identity
/-- Expanding the square under a genuine Lebesgue integral. -/
theorem kernel_centered_second_moment {μ : Measure ℝ} {g : ℝ → ℝ}
    (hg : Integrable g μ) (hfirst : Integrable (fun t => t * g t) μ)
    (hsecond : Integrable (fun t => t ^ 2 * g t) μ) (m : ℝ) :
    (∫ t, (t - m) ^ 2 * g t ∂μ) =
      (∫ t, t ^ 2 * g t ∂μ) - 2 * m * (∫ t, t * g t ∂μ) +
        m ^ 2 * (∫ t, g t ∂μ) := by
  have he : (fun t => (t - m) ^ 2 * g t) =
      (fun t => (t ^ 2 * g t - (2 * m) * (t * g t)) + m ^ 2 * g t) := by
    funext t
    ring
  have hsub : Integrable (fun t => t ^ 2 * g t - (2 * m) * (t * g t)) μ :=
    hsecond.sub (hfirst.const_mul (2 * m))
  rw [he, integral_add hsub (hg.const_mul (m ^ 2)),
    integral_sub hsecond (hfirst.const_mul (2 * m)), integral_const_mul,
    integral_const_mul]

-- @article14 prop:delay-second-moment/nonnegative_actual_kernel_variance
/-- A nonnegative ordinary unit-mass kernel has nonnegative variance. -/
theorem kernel_variance_nonneg {μ : Measure ℝ} {g : ℝ → ℝ}
    (hg : Integrable g μ) (hfirst : Integrable (fun t => t * g t) μ)
    (hsecond : Integrable (fun t => t ^ 2 * g t) μ)
    (hn : ∀ᵐ t ∂μ, 0 ≤ g t) (hmass : (∫ t, g t ∂μ) = 1) :
    (∫ t, t * g t ∂μ) ^ 2 ≤ ∫ t, t ^ 2 * g t ∂μ := by
  have hp : 0 ≤ ∫ t, (t - (∫ s, s * g s ∂μ)) ^ 2 * g t ∂μ := by
    apply integral_nonneg_of_ae
    filter_upwards [hn] with t ht
    exact mul_nonneg (sq_nonneg _) ht
  rw [kernel_centered_second_moment hg hfirst hsecond, hmass] at hp
  nlinarith

-- @article14 prop:delay-second-moment/variance_bound_from_actual_moments
/-- The PIDF weight bound follows from the actual first and second moments. -/
theorem kernel_variance_weight_bound {μ : Measure ℝ} {g : ℝ → ℝ}
    (hg : Integrable g μ) (hfirst : Integrable (fun t => t * g t) μ)
    (hsecond : Integrable (fun t => t ^ 2 * g t) μ)
    (hn : ∀ᵐ t ∂μ, 0 ≤ g t) (hmass : (∫ t, g t ∂μ) = 1)
    (Kp Ki Kd k Γ m c : ℝ) (hKi : 0 < Ki) (hKd : 0 < Kd)
    (hm : (∫ t, t * g t ∂μ) = m)
    (hm2 : (∫ t, t ^ 2 * g t ∂μ) = 2 * secondErrorMoment Kp Ki Kd k Γ m c) :
    1 + (Ki * m ^ 2 / 2 - (Kp + 1 / k) * m + Γ / k) / Kd ≤ c := by
  apply variance_weight_bound Kp Ki Kd k Γ m c hKi hKd
  simpa only [hm, hm2] using kernel_variance_nonneg hg hfirst hsecond hn hmass

-- @article14 thm:delay-fastest/mean_identifies_proportional_weight
theorem meanTime_injective (Ti k Kp : ℝ) (hTi : Ti ≠ 0) :
    Function.Injective (meanTime Ti k Kp) := by
  intro b d h
  unfold meanTime at h
  have he := mul_left_cancel₀ hTi h
  linarith

-- @article14 thm:delay-fastest/second_moment_identifies_derivative_weight
theorem secondErrorMoment_injective (Kp Ki Kd k Γ m : ℝ)
    (hKi : Ki ≠ 0) (hKd : Kd ≠ 0) :
    Function.Injective (secondErrorMoment Kp Ki Kd k Γ m) := by
  intro c d h
  unfold secondErrorMoment at h
  have he := congrArg (fun x : ℝ => x * Ki) h
  simp only [div_mul_cancel₀ _ hKi] at he
  have hm : (1 - c) * Kd = (1 - d) * Kd := by linarith
  have he' := mul_right_cancel₀ hKd hm
  linarith

-- @article14 thm:delay-fastest/two_moments_identify_both_weights
/-- Equality of both physical moment formulas identifies both setpoint weights. -/
theorem weights_eq_of_moment_formulas (Ti k Kp Td Γ : ℝ)
    (hTi : Ti ≠ 0) (hKp : Kp ≠ 0) (hTd : Td ≠ 0) {w z : ℝ × ℝ}
    (hm : meanTime Ti k Kp w.1 = meanTime Ti k Kp z.1)
    (hm2 : 2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp w.1) w.2 =
      2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp z.1) z.2) : w = z := by
  have hb := meanTime_injective Ti k Kp hTi hm
  apply Prod.ext hb
  apply secondErrorMoment_injective Kp (Kp / Ti) (Kp * Td) k Γ
    (meanTime Ti k Kp w.1) (div_ne_zero hKp hTi) (mul_ne_zero hKp hTd)
  rw [← hb] at hm2
  linarith

-- @article14 thm:delay-fastest/kernel_ae_equality_identifies_weights
/-- This is the kernel identifiability statement before taking the L¹ quotient. -/
theorem weights_eq_of_kernel_moments {μ : Measure ℝ} {g h : ℝ → ℝ}
    (Ti k Kp Td Γ : ℝ) (hTi : Ti ≠ 0) (hKp : Kp ≠ 0) (hTd : Td ≠ 0)
    {w z : ℝ × ℝ} (heq : g =ᵐ[μ] h)
    (hmw : (∫ t, t * g t ∂μ) = meanTime Ti k Kp w.1)
    (hmz : (∫ t, t * h t ∂μ) = meanTime Ti k Kp z.1)
    (hm2w : (∫ t, t ^ 2 * g t ∂μ) =
      2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp w.1) w.2)
    (hm2z : (∫ t, t ^ 2 * h t ∂μ) =
      2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp z.1) z.2) : w = z := by
  apply weights_eq_of_moment_formulas Ti k Kp Td Γ hTi hKp hTd
  · rw [← hmw, ← hmz]
    apply integral_congr_ae
    filter_upwards [heq] with t ht
    rw [ht]
  · rw [← hm2w, ← hm2z]
    apply integral_congr_ae
    filter_upwards [heq] with t ht
    rw [ht]

-- @article14 thm:delay-fastest/actual_L1_kernel_family_injective
/-- First and second moment identities establish injectivity of the actual
kernel family in the inherited L¹ space; no Laplace uniqueness assumption is
needed.  Moments here are on the whole line, as is `MIACE.RealL1`. -/
theorem kernel_family_injective_of_moments (g : (ℝ × ℝ) → RealL1)
    (Ti k Kp Td Γ : ℝ) (hTi : Ti ≠ 0) (hKp : Kp ≠ 0) (hTd : Td ≠ 0)
    (hm : ∀ w, (∫ t, t * g w t) = meanTime Ti k Kp w.1)
    (hm2 : ∀ w, (∫ t, t ^ 2 * g w t) =
      2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp w.1) w.2) : Function.Injective g := by
  intro w z h
  apply weights_eq_of_moment_formulas Ti k Kp Td Γ hTi hKp hTd
  · rw [← hm w, ← hm z, h]
  · rw [← hm2 w, ← hm2 z, h]

-- @article14 thm:delay-fastest/affine_kernel_direction_injective
/-- Affine-kernel identifiability supplies the linear injectivity required by
`kernelFeasible_compact`. -/
theorem affine_kernel_direction_injective_of_moments (g₀ : RealL1)
    (L : (ℝ × ℝ) →L[ℝ] RealL1) (Ti k Kp Td Γ : ℝ)
    (hTi : Ti ≠ 0) (hKp : Kp ≠ 0) (hTd : Td ≠ 0)
    (hm : ∀ w, (∫ t, t * (g₀ + L w) t) = meanTime Ti k Kp w.1)
    (hm2 : ∀ w, (∫ t, t ^ 2 * (g₀ + L w) t) =
      2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp w.1) w.2) : Function.Injective L := by
  intro w z h
  apply kernel_family_injective_of_moments (fun w => g₀ + L w)
    Ti k Kp Td Γ hTi hKp hTd hm hm2
  exact congrArg (fun u => g₀ + u) h

-- @article14 thm:delay-fastest/strict_mean_above_pure_delay
/-- An ordinary nonnegative unit-mass density supported after a pure delay
cannot place all of its mass at the delay point.  Thus its mean strictly
exceeds that delay.  This also applies to `halfLine`, which has no atoms. -/
theorem kernel_mean_strictly_above_delay {μ : Measure ℝ} [NullSingletonClass μ]
    {g : ℝ → ℝ} (hg : Integrable g μ)
    (hfirst : Integrable (fun t => t * g t) μ)
    (hn : ∀ᵐ t ∂μ, 0 ≤ g t) (hmass : (∫ t, g t ∂μ) = 1)
    (L : ℝ) (hdelay : ∀ᵐ t ∂μ, t < L → g t = 0) :
    L < ∫ t, t * g t ∂μ := by
  have hshift : Integrable (fun t => (t - L) * g t) μ := by
    have he : (fun t => (t - L) * g t) = (fun t => t * g t - L * g t) := by
      funext t
      ring
    rw [he]
    exact hfirst.sub (hg.const_mul L)
  have hshift_nonneg : ∀ᵐ t ∂μ, 0 ≤ (t - L) * g t := by
    filter_upwards [hn, hdelay] with t ht hd
    by_cases h : t < L
    · rw [hd h, mul_zero]
    · exact mul_nonneg (sub_nonneg.mpr (le_of_not_gt h)) ht
  have hshift_pos : 0 < ∫ t, (t - L) * g t ∂μ := by
    apply lt_of_le_of_ne (integral_nonneg_of_ae hshift_nonneg)
    intro hzero
    have hz := (integral_eq_zero_iff_of_nonneg_ae hshift_nonneg hshift).mp hzero.symm
    have hgzero : g =ᵐ[μ] 0 := by
      filter_upwards [hz, μ.ae_ne L] with t ht hne
      have hmul : (t - L) * g t = 0 := ht
      exact (mul_eq_zero.mp hmul).resolve_left (sub_ne_zero.mpr hne)
    have hmasszero : (∫ t, g t ∂μ) = 0 := by
      rw [integral_congr_ae hgzero]
      simp
    linarith
  have he : (fun t => (t - L) * g t) = (fun t => t * g t - L * g t) := by
    funext t
    ring
  rw [he, integral_sub hfirst (hg.const_mul L), integral_const_mul, hmass] at hshift_pos
  linarith

-- @article14 prop:delay-second-moment/strict_variance_for_ordinary_kernels
/-- A unit-mass ordinary density on an atomless measure cannot concentrate at
its mean.  In this setting the variance is strictly positive. -/
theorem kernel_variance_pos {μ : Measure ℝ} [NullSingletonClass μ] {g : ℝ → ℝ}
    (hg : Integrable g μ) (hfirst : Integrable (fun t => t * g t) μ)
    (hsecond : Integrable (fun t => t ^ 2 * g t) μ)
    (hn : ∀ᵐ t ∂μ, 0 ≤ g t) (hmass : (∫ t, g t ∂μ) = 1) :
    (∫ t, t * g t ∂μ) ^ 2 < ∫ t, t ^ 2 * g t ∂μ := by
  let m : ℝ := ∫ t, t * g t ∂μ
  have hsq : Integrable (fun t => (t - m) ^ 2 * g t) μ := by
    have he : (fun t => (t - m) ^ 2 * g t) =
        (fun t => (t ^ 2 * g t - (2 * m) * (t * g t)) + m ^ 2 * g t) := by
      funext t
      ring
    rw [he]
    exact (hsecond.sub (hfirst.const_mul (2 * m))).add (hg.const_mul (m ^ 2))
  have hsq_nonneg : ∀ᵐ t ∂μ, 0 ≤ (t - m) ^ 2 * g t := by
    filter_upwards [hn] with t ht
    exact mul_nonneg (sq_nonneg _) ht
  have hp : 0 < ∫ t, (t - m) ^ 2 * g t ∂μ := by
    apply lt_of_le_of_ne (integral_nonneg_of_ae hsq_nonneg)
    intro hzero
    have hz := (integral_eq_zero_iff_of_nonneg_ae hsq_nonneg hsq).mp hzero.symm
    have hgzero : g =ᵐ[μ] 0 := by
      filter_upwards [hz, μ.ae_ne m] with t ht hne
      have hmul : (t - m) ^ 2 * g t = 0 := ht
      exact (mul_eq_zero.mp hmul).resolve_left (pow_ne_zero _ (sub_ne_zero.mpr hne))
    have hmasszero : (∫ t, g t ∂μ) = 0 := by
      rw [integral_congr_ae hgzero]
      simp
    linarith
  rw [kernel_centered_second_moment hg hfirst hsecond, hmass] at hp
  dsimp [m] at hp
  nlinarith

-- @article14 prop:delay-second-moment/strict_variance_weight_bound
/-- The atomless-density refinement makes the necessary derivative-weight
bound strict.  Equality would require a Dirac impulse, not an ordinary kernel. -/
theorem kernel_variance_weight_bound_strict {μ : Measure ℝ} [NullSingletonClass μ]
    {g : ℝ → ℝ} (hg : Integrable g μ)
    (hfirst : Integrable (fun t => t * g t) μ)
    (hsecond : Integrable (fun t => t ^ 2 * g t) μ)
    (hn : ∀ᵐ t ∂μ, 0 ≤ g t) (hmass : (∫ t, g t ∂μ) = 1)
    (Kp Ki Kd k Γ m c : ℝ) (hKi : 0 < Ki) (hKd : 0 < Kd)
    (hm : (∫ t, t * g t ∂μ) = m)
    (hm2 : (∫ t, t ^ 2 * g t ∂μ) = 2 * secondErrorMoment Kp Ki Kd k Γ m c) :
    1 + (Ki * m ^ 2 / 2 - (Kp + 1 / k) * m + Γ / k) / Kd < c := by
  have hv := kernel_variance_pos hg hfirst hsecond hn hmass
  rw [hm, hm2] at hv
  unfold secondErrorMoment at hv
  have h := (lt_div_iff₀ hKi).mp
    (show m ^ 2 / 2 < ((Kp + 1 / k) * m - (1 - c) * Kd - Γ / k) / Ki by
      linarith)
  rw [← lt_sub_iff_add_lt', div_lt_iff₀ hKd]
  nlinarith

-- @article14 thm:delay-fastest/halfLine_L1_kernel_family_injective
/-- The same L¹ identifiability argument can use causal half-line moments
without first converting them to whole-line moments. -/
theorem kernel_family_injective_of_halfLine_moments (g : (ℝ × ℝ) → RealL1)
    (Ti k Kp Td Γ : ℝ) (hTi : Ti ≠ 0) (hKp : Kp ≠ 0) (hTd : Td ≠ 0)
    (hm : ∀ w, (∫ t, t * g w t ∂halfLine) = meanTime Ti k Kp w.1)
    (hm2 : ∀ w, (∫ t, t ^ 2 * g w t ∂halfLine) =
      2 * secondErrorMoment Kp (Kp / Ti) (Kp * Td) k Γ
        (meanTime Ti k Kp w.1) w.2) : Function.Injective g := by
  intro w z h
  apply weights_eq_of_moment_formulas Ti k Kp Td Γ hTi hKp hTd
  · rw [← hm w, ← hm z, h]
  · rw [← hm2 w, ← hm2 z, h]

end Article14
end
/- END SOURCE: Article14.KernelMomentGeometry -/

/- BEGIN SOURCE: Article14/PhysicalImpulse.lean -/
section
                             
                               
                                     
                               
                       
                                                  

/-!
# Ordinary impulse kernels of the physical delayed PIDF loop

The kernel is the actual plant output derivative, expressed through the
implemented differential equation.  Local absolute continuity supplies its
finite-time integral; internal exponential stability supplies its integrability,
unit mass, and moments.  No transfer or impulse identity is an assumption.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open scoped Topology
open PhysicalPlant PhysicalLaplace
variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The causal ordinary output derivative of the implemented physical step.
The values at the isolated switching instants do not affect its integrals. -/
noncomputable def stepImpulse (A : Matrix n n ℝ) (B C : n → ℝ)
    (Kp Ti Td Tf L b c : ℝ) (q : ℝ → (n → ℝ) × ℝ × ℝ) (t : ℝ) : ℝ :=
  if t ≤ 0 then 0 else
    ∑ j, C j * ((∑ l, A j l * (q t).1 l) +
      B j * (if t ≤ L then 0 else stepCommand C Kp Ti Td Tf b c q (t-L)))

-- Finite linear combinations preserve precisely the local regularity used by
-- the physical state equations, without an extra smoothness assumption.
theorem finite_sum_locallyAC {ι : Type*} (s : Finset ι) (f : ι → ℝ → ℝ)
    (h : ∀ j ∈ s, ∀ T, 0 ≤ T → AbsolutelyContinuousOnInterval (f j) 0 T) :
    ∀ T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => ∑ j ∈ s, f j t) 0 T := by
  classical
  intro T hT
  induction s using Finset.induction_on with
  | empty =>
    simp only [Finset.sum_empty]
    exact ContDiffOn.absolutelyContinuousOnInterval (by fun_prop)
  | @insert a s ha ih =>
    simp only [Finset.sum_insert ha]
    apply (h a (Finset.mem_insert_self a s) T hT).add
    exact ih (fun j hj => h j (Finset.mem_insert_of_mem hj))

-- The physical output is locally absolutely continuous because each plant
-- coordinate is; the strictly proper output has no direct feedthrough jump.
omit [DecidableEq n] in
theorem step_output_locallyAC
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ T, 0 ≤ T → AbsolutelyContinuousOnInterval
      (fun t => finitePlantOutput C (q t).1) 0 T := by
  exact finite_sum_locallyAC Finset.univ (fun j t => C j * (q t).1 j)
    (fun j _ T hT => (h.state_ac j T hT).const_mul (C j))

-- Derive the output derivative from all physical coordinate equations.
omit [DecidableEq n] in
theorem step_output_ode
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ᵐ t : ℝ, 0 < t → deriv (fun s => finitePlantOutput C (q s).1) t =
      stepImpulse A B C Kp Ti Td Tf L b c q t := by
  have hd := ae_all_iff.mpr (fun j => local_ac_ae_differentiable (h.state_ac j))
  have ho := ae_all_iff.mpr h.state_ode
  filter_upwards [hd, ho] with t ht ho hpos
  have hh := HasDerivAt.fun_sum (u := Finset.univ)
    (fun j _ => ((ht j hpos).hasDerivAt.const_mul (C j)))
  unfold finitePlantOutput
  rw [hh.deriv]
  simp only [stepImpulse, not_le.mpr hpos, ite_false]
  exact Finset.sum_congr rfl (fun j _ => by rw [ho j hpos])

-- The same concrete kernel is minus the actual tracking-error derivative.
omit [DecidableEq n] in
theorem step_error_ode
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ᵐ t : ℝ, 0 < t → deriv (fun s => 1-finitePlantOutput C (q s).1) t =
      -stepImpulse A B C Kp Ti Td Tf L b c q t := by
  filter_upwards [step_output_ode h,
    local_ac_ae_differentiable (step_output_locallyAC h)] with t ho hd ht
  have hh := (hd ht).hasDerivAt.const_sub 1
  rw [hh.deriv, ho ht]

-- The physical step is the integral of the ordinary kernel; this equality is
-- a consequence of the initial state and the fundamental theorem of calculus.
omit [DecidableEq n] in
theorem step_output_eq_impulse_integral
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) (T : ℝ) (hT : 0 ≤ T) :
    finitePlantOutput C (q T).1 =
      ∫ t in 0..T, stepImpulse A B C Kp Ti Td Tf L b c q t := by
  have hh := (step_output_locallyAC h T hT).integral_deriv_eq_sub
  have he : (∫ t in 0..T, deriv (fun s => finitePlantOutput C (q s).1) t) =
      ∫ t in 0..T, stepImpulse A B C Kp Ti Td Tf L b c q t := by
    apply intervalIntegral.integral_congr_ae
    filter_upwards [step_output_ode h] with t ht htmem
    rw [uIoc_of_le hT] at htmem
    exact ht htmem.1
  rw [he] at hh
  simpa [h.initial, finitePlantOutput] using hh.symm

-- The ordinary kernel has zero prehistory, independently of any extension of
-- the physical state to negative times.
omit [DecidableEq n] in
theorem stepImpulse_causal (A : Matrix n n ℝ) (B C : n → ℝ)
    (Kp Ti Td Tf L b c : ℝ) (q : ℝ → (n → ℝ) × ℝ × ℝ) :
    MIACE.Causal (stepImpulse A B C Kp Ti Td Tf L b c q) := by
  exact Eventually.of_forall (fun t ht => by simp [stepImpulse, ht.le])


/-- The current-state contribution to the plant output derivative. -/
noncomputable def outputDerivativeObservation (A : Matrix n n ℝ) (C : n → ℝ) :
    ((n → ℝ) × ℝ × ℝ) →L[ℝ] ℝ :=
  (finiteOutputMap C).comp ((finiteStateMap A).comp
    (ContinuousLinearMap.fst ℝ (n → ℝ) (ℝ × ℝ)))

omit [DecidableEq n] in
theorem outputDerivativeObservation_apply (A : Matrix n n ℝ) (C : n → ℝ)
    (z : (n → ℝ) × ℝ × ℝ) :
    outputDerivativeObservation A C z = ∑ j, C j * (∑ l, A j l * z.1 l) := by
  simp [outputDerivativeObservation, finiteOutputMap, finiteStateMap_apply]

-- The physical impulse equation is centered using the verified equilibrium.
-- In particular the initial transport interval contributes the constant -1.
omit [DecidableEq n] in
theorem stepImpulse_centered
    (A : Matrix n n ℝ) (B C xInf : n → ℝ) (Kp Ti Td Tf k L b c : ℝ)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1)
    (q : ℝ → (n → ℝ) × ℝ × ℝ) (t : ℝ) (ht : 0 < t) :
    stepImpulse A B C Kp Ti Td Tf L b c q t =
      outputDerivativeObservation A C (q t-pidfEquilibrium xInf Ti k Kp b c) +
      ((∑ j, C j*B j)/k)*centeredDelay L
        (fun s => commandObservation C k Kp Ti Td Tf
          (q s-pidfEquilibrium xInf Ti k Kp b c)) t := by
  simp only [stepImpulse, not_le.mpr ht, ite_false]
  rw [outputDerivativeObservation_apply]
  simp only [pidfEquilibrium, Prod.fst_sub, Pi.sub_apply, mul_sub, Finset.sum_sub_distrib,
    centeredDelay]
  by_cases htL : t ≤ L
  · simp only [htL, ite_true, mul_zero, add_zero, mul_neg_one]
    have hh : (∑ j, C j * (∑ l, A j l*xInf l)) = -((∑ j, C j*B j)/k) := by
      calc
        _ = ∑ j, C j * (-(B j/k)) := Finset.sum_congr rfl (fun j _ => by rw [eq_neg_of_add_eq_zero_left (heq j)])
        _ = _ := by simp [mul_div_assoc, Finset.sum_div]
    rw [hh]
    ring
  · simp only [htL, ite_false]
    have hcmd := step_centered_command C xInf Kp Ti Td Tf k b c hTi hk hKp hout q (t-L)
    change commandObservation C k Kp Ti Td Tf (q (t-L)-(xInf, meanTime Ti k Kp b, c-1)) = _ at hcmd
    rw [hcmd]
    have hh : ∀ j, (∑ l, A j l*(q t).1 l)+B j*stepCommand C Kp Ti Td Tf b c q (t-L) =
        (∑ l, A j l*(q t).1 l)-(∑ l, A j l*xInf l)+
          B j/k*(k*stepCommand C Kp Ti Td Tf b c q (t-L)-1) := by
      intro j
      have hj := heq j
      field_simp at hj ⊢
      nlinarith
    simp_rw [hh]
    simp only [mul_add, Finset.sum_add_distrib, mul_sub, Finset.sum_sub_distrib]
    congr 1
    simp only [← mul_assoc, ← mul_div_assoc, ← Finset.sum_mul, ← Finset.sum_div]

-- Measurability follows from the actual derivative equation, even at a
-- transport switch where the ordinary derivative need not be continuous.
omit [DecidableEq n] in
theorem stepImpulse_aestronglyMeasurable
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    AEStronglyMeasurable (stepImpulse A B C Kp Ti Td Tf L b c q) halfLine := by
  apply (aestronglyMeasurable_deriv (fun t => finitePlantOutput C (q t).1) halfLine).congr
  filter_upwards [ae_restrict_of_ae (step_output_ode h), ae_restrict_mem measurableSet_Ioi] with t ho ht
  exact ho ht

-- A pure delay preserves exponential decay after including its finite
-- waiting pulse in the envelope constant.
theorem centeredDelay_exp_bound {v : ℝ → ℝ} {D α L : ℝ}
    (hD : 0 ≤ D) (hα : 0 < α)
    (hd : ∀ t, 0 ≤ t → |v t| ≤ D*Real.exp (-α*t)) :
    ∀ t, 0 ≤ t → |centeredDelay L v t| ≤
      (D+1)*Real.exp (α*L)*Real.exp (-α*t) := by
  intro t ht
  have hexp : Real.exp (α*L)*Real.exp (-α*t) = Real.exp (α*(L-t)) := by
    rw [← Real.exp_add]
    congr 1
    ring
  by_cases htL : t ≤ L
  · simp only [centeredDelay, htL, ite_true, abs_neg, abs_one]
    rw [mul_assoc, hexp]
    have hx : 1 ≤ Real.exp (α*(L-t)) := Real.one_le_exp (mul_nonneg hα.le (sub_nonneg.mpr htL))
    nlinarith
  · have ht' : 0 ≤ t-L := le_of_lt (sub_pos.mpr (lt_of_not_ge htL))
    simp only [centeredDelay, htL, ite_false]
    calc
      |v (t-L)| ≤ D*Real.exp (-α*(t-L)) := hd (t-L) ht'
      _ ≤ (D+1)*Real.exp (-α*(t-L)) := by gcongr; linarith
      _ = (D+1)*Real.exp (α*L)*Real.exp (-α*t) := by
        rw [mul_assoc, hexp]
        congr 2
        ring

-- The same internal stability assumption now gives exponential decay of the
-- actual ordinary impulse and the physical error, with a common rate.
omit [DecidableEq n] in
theorem stable_step_impulse_decay
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    ∃ Ce Cg β : ℝ, 0 < Ce ∧ 0 < Cg ∧ 0 < β ∧
      (∀ t, 0 ≤ t → |1-finitePlantOutput C (q t).1| ≤ Ce*Real.exp (-β*t)) ∧
      (∀ t, 0 ≤ t → |stepImpulse A B C Kp Ti Td Tf L b c q t| ≤ Cg*Real.exp (-β*t)) := by
  let z := fun t => q t-pidfEquilibrium xInf Ti k Kp b c
  have hc : ContinuousOn z (Ici 0) := h.continuous.sub continuousOn_const
  obtain ⟨D, β, hD, hβ, hd⟩ := retardedShared_stable_tail_decay
    (finitePlantOutput C) (finitePlantDynamics A B) Kp Ti Td Tf L b c z hL hs hc
    (centeredStep_after_delay h hTi hk hKp heq hout)
  obtain ⟨Ce, hCe, he⟩ := linear_observable_exp_decay z (errorObservation C) hD hd
  obtain ⟨Cv, hCv, hv⟩ := linear_observable_exp_decay z (commandObservation C k Kp Ti Td Tf) hD hd
  obtain ⟨Ca, hCa, ha⟩ := linear_observable_exp_decay z (outputDerivativeObservation A C) hD hd
  let R := |(∑ j, C j*B j)/k|
  let E := (Cv+1)*Real.exp (β*L)
  refine ⟨Ce, Ca+R*E, β, hCe, by dsimp [R, E]; positivity, hβ, ?_, ?_⟩
  · intro t ht
    simpa only [z, step_centered_error C xInf Ti k Kp b c hout] using he t ht
  · intro t ht
    by_cases ht0 : t=0
    · subst t
      simp only [stepImpulse, le_refl, ite_true, abs_zero, mul_zero, Real.exp_zero, mul_one]
      dsimp [R, E]
      positivity
    · have htpos : 0<t := lt_of_le_of_ne ht (Ne.symm ht0)
      rw [stepImpulse_centered A B C xInf Kp Ti Td Tf k L b c hTi hk hKp heq hout q t htpos]
      have hvd := centeredDelay_exp_bound (L := L) hCv.le hβ hv t ht
      change |centeredDelay L (fun s => commandObservation C k Kp Ti Td Tf (z s)) t| ≤ E*Real.exp (-β*t) at hvd
      calc
        _ ≤ |outputDerivativeObservation A C (z t)| +
          R*|centeredDelay L (fun s => commandObservation C k Kp Ti Td Tf (z s)) t| := by
            simpa only [abs_mul] using abs_add_le
              (outputDerivativeObservation A C (z t))
              (((∑ j, C j*B j)/k)*centeredDelay L
                (fun s => commandObservation C k Kp Ti Td Tf (z s)) t)
        _ ≤ Ca*Real.exp (-β*t)+R*(E*Real.exp (-β*t)) := by
          exact add_le_add (ha t ht) (mul_le_mul_of_nonneg_left hvd (abs_nonneg _))
        _ = (Ca+R*E)*Real.exp (-β*t) := by ring


-- The zero extension is exact, not merely an equality almost everywhere.
omit [DecidableEq n] in
theorem stepImpulse_eq_indicator (A : Matrix n n ℝ) (B C : n → ℝ)
    (Kp Ti Td Tf L b c : ℝ) (q : ℝ → (n → ℝ) × ℝ × ℝ) :
    (Ioi (0 : ℝ)).indicator (stepImpulse A B C Kp Ti Td Tf L b c q) =
      stepImpulse A B C Kp Ti Td Tf L b c q := by
  funext t
  by_cases ht : 0<t
  · simp [ht]
  · simp [ht, stepImpulse, le_of_not_gt ht]

-- The stable ordinary impulse belongs to L¹ on the physical half-line.
omit [DecidableEq n] in
theorem stable_step_impulse_integrable
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    Integrable (stepImpulse A B C Kp Ti Td Tf L b c q) halfLine := by
  obtain ⟨Ce, Cg, β, _, _, hβ, _, hg⟩ := stable_step_impulse_decay h hTi hk hKp hL hs heq hout
  simpa only [pow_zero, one_mul] using
    polynomial_weight_integrable (stepImpulse_aestronglyMeasurable h) hβ hg 0

-- The same kernel belongs to the ordinary whole-line L¹ space used by the
-- positivity and frequency-response theorems.
omit [DecidableEq n] in
theorem stable_step_impulse_integrable_full
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    Integrable (stepImpulse A B C Kp Ti Td Tf L b c q) := by
  have hi := (integrable_indicator_iff measurableSet_Ioi).2
    (stable_step_impulse_integrable h hTi hk hKp hL hs heq hout)
  rwa [stepImpulse_eq_indicator] at hi

-- All whole-line kernel moments agree with the physical positive-time moments.
omit [DecidableEq n] in
theorem stepImpulse_moment_full_eq (A : Matrix n n ℝ) (B C : n → ℝ)
    (Kp Ti Td Tf L b c : ℝ) (q : ℝ → (n → ℝ) × ℝ × ℝ) (m : ℕ) :
    (∫ t, t^m*stepImpulse A B C Kp Ti Td Tf L b c q t) =
      ∫ t, t^m*stepImpulse A B C Kp Ti Td Tf L b c q t ∂halfLine := by
  have he : (Ioi (0 : ℝ)).indicator
      (fun t => t^m*stepImpulse A B C Kp Ti Td Tf L b c q t) =
      (fun t => t^m*stepImpulse A B C Kp Ti Td Tf L b c q t) := by
    funext t
    by_cases ht : 0<t
    · simp [ht]
    · simp [ht, stepImpulse, le_of_not_gt ht]
  change _ = ∫ t in Ioi 0, t^m*stepImpulse A B C Kp Ti Td Tf L b c q t
  rw [← integral_indicator measurableSet_Ioi, he]

-- Local absolute continuity of the physical tracking error.
omit [DecidableEq n] in
theorem step_error_locallyAC
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q) :
    ∀ T, 0 ≤ T → AbsolutelyContinuousOnInterval
      (fun t => 1-finitePlantOutput C (q t).1) 0 T := by
  intro T hT
  exact (ContDiffOn.absolutelyContinuousOnInterval (by fun_prop :
    ContDiffOn ℝ 1 (fun _ : ℝ => (1 : ℝ)) (uIcc 0 T))).sub
    (step_output_locallyAC h T hT)

-- Unit mass is a theorem of the physical equations and internal stability.
omit [DecidableEq n] in
theorem stable_step_impulse_unit_mass
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    (∫ t, stepImpulse A B C Kp Ti Td Tf L b c q t ∂halfLine) = 1 := by
  obtain ⟨Ce, Cg, β, _, _, hβ, he, _⟩ := stable_step_impulse_decay h hTi hk hKp hL hs heq hout
  apply impulse_unit_mass (step_error_locallyAC h) (step_error_ode h)
    (stable_step_impulse_integrable h hTi hk hKp hL hs heq hout)
  · simpa only [pow_zero, one_mul] using polynomial_weight_tendsto_zero hβ he 0
  · simp [h.initial, finitePlantOutput]

-- First and second impulse moments follow from the same actual state, without
-- positivity assumptions: these are signed identities before optimization.
theorem stable_step_impulse_moments
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0) :
    (∫ t, t*stepImpulse A B C Kp Ti Td Tf L b c q t ∂halfLine) = meanTime Ti k Kp b ∧
    (∫ t, t^2*stepImpulse A B C Kp Ti Td Tf L b c q t ∂halfLine) =
      2*secondErrorMoment Kp (Kp/Ti) (Kp*Td) k (residenceTime A C xInf+L)
        (meanTime Ti k Kp b) c := by
  obtain ⟨Ce, Cg, β, _, _, hβ, he, hg⟩ := stable_step_impulse_decay h hTi hk hKp hL hs heq hout
  have hh := first_and_second_moments_of_exp_decay (step_error_locallyAC h)
    (step_error_ode h) (stepImpulse_aestronglyMeasurable h) hβ he hg
  rw [(stable_step_transfer_and_area h hTi hk hKp hL hs heq hout hA).2] at hh
  rw [stable_step_first_error_moment h hTi hk hKp hTf hL hs heq hout hA] at hh
  exact hh

-- All polynomial moments are absolutely integrable, not only the moments
-- which occur in the explicit first- and second-moment formulas.
omit [DecidableEq n] in
theorem stable_step_impulse_weight_integrable
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (m : ℕ) :
    Integrable (fun t => t^m*stepImpulse A B C Kp Ti Td Tf L b c q t) halfLine := by
  obtain ⟨Ce, Cg, β, _, _, hβ, _, hg⟩ := stable_step_impulse_decay h hTi hk hKp hL hs heq hout
  exact polynomial_weight_integrable (stepImpulse_aestronglyMeasurable h) hβ hg m

-- The actual physical output is exactly the cumulative kernel used by all
-- positivity, no-overshoot, and settling-time results.
omit [DecidableEq n] in
theorem stable_step_output_eq_kernelStep
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (T : ℝ) (hT : 0 ≤ T) :
    finitePlantOutput C (q T).1 = kernelStep (stepImpulse A B C Kp Ti Td Tf L b c q) T := by
  let g := stepImpulse A B C Kp Ti Td Tf L b c q
  have hi := stable_step_impulse_integrable_full h hTi hk hKp hL hs heq hout
  have hz : kernelStep g 0 = 0 := causal_kernel_step_zero (stepImpulse_causal A B C Kp Ti Td Tf L b c q) le_rfl
  rw [step_output_eq_impulse_integral h T hT]
  have hh := (intervalIntegral.integral_Iic_sub_Iic (a := (0 : ℝ)) (b := T) hi.integrableOn hi.integrableOn).symm
  change (∫ t in 0..T, g t) = kernelStep g T-kernelStep g 0 at hh
  simpa only [hz, sub_zero] using hh


-- Positive-time positivity is equivalent to whole-line positivity for this
-- causal physical kernel.
omit [DecidableEq n] in
theorem stepImpulse_nonnegative_full
    (A : Matrix n n ℝ) (B C : n → ℝ) (Kp Ti Td Tf L b c : ℝ)
    (q : ℝ → (n → ℝ) × ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t) :
    ∀ᵐ t, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t := by
  rw [halfLine, ae_restrict_iff' measurableSet_Ioi] at hg
  filter_upwards [hg] with t ht
  by_cases hpos : 0<t
  · exact ht hpos
  · simp [stepImpulse, le_of_not_gt hpos]

-- The physical output is monotone if and only if its derived ordinary impulse
-- is nonnegative; both directions refer to the implemented response.
omit [DecidableEq n] in
theorem stable_step_monotone_iff
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) :
    MonotoneOn (fun t => finitePlantOutput C (q t).1) (Ici 0) ↔
      ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t := by
  let g := stepImpulse A B C Kp Ti Td Tf L b c q
  have hi := stable_step_impulse_integrable_full h hTi hk hKp hL hs heq hout
  have hc := stepImpulse_causal A B C Kp Ti Td Tf L b c q
  have hy := stable_step_output_eq_kernelStep h hTi hk hKp hL hs heq hout
  constructor
  · intro hm
    have hm' : Monotone (kernelStep g) := by
      intro s t hst
      by_cases ht : t≤0
      · rw [causal_kernel_step_zero hc ht, causal_kernel_step_zero hc (hst.trans ht)]
      · have ht' : 0≤t := le_of_lt (lt_of_not_ge ht)
        rw [← hy t ht']
        by_cases hs' : s≤0
        · rw [causal_kernel_step_zero hc hs']
          have hh := hm (show (0:ℝ) ∈ Ici 0 from by simp) ht' ht'
          simpa [h.initial, finitePlantOutput] using hh
        · have hs0 : 0≤s := le_of_lt (lt_of_not_ge hs')
          rw [← hy s hs0]
          exact hm hs0 ht' hst
    exact ae_restrict_of_ae ((kernel_step_monotone_iff hi).1 hm')
  · intro hg s hs0 t ht0 hst
    change finitePlantOutput C (q s).1 ≤ finitePlantOutput C (q t).1
    rw [hy s hs0, hy t ht0]
    exact positive_kernel_step_monotone hi
      (stepImpulse_nonnegative_full A B C Kp Ti Td Tf L b c q hg) hst

-- The unit-mass nonnegative kernel gives no overshoot of the actual output.
omit [DecidableEq n] in
theorem stable_step_positive_output_bounds
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t)
    (t : ℝ) (ht : 0≤t) :
    0 ≤ finitePlantOutput C (q t).1 ∧ finitePlantOutput C (q t).1 ≤ 1 := by
  have hm : (∫ s, stepImpulse A B C Kp Ti Td Tf L b c q s) = 1 := by
    have he := stepImpulse_moment_full_eq A B C Kp Ti Td Tf L b c q 0
    simp only [pow_zero, one_mul] at he
    rw [he]
    exact stable_step_impulse_unit_mass h hTi hk hKp hL hs heq hout
  rw [stable_step_output_eq_kernelStep h hTi hk hKp hL hs heq hout t ht]
  exact positive_kernel_step_bounds
    (stable_step_impulse_integrable_full h hTi hk hKp hL hs heq hout)
    (stepImpulse_nonnegative_full A B C Kp Ti Td Tf L b c q hg) hm t

-- The frequency norm is exactly one for every physically admissible positive
-- kernel.  The lower bound is attained at zero frequency.
omit [DecidableEq n] in
theorem stable_step_positive_hinf
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t) :
    kernelHinf (stepImpulse A B C Kp Ti Td Tf L b c q) = 1 := by
  apply positive_kernel_hinf_eq_one
    (stable_step_impulse_integrable_full h hTi hk hKp hL hs heq hout)
    (stepImpulse_causal A B C Kp Ti Td Tf L b c q)
    (stepImpulse_nonnegative_full A B C Kp Ti Td Tf L b c q hg)
  have he := stepImpulse_moment_full_eq A B C Kp Ti Td Tf L b c q 0
  simp only [pow_zero, one_mul] at he
  rw [he]
  exact stable_step_impulse_unit_mass h hTi hk hKp hL hs heq hout

-- The actual no-overshoot IAE equals the derived impulse mean and the affine
-- weight formula.  Kernel positivity supplies error positivity automatically.
theorem stable_step_positive_iae
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t) :
    absArea (fun t => 1-finitePlantOutput C (q t).1) halfLine = meanTime Ti k Kp b := by
  rw [← (stable_step_transfer_and_area h hTi hk hKp hL hs heq hout hA).2]
  apply integral_congr_ae
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact abs_of_nonneg (sub_nonneg.mpr
    (stable_step_positive_output_bounds h hTi hk hKp hL hs heq hout hg t (le_of_lt ht)).2)


-- A zero-input transport history forces an exactly zero impulse before the
-- pure delay, as proved from the finite-dimensional plant ODE.
omit [DecidableEq n] in
theorem stepImpulse_zero_before_delay
    {A : Matrix n n ℝ} {B C : n → ℝ} {Kp Ti Td Tf L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (t : ℝ) (htL : t ≤ L) :
    stepImpulse A B C Kp Ti Td Tf L b c q t = 0 := by
  by_cases ht : t≤0
  · simp [stepImpulse, ht]
  · have hx := step_state_zero_before_delay h t ⟨le_of_lt (lt_of_not_ge ht), htL⟩
    simp [stepImpulse, ht, htL, hx]

-- The strict delay bound now applies to the actual physical impulse, not to a
-- separately supplied density or a first-moment hypothesis.
theorem stable_step_positive_mean_gt_delay
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t) :
    L < meanTime Ti k Kp b := by
  have hi := stable_step_impulse_integrable h hTi hk hKp hL hs heq hout
  have hfirst : Integrable (fun t => t*stepImpulse A B C Kp Ti Td Tf L b c q t) halfLine := by
    simpa only [pow_one] using stable_step_impulse_weight_integrable h hTi hk hKp hL hs heq hout 1
  have hm := stable_step_impulse_unit_mass h hTi hk hKp hL hs heq hout
  have hd : ∀ᵐ t ∂halfLine, t<L → stepImpulse A B C Kp Ti Td Tf L b c q t=0 :=
    Eventually.of_forall (fun t ht => stepImpulse_zero_before_delay h t ht.le)
  have hh := kernel_mean_strictly_above_delay hi hfirst hg hm L hd
  rwa [(stable_step_impulse_moments h hTi hk hKp hTf hL hs heq hout hA).1] at hh

-- For a physical nonnegative ordinary impulse, its variance is strictly
-- positive; this sharpens the algebraic second-weight necessary condition.
theorem stable_step_positive_variance_weight_bound
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : 0 < Ti) (hk : k ≠ 0) (hKp : 0 < Kp) (hTd : 0 < Td)
    (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t) :
    1+((Kp/Ti)*(meanTime Ti k Kp b)^2/2-
      (Kp+1/k)*meanTime Ti k Kp b+(residenceTime A C xInf+L)/k)/(Kp*Td) < c := by
  have hfirst : Integrable (fun t => t*stepImpulse A B C Kp Ti Td Tf L b c q t) halfLine := by
    simpa only [pow_one] using stable_step_impulse_weight_integrable
      h hTi.ne' hk hKp.ne' hL hs heq hout 1
  have hm := stable_step_impulse_moments h hTi.ne' hk hKp.ne' hTf hL hs heq hout hA
  exact kernel_variance_weight_bound_strict
    (stable_step_impulse_integrable h hTi.ne' hk hKp.ne' hL hs heq hout)
    hfirst (stable_step_impulse_weight_integrable h hTi.ne' hk hKp.ne' hL hs heq hout 2)
    hg (stable_step_impulse_unit_mass h hTi.ne' hk hKp.ne' hL hs heq hout)
    Kp (Kp/Ti) (Kp*Td) k (residenceTime A C xInf+L) (meanTime Ti k Kp b) c
    (div_pos hKp hTi) (mul_pos hKp hTd) hm.1 hm.2

-- The physical ITAE formula needs only impulse positivity; nonnegativity of
-- the error follows from the proved unit-mass no-overshoot bound.
theorem stable_step_positive_itae
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : StepLoopDynamics A B C Kp Ti Td Tf L b c q)
    (hTi : Ti ≠ 0) (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTf : 0 < Tf) (hL : 0 ≤ L)
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (heq : ∀ j, (∑ l, A j l*xInf l)+B j/k=0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ stepImpulse A B C Kp Ti Td Tf L b c q t) :
    (∫ t, t*|1-finitePlantOutput C (q t).1| ∂halfLine) =
      secondErrorMoment Kp (Kp/Ti) (Kp*Td) k (residenceTime A C xInf+L)
        (meanTime Ti k Kp b) c := by
  apply stable_step_itae h hTi hk hKp hTf hL hs heq hout hA
  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  exact sub_nonneg.mpr
    (stable_step_positive_output_bounds h hTi hk hKp hL hs heq hout hg t (le_of_lt ht)).2

end Article14
end
