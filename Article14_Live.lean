theorem cascade_necessary_dimensional (α L τstar τrest : ℝ) (hτ : 0 < τstar) :
    α > (1+τrest/τstar)+L/τstar-1 ↔ L < α*τstar-τrest := by
  have he : (1+τrest/τstar)+L/τstar-1=(τrest+L)/τstar := by ring
