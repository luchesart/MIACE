-- @paper-step thm:complete_attainment/weighted_exponential
theorem weighted_expCommand (x : ℝ) :
    (fun t => Real.exp t*expCommand x t) = (fun t => (x-1)*Real.exp (-(x-1)*t)) := by
  funext t
  unfold expCommand expError
