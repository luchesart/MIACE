  have hcoe (x : ℝ) : Complex.ofRealHom x=(x : ℂ) := rfl
  rw [exact_delay_remainder_complex r n δ p hr]
  simp only [rationalCascadeQ,eval₂_sub,eval₂_mul,eval₂_add,eval₂_C,eval₂_X,hcoe]
  ring

