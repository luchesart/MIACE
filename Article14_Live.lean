theorem pid_reduced_scalar_equation {i ρ ell a ad add aδ adδ b bd bδ : ℝ}
    (hρ : ρ ≠ 0) (ha : ad=-(a+b)/ρ) (haδ : adδ=-(aδ+bδ)/ρ)
