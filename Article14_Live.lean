    halfComplexLaplace E (p : ℂ)=(laplace E p : ℂ) := by
  rw [halfComplexLaplace,laplace,← integral_complex_ofReal]
  apply integral_congr_ae
  apply Eventually.of_forall
  intro t
  simp only [Complex.ofReal_mul,Complex.ofReal_exp,Complex.ofReal_neg]

-- @paper-step thm:delayed_optimum/real_analytic_continuation_of_laplace
theorem laplace_real_analytic {E : ℝ → ℝ} (hc : Continuous E) {C : ℝ} (hC : 0≤C)
