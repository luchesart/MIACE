    funext (fun p => exact_delay_remainder_real r n δ p hr)
  have hR := ((remainderI r δ n).hasDerivAt 0).add
    ((((remainderB r n).hasDerivAt 0).const_mul ((-1 : ℝ)^(n+1))).mul
      (remainderTransform_deriv_zero r n δ))
  have hE := (((hasDerivAt_id (0 : ℝ)).const_mul (-δ)).exp)
  change HasDerivAt (fun p => (remainderI r δ n).eval p+
