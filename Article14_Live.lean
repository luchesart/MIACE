  exact ((hf.const_mul pc).add
    ((intervalIntegral.continuous_primitive (fun a b => hf.intervalIntegrable a b) 0).const_mul i)).add
    ((hf.sub (lag_continuous hf ρ)).const_mul (dc/ρ))

