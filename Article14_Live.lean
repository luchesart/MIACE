noncomputable def rationalCascadeA (r : ℕ → ℝ) (n : ℕ) (δ U : ℝ) : ℝ :=
  1-U+(-1 : ℝ)^(n+1)*compactMoment (remainderJ r n δ) δ 1
noncomputable def rationalCascadeC (r : ℕ → ℝ) (n : ℕ) (δ : ℝ) : ℝ :=
  1-(-1 : ℝ)^(n+1)*compactMoment (remainderJ r n δ) δ 0
noncomputable def rationalCascadeQ (r : ℕ → ℝ) (n : ℕ) (δ U : ℝ) : ℝ[X] :=
  remainderB r n*(C (rationalCascadeA r n δ U)*X+C (rationalCascadeC r n δ))-
    remainderI r δ n

-- @paper-step thm:n_construction/real_restriction_of_compact_transform
theorem compactLaplace_real (J : ℝ → ℝ) (δ p : ℝ) :
    compactLaplace J δ (p : ℂ)=(compactExpMoment J δ (-p) : ℂ) := by
  unfold compactLaplace compactExpMoment
  rw [← intervalIntegral.integral_ofReal]
  apply intervalIntegral.integral_congr
  intro t _
  simp only [Complex.ofReal_mul,Complex.ofReal_exp,Complex.ofReal_neg]

