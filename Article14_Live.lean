      (by intro he; have hz := congrArg (fun P : ℝ[X] => P.eval 0) he; simpa using hz),
      ih (fun j hj => hr j (by omega)),hl (n+1) (hr (n+1) le_rfl)]

-- @paper-step lem:n_remainder/interpolation_polynomial_degree_bound
theorem remainderI_degree (r : ℕ → ℝ) (n : ℕ) (δ : ℝ) (hr : ∀ j≤n, r j≠0) :
