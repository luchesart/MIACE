-- @paper-step lem:n_remainder/negative_time_sign_including_repeated_rates
theorem reverseImpulse_nonneg (r : ℕ → ℝ) (n : ℕ)
    (hr : ∀ j≤n, 0≤r j) {t : ℝ} (ht : 0≤t) : 0≤reverseImpulse r n t := by
  induction n generalizing t with
  | zero => exact mul_nonneg (hr 0 le_rfl) (Real.exp_nonneg _)
  | succ n ih =>
