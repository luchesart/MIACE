  have hd := delayedError_integrable δ hδ he
  refine ⟨hd,hv.mono_measure Measure.restrict_le_self,?_⟩
  intro p hp
  have hc : Integrable (fun t : ℝ => Real.exp (-p*t)) halfLine :=
    integrableOn_exp_mul_Ioi (by linarith : -p<0) 0
