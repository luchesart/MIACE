-- @paper-step thm:pid_two_rate_optimum/first_order_transfer_DC
theorem firstOrder_transfer_dc :
    HasDerivAt (fun p : ℝ => 1/(1+p)) (-1) 0 := by
  convert (hasDerivAt_const (0 : ℝ) (1 : ℝ)).div
    ((hasDerivAt_id (0 : ℝ)).const_add 1) (by norm_num) using 1 <;> norm_num
  funext p
