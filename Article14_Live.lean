theorem causal_convolution_assoc {f g h : ℝ → ℝ}
    (hf : Integrable f) (hg : Integrable g) (hh : Integrable h)
    (hfc : Causal f) (hgc : Causal g) (hhc : Causal h) :
    ((f ⋆ g) ⋆ h)=ᵐ[volume] (f ⋆ (g ⋆ h)) := by
  have hfg := hf.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hg
  have hgh := hg.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hh
