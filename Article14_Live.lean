    (fun a _ b _ hab => by have hh := hy hab; dsimp only at hh; linarith)
  refine ⟨hP,hEn,hy,by simp [delayedError,hδ],?_,?_⟩
  · simpa using tendsto_const_nhds.sub hlim
  · have hAe : absArea E halfLine=∫ t, E t ∂halfLine := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact abs_of_nonneg (hEn t (show 0<t from ht).le)
    have hAv : absArea v halfLine=∫ t, v t ∂halfLine := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact abs_of_nonneg (hvn t (show 0<t from ht).le)
