-- @paper-step thm:delayed_optimum/identity_principle_for_multiplied_transfer_equations
theorem analytic_identity_from_positive {f g : ℝ → ℝ}
    (hf : AnalyticOnNhd ℝ f (Ioi (-1))) (hg : AnalyticOnNhd ℝ g (Ioi (-1)))
