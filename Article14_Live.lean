-- @paper-step thm:pid_two_rate_optimum/ordinary_lag_continuity
theorem lag_continuous {f : ℝ → ℝ} (hf : Continuous f) (ρ : ℝ) : Continuous (lag ρ f) := by
  have hi : ∀ a b : ℝ, IntervalIntegrable (fun s => Real.exp (s/ρ)*f s) volume a b :=
