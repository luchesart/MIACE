      1/p-laplace (delayedError δ (fun t => 1-ordinaryCascade σ (fun s => 1+v s) n t)) p := by
    unfold laplace
    simp_rw [mul_sub,mul_one]
    rw [integral_sub hc (laplace_integrable hd hp.le)]
    simpa [laplace] using congrArg (fun z : ℝ => z-laplace
      (delayedError δ (fun t => 1-ordinaryCascade σ (fun s => 1+v s) n t)) p) (laplace_step p hp)
  rw [hy,delayedError_laplace he hδ hp,(laplace_step_add (hv.mono_measure Measure.restrict_le_self) hp).2]
  have hh := ordinaryCascade_transform hv σ n hσ hp
  calc
    _ = Real.exp (-δ*p)*(1/p-laplace (fun t => 1-ordinaryCascade σ (fun s => 1+v s) n t) p) := by ring
    _ = _ := by rw [hh]; ring

