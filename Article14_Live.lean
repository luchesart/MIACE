-- its initial value and of the forcing, not merely the final output.
-- @paper-step thm:complete_robust/all_cascade_storage_states_decay
theorem serialState_uniform_control (σ : ℕ → ℝ) (n : ℕ) (η : ℝ)
    (hσ : ∀ j<n, 0<σ j ∧ η<1/σ j) :
    ∃ C : ℝ, 0≤C ∧ ∀ M D : ℝ, 0≤M → ∀ ξ : ℕ → ℝ,
      (∀ j<n, |ξ j|≤M) → ∀ u : ℝ → ℝ, WeightedControl η (causalize u) D →
      ∀ j≤n, WeightedControl η (causalize (serialState σ ξ u j)) (C*(M+D)) := by
  induction n with
  | zero =>
    refine ⟨1,zero_le_one,?_⟩
    intro M D hM ξ hξ u hu j hj
    have hj0 : j=0 := by omega
    subst j
    exact weightedControl_mono hu (by nlinarith)
  | succ n ih =>
    obtain ⟨C,hC,hprev⟩ := ih (fun j hj => hσ j (by omega))
    obtain ⟨K,hK⟩ := lagKernel_weightedControl (hσ n (by omega)).1 (hσ n (by omega)).2
    let A := K*(σ n+C)
    have hA : 0≤A := mul_nonneg hK.nonneg (add_nonneg (hσ n (by omega)).1.le hC)
    refine ⟨C+A,add_nonneg hC hA,?_⟩
    intro M D hM ξ hξ u hu j hj
    have hMD : 0≤M+D := add_nonneg hM hu.nonneg
    by_cases hjn : j≤n
    · exact weightedControl_mono (hprev M D hM ξ (fun j hj => hξ j (by omega)) u hu j hjn)
        (by nlinarith)
    · have hje : j=n+1 := by omega
      subst j
      have hh := lagState_weighted_control (hσ n (by omega)).1 hK
        (hprev M D hM ξ (fun j hj => hξ j (by omega)) u hu n le_rfl) (ξ n)
      apply weightedControl_mono hh
      have hi := hξ n (by omega)
      rw [abs_mul,abs_of_pos (hσ n (by omega)).1]
      dsimp [A]
      have hxi := mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hi (hσ n (by omega)).1.le) hK.nonneg
      have hKD := mul_nonneg (mul_nonneg hK.nonneg (hσ n (by omega)).1.le) hu.nonneg
      nlinarith [mul_nonneg hC hMD]


