      funext t
      unfold shift
      congr 1
      ring
    rw [heq,shift_absArea,step_delay_norm hh hn hm (sub_nonneg.mpr hab)]
  rcases le_total a b with hab | hba
  · rw [hh' a b hab,abs_of_nonneg (sub_nonneg.mpr hab)]
  · have heq : absArea (fun t => ∫ s in t-b..t-a, h s) volume =
        absArea (fun t => ∫ s in t-a..t-b, h s) volume := by
      unfold absArea
      congr 1
      funext t
      dsimp only
      rw [intervalIntegral.integral_symm,abs_neg]
    rw [heq,hh' b a hba,abs_of_nonpos (sub_nonpos.mpr hba),neg_sub]

-- @paper-step thm:complete_robust/cascade_step_error_norm
theorem cascade_step_error_norm (ss : List ℝ) (hs : ∀ σ ∈ ss, 0 < σ)
    (δ ε : ℝ) :
    absArea (fun t => ∫ s in t-(δ+ε)..t-δ, cascadeKernel ss s) volume = |ε| := by
  have hp := cascadeKernel_properties ss hs
  have hh := two_delay_step_distance hp.1 (ae_of_all volume hp.2.1) hp.2.2.1 δ (δ+ε)
  simpa only [add_sub_cancel_left] using hh

