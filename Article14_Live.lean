-- @paper-step thm:command_cone/every_front_area_has_stable_feedback
theorem paper_cascade_front_realization (N : ℕ) (σ : ℕ → ℝ) {δ U : ℝ}
    (hδ : 0≤δ) (hU : 0≤U) (hU1 : U<1)
    (hσ : ∀ j≤N, 0<σ j ∧ σ j≤1) (hfirst : σ 0=1) :
    ∃ F : IMCFilter, ∃ v : ℝ → ℝ, NominalCascadeIMC N σ F δ v ∧
      (∀ t, 0≤v t) ∧ (∀ t, 0≤t → 0≤cascadeStepError N σ δ v t) ∧
      Monotone (fun t => 1-cascadeStepError N σ δ v t) ∧
      1-cascadeStepError N σ δ v 0=0 ∧
      Tendsto (fun t => 1-cascadeStepError N σ δ v t) atTop (𝓝 1) ∧
      absArea v halfLine=U ∧
      absArea (cascadeStepError N σ δ v) halfLine=cascadeMean σ (N+1)+δ-U := by
  have ha : 0<1-U := by linarith
  have ha1 : 1-U≤1 := by linarith
  have hh := cascade_exponential_family N σ hδ ha ha1 hσ hfirst
  refine ⟨exponentialIMC (1-U) ha,imcExcess (1-U),
    exponential_cascade_IMC N σ hδ ha ha1 hσ hfirst,
    hh.2.2.2.2.2.2.1,hh.2.2.2.2.2.2.2.1,hh.2.1,hh.2.2.1,hh.2.2.2.1,?_,?_⟩
  · simpa only [sub_sub_cancel] using hh.2.2.2.2.1
  · have he : absArea (cascadeStepError N σ δ (imcExcess (1-U))) halfLine=
        cascadeMean σ (N+1)+δ-(1-(1-U)) := hh.2.2.2.2.2.1
    simpa only [sub_sub_cancel] using he

-- @paper-step thm:complete_attainment/optimal_family_parameter
theorem optimal_imc_parameter {α S : ℝ} (hα : 0<α) (hS : 0<S) (h : S-1<α) :
    0<1-S/(1+α) ∧ 1-S/(1+α)<1 := by
  have hd : 0<1+α := by linarith
  have hU : 0<S/(1+α) := div_pos hS hd
  have hU1 : S/(1+α)<1 := (div_lt_one hd).mpr (by linarith)
  constructor <;> linarith

-- @paper-step thm:complete_attainment/exact_optimal_family_cost_and_peak
theorem paper_optimal_exponential_IMC (N : ℕ) (σ : ℕ → ℝ) {δ α : ℝ}
    (hδ : 0≤δ) (hα : 0<α) (hσ : ∀ j≤N, 0<σ j ∧ σ j≤1) (hfirst : σ 0=1)
    (hthreshold : cascadeMean σ (N+1)+δ-1<α) :
    let S := cascadeMean σ (N+1)+δ
    let a := 1-S/(1+α)
    ∃ ha : 0<a, NominalCascadeIMC N σ (exponentialIMC a ha) δ (imcExcess a) ∧
      miace α (cascadeStepError N σ δ (imcExcess a)) (imcExcess a) halfLine=S*minimum α ∧
      absArea (imcExcess a) halfLine=S/(1+α) ∧
