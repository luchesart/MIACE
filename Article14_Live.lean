    iteratedDeriv k (fun p => B.eval p*H p) z=0 := by
  rw [iteratedDeriv_fun_mul (by exact (Differentiable.analyticAt (fun p => B.differentiableAt) z).contDiffAt) hH.contDiffAt]
  apply Finset.sum_eq_zero
  intro i hi
  have hiz : i<B.rootMultiplicity z := (Nat.le_of_lt_succ (Finset.mem_range.mp hi)).trans_lt hk
  have he : iteratedDeriv i (fun p => B.eval p) z=0 := by
    rw [polynomial_iterated_deriv]
    exact isRoot_iterate_derivative_of_lt_rootMultiplicity hiz
