theorem pid_state_functions {E : ℝ → ℝ} (hE : Continuous E) {ρ : ℝ} (hρ : 0<ρ) :
    (∫ s in (0 : ℝ)..0, E s)=0 ∧ lag ρ E 0=0 ∧
    (∀ t : ℝ, HasDerivAt (fun u => ∫ s in 0..u, E s) (E t) t) ∧
    (∀ t : ℝ, 0<t → HasDerivAt (lag ρ E) ((E t-lag ρ E t)/ρ) t) ∧
    (∀ T : ℝ, 0≤T → AbsolutelyContinuousOnInterval (fun t => ∫ s in 0..t, E s) 0 T ∧
      AbsolutelyContinuousOnInterval (lag ρ E) 0 T) := by
  refine ⟨by simp,by simp [lag],?_,?_,?_⟩
  · intro t
    exact intervalIntegral.integral_hasDerivAt_right (hE.intervalIntegrable _ _)
      hE.stronglyMeasurable.stronglyMeasurableAtFilter hE.continuousAt
  · intro t ht
    exact lag_hasDerivAt hE.continuousOn ρ t hρ ht
  · intro T hT
    exact ⟨intervalPrimitive_ac (fun a b => hE.intervalIntegrable a b) 0 0 T,
      lag_ac hE.continuousOn ρ T hT⟩

end MIACE
