theorem imcExcess_properties {a : ℝ} (ha : 0<a) (ha1 : a≤1) :
    Integrable (imcExcess a) ∧
      Integrable (fun t => Real.exp t*imcExcess a t) halfLine ∧
      (∀ t : ℝ, 0≤ imcExcess a t) ∧ commandArea (imcExcess a)=1-a ∧
