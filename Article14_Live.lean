section
                            
                                
                                 

/-!
# Article 14: exact MIACE projection within a positive-command family

The scalar projection is proved from real inequalities.  Its signal-level
application uses actual integrable signals, the local plant relation proved in
`MIACEBridge`, positivity of BOTH signals, and the tracking-area identity.
The existence and interval shape of the feasible projection are exposed
explicitly; they are not encoded as a pre-assumed optimum.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open scoped Topology

noncomputable def clampedWeight (lo hi target : ℝ) : ℝ :=
  min hi (max lo target)

noncomputable def trackingMean (k Kp Ti b : ℝ) : ℝ :=
  Ti * (1 + 1 / (k * Kp) - b)

noncomputable def miaceTarget (k Kp Ti Γ α : ℝ) : ℝ :=
  1 + 1 / (k * Kp) - α * Γ / ((1 + α) * Ti)

noncomputable def positiveCommandCostSq (k Kp Ti Γ α b : ℝ) : ℝ :=
  (trackingMean k Kp Ti b) ^ 2 + α * (Γ - trackingMean k Kp Ti b) ^ 2

-- Article 14, Theorem 17: clipping really lands in the feasible interval.
theorem clampedWeight_mem {lo hi : ℝ} (h : lo ≤ hi) (target : ℝ) :
    clampedWeight lo hi target ∈ Icc lo hi := by
  constructor
  · exact le_min h (le_max_left _ _)
  · exact min_le_left _ _

-- Article 14, Theorem 17: the clamp has the least squared distance to the
-- desired weight among every point of the interval, including both endpoints.
theorem clampedWeight_nearest {lo hi target b : ℝ} (hb : b ∈ Icc lo hi) :
    (clampedWeight lo hi target - target) ^ 2 ≤ (b - target) ^ 2 := by
  by_cases hlo : target ≤ lo
  · have hhi : lo ≤ hi := hb.1.trans hb.2
    rw [clampedWeight, max_eq_left hlo, min_eq_right hhi]
    exact (sq_le_sq₀ (sub_nonneg.mpr hlo)
      (sub_nonneg.mpr (hlo.trans hb.1))).mpr (sub_le_sub_right hb.1 target)
  · by_cases hhi : hi ≤ target
    · have hlo' : lo ≤ target := (hb.1.trans hb.2).trans hhi
      rw [clampedWeight, max_eq_right hlo', min_eq_left hhi]
      have hi' : 0 ≤ target - hi := sub_nonneg.mpr hhi
      have hb' : 0 ≤ target - b := sub_nonneg.mpr (hb.2.trans hhi)
      have hs := (sq_le_sq₀ hi' hb').mpr (sub_le_sub_left hb.2 target)
      nlinarith
    · have hlo' : lo ≤ target := (lt_of_not_ge hlo).le
      have hhi' : target ≤ hi := (lt_of_not_ge hhi).le
      rw [clampedWeight, max_eq_right hlo', min_eq_right hhi']
      simp only [sub_self, zero_pow (by decide : 2 ≠ 0)]
      exact sq_nonneg _

-- Article 14, Theorem 17: the target is unchanged exactly when feasible.
theorem clampedWeight_eq_self_iff {lo hi target : ℝ} (h : lo ≤ hi) :
    clampedWeight lo hi target = target ↔ target ∈ Icc lo hi := by
  constructor
  · intro heq
    rw [← heq]
    exact clampedWeight_mem h target
  · intro ht
    rw [clampedWeight, max_eq_right ht.1, min_eq_right ht.2]

-- Article 14, Theorem 17: complete the square in b, retaining the exact
-- fixed-feedback tracking mean rather than introducing a new area variable.
theorem positiveCommandCostSq_completion (k Kp Ti Γ α b : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) :
    positiveCommandCostSq k Kp Ti Γ α b =
      α * Γ ^ 2 / (1 + α) +
        (1 + α) * Ti ^ 2 * (b - miaceTarget k Kp Ti Γ α) ^ 2 := by
  have h1 : 1 + α ≠ 0 := ne_of_gt (by linarith)
  unfold positiveCommandCostSq trackingMean miaceTarget
  field_simp [hTi.ne', h1]
  ring

-- Article 14, Theorem 17: the exact scalar constrained minimum.
theorem positiveCommandCostSq_projection (k Kp Ti Γ α lo hi b : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) (hb : b ∈ Icc lo hi) :
    positiveCommandCostSq k Kp Ti Γ α
        (clampedWeight lo hi (miaceTarget k Kp Ti Γ α)) ≤
      positiveCommandCostSq k Kp Ti Γ α b := by
  rw [positiveCommandCostSq_completion k Kp Ti Γ α _ hTi hα,
    positiveCommandCostSq_completion k Kp Ti Γ α _ hTi hα]
  have hc : 0 ≤ (1 + α) * Ti ^ 2 :=
    mul_nonneg (by linarith) (sq_nonneg Ti)
  have hm := mul_le_mul_of_nonneg_left
    (clampedWeight_nearest (target := miaceTarget k Kp Ti Γ α) hb) hc
  linarith

-- Article 14, Theorem 17: equality in the universal squared bound identifies
-- one b value, even though more than one feasible c may lie above it.
theorem positiveCommandCostSq_eq_bound_iff (k Kp Ti Γ α b : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) :
    positiveCommandCostSq k Kp Ti Γ α b = α * Γ ^ 2 / (1 + α) ↔
      b = miaceTarget k Kp Ti Γ α := by
  rw [positiveCommandCostSq_completion k Kp Ti Γ α b hTi hα]
  have hc : 0 < (1 + α) * Ti ^ 2 := mul_pos (by linarith) (sq_pos_of_pos hTi)
  constructor
  · intro h
    have hz : (b - miaceTarget k Kp Ti Γ α) ^ 2 = 0 :=
      (mul_eq_zero.mp (by linarith : (1 + α) * Ti ^ 2 *
        (b - miaceTarget k Kp Ti Γ α) ^ 2 = 0)).resolve_left hc.ne'
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hz)
  · intro h
    simp [h]

-- Article 14, Theorem 17: the universal squared bound is attainable on an
-- interval exactly when the desired (unclipped) weight belongs to it.
theorem positiveCommandCostSq_attainable_iff (k Kp Ti Γ α lo hi : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) :
    (∃ b ∈ Icc lo hi,
      positiveCommandCostSq k Kp Ti Γ α b = α * Γ ^ 2 / (1 + α)) ↔
        miaceTarget k Kp Ti Γ α ∈ Icc lo hi := by
  constructor
  · rintro ⟨b, hb, heq⟩
    rwa [(positiveCommandCostSq_eq_bound_iff k Kp Ti Γ α b hTi hα).mp heq] at hb
  · intro ht
    exact ⟨_, ht, (positiveCommandCostSq_eq_bound_iff k Kp Ti Γ α _ hTi hα).mpr rfl⟩

-- Article 14, Theorem 17: reduction of ACTUAL signal integrals to the scalar
-- cost.  The signed command area follows from the local transfer theorem;
-- no command-area formula or quadratic cost is postulated.
theorem nonnegative_signal_cost_reduction {e v H : ℝ → ℝ} {δ : ℝ}
    (h : LocalTransferResponse e v H δ) (k Kp Ti b μ α : ℝ)
    (hα : 0 < α) (hH : HasDerivAt H (-μ) 0) (h0 : H 0 = 1)
    (he : ∀ᵐ t ∂halfLine, 0 ≤ e t) (hv : ∀ᵐ t ∂halfLine, 0 ≤ v t)
    (hm : (∫ t, e t ∂halfLine) = trackingMean k Kp Ti b) :
    (miace α e v halfLine) ^ 2 = positiveCommandCostSq k Kp Ti (μ + δ) α b := by
  have hb := local_transfer_signed_balance h μ hH h0
  have hae : absArea e halfLine = trackingMean k Kp Ti b := by
    rw [absolute_area_identity h.error_integrable,
      (negative_area_zero_iff h.error_integrable).mpr he, hm]
    ring
  have hav : absArea v halfLine = μ + δ - trackingMean k Kp Ti b := by
    rw [absolute_area_identity h.command_integrable,
      (negative_area_zero_iff h.command_integrable).mpr hv]
    linarith
  rw [miace_square α e v halfLine hα, hae, hav]
  rfl

/-- An explicit interface to the monotone, nonnegative-command part of the
fixed-feedback family.  In particular, the error-area identity is a separate
Article 14, Theorem 14 obligation, while the command area is derived below. -/
structure PositiveMIACEFamily (F : Set (ℝ × ℝ))
    (e v : (ℝ × ℝ) → ℝ → ℝ) (H : ℝ → ℝ) (δ k Kp Ti : ℝ) : Prop where
  response : ∀ w ∈ F, LocalTransferResponse (e w) (v w) H δ
  error_nonnegative : ∀ w ∈ F, ∀ᵐ t ∂halfLine, 0 ≤ e w t
  command_nonnegative : ∀ w ∈ F, ∀ᵐ t ∂halfLine, 0 ≤ v w t
  error_area : ∀ w ∈ F, (∫ t, e w t ∂halfLine) = trackingMean k Kp Ti w.1

-- Article 14, Theorems 14 and 17: the family interface follows from its
-- ACTUAL two local transfer relations.  In particular, the mean-area formula
-- is proved by dominated convergence rather than assumed in this constructor.
theorem positiveMIACEFamily_of_local_transfers {F : Set (ℝ × ℝ)}
    {e v : (ℝ × ℝ) → ℝ → ℝ} {H Q : ℝ → ℝ} {δ k Kp Ti Kd Tf : ℝ}
    (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTi : Ti ≠ 0)
    (hQ : ContinuousAt Q 0) (hQ0 : Q 0 = 1 / k)
    (hresponse : ∀ w ∈ F, LocalTransferResponse (e w) (v w) H δ)
    (he : ∀ w ∈ F, ∀ᵐ t ∂halfLine, 0 ≤ e w t)
    (hv : ∀ w ∈ F, ∀ᵐ t ∂halfLine, 0 ≤ v w t)
    (herror : ∀ w ∈ F, laplace (e w) =ᶠ[𝓝[>] (0 : ℝ)]
      clearedError Q Kp (Kp / Ti) Kd Tf w.1 w.2) :
    PositiveMIACEFamily F e v H δ k Kp Ti := by
  refine ⟨hresponse, he, hv, ?_⟩
  intro w hw
  rw [tracking_error_integral (hresponse w hw).error_integrable
    Kp (Kp / Ti) Kd Tf w.1 w.2 k hQ hQ0 (div_ne_zero hKp hTi) (herror w hw)]
  unfold trackingMean
  field_simp
  ring

-- Article 14, Theorem 17: the reduction is independent of c for each
-- genuinely feasible pair; c still determines feasibility of the signals.
theorem positive_family_cost_reduction {F : Set (ℝ × ℝ)}
    {e v : (ℝ × ℝ) → ℝ → ℝ} {H : ℝ → ℝ} {δ k Kp Ti : ℝ}
    (h : PositiveMIACEFamily F e v H δ k Kp Ti) (μ α : ℝ)
    (hα : 0 < α) (hH : HasDerivAt H (-μ) 0) (h0 : H 0 = 1)
    {w : ℝ × ℝ} (hw : w ∈ F) :
    (miace α (e w) (v w) halfLine) ^ 2 =
      positiveCommandCostSq k Kp Ti (μ + δ) α w.1 :=
  nonnegative_signal_cost_reduction (h.response w hw) k Kp Ti w.1 μ α hα hH h0
    (h.error_nonnegative w hw) (h.command_nonnegative w hw) (h.error_area w hw)

-- Article 14, Theorem 17: every feasible c above the clipped b attains
-- the constrained minimum of the actual square-root MIACE signal functional.
theorem positive_family_miace_projection {F : Set (ℝ × ℝ)}
    {e v : (ℝ × ℝ) → ℝ → ℝ} {H : ℝ → ℝ} {δ k Kp Ti : ℝ}
    (h : PositiveMIACEFamily F e v H δ k Kp Ti) (μ α lo hi : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) (hH : HasDerivAt H (-μ) 0) (h0 : H 0 = 1)
    (hinterval : ∀ w ∈ F, w.1 ∈ Icc lo hi)
    {wstar : ℝ × ℝ} (hwstar : wstar ∈ F)
    (hb : wstar.1 = clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α))
    {w : ℝ × ℝ} (hw : w ∈ F) :
    miace α (e wstar) (v wstar) halfLine ≤ miace α (e w) (v w) halfLine := by
  apply (sq_le_sq₀ (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)).mp
  change (miace α (e wstar) (v wstar) halfLine) ^ 2 ≤
    (miace α (e w) (v w) halfLine) ^ 2
  rw [positive_family_cost_reduction h μ α hα hH h0 hwstar,
    positive_family_cost_reduction h μ α hα hH h0 hw, hb]
  exact positiveCommandCostSq_projection k Kp Ti (μ + δ) α lo hi w.1
    hTi hα (hinterval w hw)

-- Article 14, Theorem 17: once compact-convex feasibility has supplied its
-- exact interval projection, that projection contains a true MIACE minimizer.
theorem positive_family_miace_minimizer_exists {F : Set (ℝ × ℝ)}
    {e v : (ℝ × ℝ) → ℝ → ℝ} {H : ℝ → ℝ} {δ k Kp Ti : ℝ}
    (h : PositiveMIACEFamily F e v H δ k Kp Ti) (μ α lo hi : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) (hH : HasDerivAt H (-μ) 0) (h0 : H 0 = 1)
    (hlohi : lo ≤ hi)
    (hprojection : ∀ b, (∃ c, (b, c) ∈ F) ↔ b ∈ Icc lo hi) :
    ∃ c, (clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α), c) ∈ F ∧
      ∀ w ∈ F,
        miace α (e (clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α), c))
          (v (clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α), c)) halfLine ≤
            miace α (e w) (v w) halfLine := by
  obtain ⟨c, hc⟩ := (hprojection _).mpr
    (clampedWeight_mem hlohi (miaceTarget k Kp Ti (μ + δ) α))
  refine ⟨c, hc, ?_⟩
  intro w hw
  exact positive_family_miace_projection h μ α lo hi hTi hα hH h0
    (fun w hw => (hprojection w.1).mp ⟨w.2, hw⟩) hc rfl hw

-- Article 14, Theorem 17: exact attainability of the universal MIACE bound
-- in the actual signal family is equivalent to feasibility of the target b.
theorem positive_family_bound_attainable_iff {F : Set (ℝ × ℝ)}
    {e v : (ℝ × ℝ) → ℝ → ℝ} {H : ℝ → ℝ} {δ k Kp Ti : ℝ}
    (h : PositiveMIACEFamily F e v H δ k Kp Ti) (μ α lo hi : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) (hΓ : 0 ≤ μ + δ)
    (hH : HasDerivAt H (-μ) 0) (h0 : H 0 = 1)
    (hprojection : ∀ b, (∃ c, (b, c) ∈ F) ↔ b ∈ Icc lo hi) :
    (∃ w ∈ F, miace α (e w) (v w) halfLine =
      (μ + δ) * Real.sqrt (α / (1 + α))) ↔
        miaceTarget k Kp Ti (μ + δ) α ∈ Icc lo hi := by
  have hratio : 0 ≤ α / (1 + α) := div_nonneg hα.le (by linarith)
  constructor
  · rintro ⟨w, hw, heq⟩
    have hs : positiveCommandCostSq k Kp Ti (μ + δ) α w.1 =
        α * (μ + δ) ^ 2 / (1 + α) := by
      rw [← positive_family_cost_reduction h μ α hα hH h0 hw, heq,
        mul_pow, Real.sq_sqrt hratio]
      ring
    have htarget := (positiveCommandCostSq_eq_bound_iff k Kp Ti (μ + δ) α w.1
      hTi hα).mp hs
    have hb : w.1 ∈ Icc lo hi := (hprojection w.1).mp ⟨w.2, hw⟩
    rwa [htarget] at hb
  · intro hb
    obtain ⟨c, hc⟩ := (hprojection _).mpr hb
    refine ⟨(miaceTarget k Kp Ti (μ + δ) α, c), hc, ?_⟩
    apply (sq_eq_sq₀ (Real.sqrt_nonneg _)
      (mul_nonneg hΓ (Real.sqrt_nonneg _))).mp
    change (miace α (e (miaceTarget k Kp Ti (μ + δ) α, c))
      (v (miaceTarget k Kp Ti (μ + δ) α, c)) halfLine) ^ 2 = _
    rw [positive_family_cost_reduction h μ α hα hH h0 hc]
    have hs := (positiveCommandCostSq_eq_bound_iff k Kp Ti (μ + δ) α
      (miaceTarget k Kp Ti (μ + δ) α) hTi hα).mpr rfl
    rw [hs, mul_pow, Real.sq_sqrt hratio]
    ring

-- Article 14, Theorem 17: compactness, convexity and nonemptiness now DERIVE
-- the interval projection used by the optimizer.  No endpoints or interval
-- representation are assumed by this assembled signal-level theorem.
theorem positive_family_compact_convex_reduction {F : Set (ℝ × ℝ)}
    {e v : (ℝ × ℝ) → ℝ → ℝ} {H : ℝ → ℝ} {δ k Kp Ti : ℝ}
    (h : PositiveMIACEFamily F e v H δ k Kp Ti) (μ α : ℝ)
    (hTi : 0 < Ti) (hα : 0 < α) (hΓ : 0 ≤ μ + δ)
    (hH : HasDerivAt H (-μ) 0) (h0 : H 0 = 1)
    (hF : IsCompact F) (hconv : Convex ℝ F) (hne : F.Nonempty) :
    ∃ lo hi : ℝ, lo ≤ hi ∧
      (∀ b, (∃ c, (b, c) ∈ F) ↔ b ∈ Icc lo hi) ∧
      (∃ c, (clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α), c) ∈ F ∧
        ∀ w ∈ F,
          miace α (e (clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α), c))
            (v (clampedWeight lo hi (miaceTarget k Kp Ti (μ + δ) α), c)) halfLine ≤
              miace α (e w) (v w) halfLine) ∧
      ((∃ w ∈ F, miace α (e w) (v w) halfLine =
        (μ + δ) * Real.sqrt (α / (1 + α))) ↔
          miaceTarget k Kp Ti (μ + δ) α ∈ Icc lo hi) := by
  obtain ⟨lo, hi, hlohi, himage⟩ := compact_convex_projection_interval hF hconv hne
  have hprojection (b : ℝ) : (∃ c, (b, c) ∈ F) ↔ b ∈ Icc lo hi := by
    rw [← himage]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨(b, c), hc, rfl⟩
    · rintro ⟨w, hw, hwb⟩
      refine ⟨w.2, ?_⟩
      simpa only [← hwb] using hw
  exact ⟨lo, hi, hlohi, hprojection,
    positive_family_miace_minimizer_exists h μ α lo hi hTi hα hH h0 hlohi hprojection,
    positive_family_bound_attainable_iff h μ α lo hi hTi hα hΓ hH h0 hprojection⟩

end Article14
end
/- END SOURCE: Article14.MIACEProjection -/

/- BEGIN SOURCE: Article14/PhysicalClosedLoop.lean -/
section
                              
                             
                                  
                                  
                                

/-!
# One physical state trajectory supplies the signal hypotheses

This module composes the state, controller and plant results.  All analytic
integrability and convergence conditions are derived from one exponentially
stable complete state trajectory.  Only the actual differential equations,
initial conditions, and regularity of that trajectory are supplied.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open scoped Topology
open PhysicalPlant PhysicalLaplace

variable {n : Type*} [Fintype n] [DecidableEq n]

/-- Coordinate observation of the complete centered physical state. -/
noncomputable def plantCoordinate (j : n) : ((n → ℝ) × ℝ × ℝ) →L[ℝ] ℝ :=
  (ContinuousLinearMap.proj j).comp (ContinuousLinearMap.fst ℝ (n → ℝ) (ℝ × ℝ))

noncomputable def integralCoordinate : ((n → ℝ) × ℝ × ℝ) →L[ℝ] ℝ :=
  (ContinuousLinearMap.fst ℝ ℝ ℝ).comp
    (ContinuousLinearMap.snd ℝ (n → ℝ) (ℝ × ℝ))

noncomputable def filterCoordinate : ((n → ℝ) × ℝ × ℝ) →L[ℝ] ℝ :=
  (ContinuousLinearMap.snd ℝ ℝ ℝ).comp
    (ContinuousLinearMap.snd ℝ (n → ℝ) (ℝ × ℝ))

noncomputable def errorObservation (C : n → ℝ) : ((n → ℝ) × ℝ × ℝ) →L[ℝ] ℝ :=
  -(∑ j, C j • plantCoordinate j)

noncomputable def commandObservation (C : n → ℝ) (k Kp Ti Td Tf : ℝ) :
    ((n → ℝ) × ℝ × ℝ) →L[ℝ] ℝ :=
  (k*Kp) • (errorObservation C + (1/Ti) • integralCoordinate +
    (Td/Tf) • (errorObservation C - filterCoordinate))

-- These maps are the actual centered error and normalized command, not free
-- choices of an observation unrelated to the plant/controller coordinates.
omit [DecidableEq n] in
theorem errorObservation_apply (C : n → ℝ) (q : (n → ℝ) × ℝ × ℝ) :
    errorObservation C q = -(∑ j, C j * q.1 j) := by
  simp [errorObservation, plantCoordinate]

omit [DecidableEq n] in
theorem commandObservation_apply (C : n → ℝ) (k Kp Ti Td Tf : ℝ)
    (q : (n → ℝ) × ℝ × ℝ) :
    commandObservation C k Kp Ti Td Tf q = k*Kp*
      (errorObservation C q + q.2.1/Ti + Td/Tf*(errorObservation C q-q.2.2)) := by
  simp [commandObservation, integralCoordinate, filterCoordinate, div_eq_mul_inv]
  ring

/-- Actual centered physical equations and initial data.  The command and
error are fixed observations of the same complete state.  In particular no
signal transform, integral, limit, or decay estimate is a field. -/
structure CenteredLoopDynamics (A : Matrix n n ℝ) (B C xInf : n → ℝ)
    (Kp Ti Td Tf k L b c : ℝ) (q : ℝ → (n → ℝ) × ℝ × ℝ) : Prop where
  state_ac : ∀ j T, 0 ≤ T → AbsolutelyContinuousOnInterval (fun t => (q t).1 j) 0 T
  state_initial : ∀ j, (q 0).1 j = -xInf j
  state_ode : ∀ j, ∀ᵐ t : ℝ, 0 < t →
    deriv (fun s => (q s).1 j) t = (∑ l, A j l * (q t).1 l) + B j / k *
      centeredDelay L (fun s => commandObservation C k Kp Ti Td Tf (q s)) t
  controller : CenteredPIDFDynamics
    (fun t => errorObservation C (q t))
    (fun t => commandObservation C k Kp Ti Td Tf (q t))
    (fun t => (q t).2.1) (fun t => (q t).2.2) Kp Ti Td Tf k b c

-- Article 14, Theorems 14–17: a single state estimate supplies every L¹ and
-- limiting hypothesis required by the plant and controller transform proofs.
omit [DecidableEq n] in
theorem centeredLoop_responses_of_decay
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hq : ContinuousOn q (Ici 0)) {D α : ℝ} (hD : 0 < D) (hα : 0 < α)
    (hd : ∀ t, 0 ≤ t → ‖q t‖ ≤ D * Real.exp (-α*t)) :
    CenteredPlantResponse A B xInf k L (fun j t => (q t).1 j)
      (fun t => commandObservation C k Kp Ti Td Tf (q t)) ∧
    CenteredPIDFResponse (fun t => errorObservation C (q t))
      (fun t => commandObservation C k Kp Ti Td Tf (q t))
      (fun t => (q t).2.1) (fun t => (q t).2.2) Kp Ti Td Tf k b c := by
  have hx := fun j => linear_observable_admissible q (plantCoordinate j) hq hD hα hd
  have he := linear_observable_admissible q (errorObservation C) hq hD hα hd
  have hv := linear_observable_admissible q (commandObservation C k Kp Ti Td Tf) hq hD hα hd
  have hi := linear_observable_admissible q (integralCoordinate (n := n)) hq hD hα hd
  have hf := linear_observable_admissible q (filterCoordinate (n := n)) hq hD hα hd
  constructor
  · exact ⟨h.state_ac, fun j => (hx j).2.1, fun j => (hx j).2.2.1,
      h.state_initial, h.state_ode, hv.2.1⟩
  · exact ⟨h.controller, he.2.1, hv.2.1, hi.2.1, hf.2.1, hi.2.2.1, hf.2.2.1⟩

/-- The strictly proper output map of the same finite plant. -/
noncomputable def finitePlantOutput (C : n → ℝ) (x : n → ℝ) : ℝ := ∑ j, C j*x j

/-- The actual undelayed state equation used inside the delayed realization. -/
noncomputable def finitePlantDynamics (A : Matrix n n ℝ) (B : n → ℝ)
    (x : n → ℝ) (u : ℝ) : n → ℝ := fun j => (∑ l, A j l*x l) + B j*u

-- Article 14, Theorems 14–17: the existing all-history stability predicate
-- supplies the analytic hypotheses for the very same finite plant. The
-- after-delay equation is a physical differential equation, not a transform.
omit [DecidableEq n] in
theorem stable_centeredLoop_responses
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hL : 0 ≤ L) (hq : ContinuousOn q (Ici 0))
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (hode : ∀ t, L < t → HasDerivAt q
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => q (t+θ))) t) :
    CenteredPlantResponse A B xInf k L (fun j t => (q t).1 j)
      (fun t => commandObservation C k Kp Ti Td Tf (q t)) ∧
    CenteredPIDFResponse (fun t => errorObservation C (q t))
      (fun t => commandObservation C k Kp Ti Td Tf (q t))
      (fun t => (q t).2.1) (fun t => (q t).2.2) Kp Ti Td Tf k b c := by
  obtain ⟨D, α, hD, hα, hd⟩ := retardedShared_stable_tail_decay
    (finitePlantOutput C) (finitePlantDynamics A B) Kp Ti Td Tf L b c q hL hs hq hode
  exact centeredLoop_responses_of_decay h hq hD hα hd

-- Article 14, Theorems 14–17: the derived plant interface and actual error
-- area are now simultaneous conclusions from one stable physical trajectory.
theorem stable_centeredLoop_transfer_and_area
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hL : 0 ≤ L) (hq : ContinuousOn q (Ici 0))
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (hode : ∀ t, L < t → HasDerivAt q
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => q (t+θ))) t)
    (heq : ∀ j, (∑ l, A j l*xInf l) + B j/k = 0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0) :
    LocalTransferResponse (fun t => errorObservation C (q t))
      (fun t => commandObservation C k Kp Ti Td Tf (q t))
      (normalizedTransfer A B C k) L ∧
    (∫ t, errorObservation C (q t) ∂halfLine) = meanTime Ti k Kp b := by
  obtain ⟨hp, hc⟩ := stable_centeredLoop_responses h hL hq hs hode
  constructor
  · have ht := localTransfer_of_centered_plant (C := C) hp hL heq hout hA
    change LocalTransferResponse (fun t => -(∑ j, C j * (q t).1 j)) _ _ _ at ht
    simpa only [errorObservation_apply] using ht
  · exact centeredPIDF_error_area hc

-- Article 14, Theorems 14–17: the complete local signal result, with both
-- signed areas and the actual PIDF error transform derived from the state.
theorem stable_centeredLoop_signal_identities
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hL : 0 ≤ L) (hq : ContinuousOn q (Ici 0))
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (hode : ∀ t, L < t → HasDerivAt q
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => q (t+θ))) t)
    (heq : ∀ j, (∑ l, A j l*xInf l) + B j/k = 0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTi : Ti ≠ 0) (hTf : 0 < Tf) :
    let e := fun t => errorObservation C (q t)
    let v := fun t => commandObservation C k Kp Ti Td Tf (q t)
    (∫ t, e t ∂halfLine) = meanTime Ti k Kp b ∧
    (∫ t, v t ∂halfLine) = residenceTime A C xInf + L - meanTime Ti k Kp b ∧
    laplace e =ᶠ[𝓝[>] (0 : ℝ)]
      clearedError (inverseDelayedPlant (normalizedTransfer A B C k) k L)
        Kp (Kp/Ti) (Kp*Td) Tf b c := by
  obtain ⟨_, hc⟩ := stable_centeredLoop_responses h hL hq hs hode
  obtain ⟨hp, hm⟩ := stable_centeredLoop_transfer_and_area h hL hq hs hode heq hout hA
  have hd := normalizedTransfer_hasDerivAt_zero heq hout hA
  have h0 := normalizedTransfer_zero heq hout hA
  exact ⟨hm, centeredPIDF_command_area hc hp hd h0,
    centeredPIDF_local_clearedError hc hp hd.continuousAt h0 hTi hk hKp hTf⟩

-- Article 14, Theorem 17: the universal MIACE estimate now starts from the
-- actual finite-state delayed PIDF trajectory. Γ is computed from A,C,x∞,L.
theorem stable_centeredLoop_miace_bound
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hL : 0 ≤ L) (hq : ContinuousOn q (Ici 0))
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (hode : ∀ t, L < t → HasDerivAt q
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => q (t+θ))) t)
    (heq : ∀ j, (∑ l, A j l*xInf l) + B j/k = 0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (α : ℝ) (hα : 0 < α) (hΓ : 0 ≤ residenceTime A C xInf + L) :
    (residenceTime A C xInf + L) * Real.sqrt (α/(1+α)) ≤
      miace α (fun t => errorObservation C (q t))
        (fun t => commandObservation C k Kp Ti Td Tf (q t)) halfLine := by
  obtain ⟨hp, _⟩ := stable_centeredLoop_transfer_and_area h hL hq hs hode heq hout hA
  exact local_transfer_miace_lower_bound hp α (residenceTime A C xInf) hα hΓ
    (normalizedTransfer_hasDerivAt_zero heq hout hA) (normalizedTransfer_zero heq hout hA)

-- Article 14, Proposition 15: this actual time moment requires no separate
-- exponential-envelope or transform hypothesis; internal stability supplies both.
theorem stable_centeredLoop_first_error_moment
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hL : 0 ≤ L) (hq : ContinuousOn q (Ici 0))
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (hode : ∀ t, L < t → HasDerivAt q
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => q (t+θ))) t)
    (heq : ∀ j, (∑ l, A j l*xInf l) + B j/k = 0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (hk : k ≠ 0) (hKp : Kp ≠ 0) (hTi : Ti ≠ 0) (hTf : 0 < Tf) :
    (∫ t, t * errorObservation C (q t) ∂halfLine) =
      secondErrorMoment Kp (Kp/Ti) (Kp*Td) k (residenceTime A C xInf + L)
        (meanTime Ti k Kp b) c := by
  obtain ⟨D, β, hD, hβ, hd⟩ := retardedShared_stable_tail_decay
    (finitePlantOutput C) (finitePlantDynamics A B) Kp Ti Td Tf L b c q hL hs hq hode
  obtain ⟨_, hc⟩ := centeredLoop_responses_of_decay h hq hD hβ hd
  obtain ⟨hp, _⟩ := stable_centeredLoop_transfer_and_area h hL hq hs hode heq hout hA
  obtain ⟨he, _, _, E, hE, hedecay⟩ := linear_observable_admissible q
    (errorObservation C) hq hD hβ hd
  exact centeredPIDF_first_error_moment hc hp
    (normalizedTransfer_hasDerivAt_zero heq hout hA) (normalizedTransfer_zero heq hout hA)
    hTi hk hKp hTf he hE.le hβ hedecay

-- Article 14, Theorem 17: on actual nonnegative error/command signals the
-- fixed-feedback physical response has the exact scalar MIACE objective.
theorem stable_centeredLoop_nonnegative_miace
    {A : Matrix n n ℝ} {B C xInf : n → ℝ} {Kp Ti Td Tf k L b c : ℝ}
    {q : ℝ → (n → ℝ) × ℝ × ℝ}
    (h : CenteredLoopDynamics A B C xInf Kp Ti Td Tf k L b c q)
    (hL : 0 ≤ L) (hq : ContinuousOn q (Ici 0))
    (hs : IsRetardedSharedExponentiallyStable (finitePlantOutput C)
      (finitePlantDynamics A B) Kp Ti Td Tf L b c)
    (hode : ∀ t, L < t → HasDerivAt q
      (retardedSharedRhs (finitePlantOutput C) (finitePlantDynamics A B)
        Kp Ti Td Tf L b c (fun _ => 0) (fun θ => q (t+θ))) t)
    (heq : ∀ j, (∑ l, A j l*xInf l) + B j/k = 0)
    (hout : (∑ j, C j*xInf j) = 1) (hA : (pencil A 0).det ≠ 0)
    (he : ∀ᵐ t ∂halfLine, 0 ≤ errorObservation C (q t))
    (hv : ∀ᵐ t ∂halfLine, 0 ≤ commandObservation C k Kp Ti Td Tf (q t)) (α : ℝ) :
    miace α (fun t => errorObservation C (q t))
      (fun t => commandObservation C k Kp Ti Td Tf (q t)) halfLine =
    Real.sqrt ((meanTime Ti k Kp b)^2 +
      α*(residenceTime A C xInf + L - meanTime Ti k Kp b)^2) := by
  obtain ⟨_, hc⟩ := stable_centeredLoop_responses h hL hq hs hode
  obtain ⟨hp, _⟩ := stable_centeredLoop_transfer_and_area h hL hq hs hode heq hout hA
  exact centeredPIDF_nonnegative_miace hc hp
    (normalizedTransfer_hasDerivAt_zero heq hout hA) (normalizedTransfer_zero heq hout hA)
    he hv α

end Article14
end
