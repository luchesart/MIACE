  | succ n ih =>
    have hn : ∀ j≤n, 0<σ j := fun j hj => hσ j (by omega)
    have hs := hσ (n+1) le_rfl
    have hh := lagState_causal_formula hs 0 (ordinaryCascade σ u (n+1))
    simp only [lagState_zero,zero_mul,zero_add] at hh
    have he := convolution_congr (ContinuousLinearMap.lsmul ℝ ℝ)
      (EventuallyEq.rfl (f := lagKernel (σ (n+1)))) (ih hn)
    exact hh.trans ((Filter.EventuallyEq.of_eq he).trans
      (causal_convolution_assoc (lagKernel_properties hs).1 (serialImpulse_properties σ n hn).1 hu
        (lagKernel_properties hs).2.2.2 (serialImpulse_properties σ n hn).2 huc).symm)

