      (∀ᵐ t ∂halfLine, 0≤v t ∧ v t≤c) ∧
      (∀ t, 0≤t → 0≤cascadeStepError N σ δ v t) ∧ commandArea v=U) ↔ 0≤U ∧ U≤Umax) ∧
    ((∃ F : IMCFilter, ∃ v : ℝ → ℝ, NominalCascadeIMC N σ F δ v ∧
      (∀ᵐ t ∂halfLine, 0≤v t ∧ v t≤c) ∧
      miace α (cascadeStepError N σ δ v) v halfLine=S*minimum α) ↔ S/(1+α)≤Umax) ∧
    (S/(1+α)≤Umax ↔ S/Umax-1≤α) ∧
    (∀ U : ℝ, 0≤U → U≤Umax → ∃ hT : 0≤U/c,
      NominalCascadeIMC N σ (pulseIMC c (U/c) hT) δ (pulse c (U/c))) ∧
    ∀ v : ℝ → ℝ, Integrable v → (∀ᵐ t ∂halfLine, 0≤v t ∧ v t≤c) →
      (∀ t, 0≤t → 0≤cascadeStepError N σ δ v t) → commandArea v=Umax →
      v=ᵐ[halfLine] pulse c (Real.log (1+1/c)) := by
  refine ⟨fun U => paper_complete_cap_areas N σ hδ hc hσ hfirst,
    paper_complete_cap_attainment N σ hδ hc hα hσ hfirst,capped_attainment_weight_iff hα hc,?_,?_⟩
  · intro U hU _
    exact ⟨div_nonneg hU hc.le,pulse_cascade_IMC N σ c hδ (div_nonneg hU hc.le) hσ hfirst⟩
  · intro v hv hcap he harea
    exact paper_complete_cap_unique N σ hδ hc hσ hfirst hv hcap he harea

-- @paper-step thm:complete_robust/full_two_family_statement
theorem paper_complete_robust_families (N : ℕ) (σ : ℕ → ℝ) {δ ε α : ℝ}
    (hδ : 0≤δ) (hδε : 0≤δ+ε) (hα : 0≤α)
