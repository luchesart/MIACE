-- @paper-step thm:jump/O-exact-assignment-physical-limit
theorem oAssignedStepCommand_rightLimit {X : Type*}
    [NormedAddCommGroup X] [NormedSpace ℝ X]
    (output : X →L[ℝ] ℝ) (Kp Ti Td Tf σ π Δr : ℝ)
    (state : ℝ → X × ℝ × ℝ)
