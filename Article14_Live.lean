noncomputable def pidReduce (ρ : ℝ) (x : Fin 3 → ℝ) : Fin 3 → ℝ :=
  ![x 1 + (1-ρ)*x 2, x 0-x 1, x 1]
noncomputable def pidRestore (ρ : ℝ) (u : Fin 3 → ℝ) : Fin 3 → ℝ :=
  ![u 1+u 2, u 2, (u 0-u 2)/(1-ρ)]

