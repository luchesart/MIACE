-- @paper-step thm:complete_robust/causal_extension_invariance
theorem causalize_eq_ae {f : ℝ → ℝ} (hf : Causal f) : causalize f=ᵐ[volume] f := by
  filter_upwards [hf] with t ht
  by_cases hp : 0≤t
  · simp [causalize,hp]
  · simp [causalize,hp,ht (lt_of_not_ge hp)]

-- @paper-step thm:complete_robust/causal_transform_full_injectivity
theorem causal_laplace_ext {f g : ℝ → ℝ} (hf : Integrable f) (hg : Integrable g)
    (hfc : Causal f) (hgc : Causal g)
    (hh : ∀ p : ℝ, 0<p → laplace f p=laplace g p) : f=ᵐ[volume] g :=
  (causalize_of_halfLine_eq hfc (laplace_injective_ae hf hg hh)).trans (causalize_eq_ae hgc)

-- @paper-step thm:complete_robust/causal_operator_transform
theorem convOp_laplace {K : ℝ → ℝ} (hK : Integrable K) (hKc : Causal K)
    {g : RealL1} (hgc : Causal g) {p : ℝ} (hp : 0≤p) :
