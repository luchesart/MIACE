    (pidTimeCommand_transform h.plant.error_integrable _ _ _ hρ (by norm_num : (0 : ℝ)<1)).1
    (laplace_step_add h.plant.command_integrable (by norm_num : (0 : ℝ)<1)).1
    (pidTimeCommand_continuous h.error_continuous _ _ _ _)
    (continuous_const.add h.command_continuous)
