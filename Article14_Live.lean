    exact (ha s hs).deriv
  have hdd : HasDerivAt (deriv a) (-(deriv a t+deriv b t)/ρ) t :=
    hh.congr_of_eventuallyEq he
  exact pid_reduced_scalar_equation hρ (ha t ht0).deriv
    (ha (t-δ) (sub_pos.mpr ht)).deriv hb.deriv hdd.deriv

-- @paper-step thm:pid_two_rate_optimum/restored_stable_mode_initial
theorem pidStableState_initial (c₀ : ℝ) (b : ℝ → ℝ) :
    pidStableState c₀ b 0=c₀ := by simp [pidStableState,lag]

-- @paper-step thm:pid_two_rate_optimum/restored_stable_mode_derivative
theorem pidStableState_derivative (c₀ : ℝ) {b : ℝ → ℝ} (hb : Continuous b)
    {t : ℝ} (ht : 0<t) :
    HasDerivAt (pidStableState c₀ b) (-pidStableState c₀ b t-b t) t := by
  have he : HasDerivAt (fun s : ℝ => Real.exp (-s)) (-Real.exp (-t)) t := by
    simpa using (hasDerivAt_id t).neg.exp
  have hl := lag_hasDerivAt hb.continuousOn 1 t (by norm_num) ht
  convert (he.const_mul c₀).sub hl using 1
  · rfl
  · dsimp only [pidStableState]
    ring

-- @paper-step thm:pid_two_rate_optimum/restored_stable_mode_decay
theorem pidStableState_decay (c₀ : ℝ) {b : ℝ → ℝ} {η : ℝ}
    (hη : η≤1) (hb : Integrable (expWeight η (causalize b))) {t : ℝ} (ht : 0≤t) :
    |pidStableState c₀ b t| ≤
      (|c₀|+(∫ s, |expWeight η (causalize b) s|))*Real.exp (-η*t) := by
  have hl := lag_weighted_decay (by norm_num : (0 : ℝ)<1) (by simpa using hη) hb ht
  have he : Real.exp (-t)≤Real.exp (-η*t) := Real.exp_le_exp.mpr (by nlinarith)
  have hm := mul_le_mul_of_nonneg_left he (abs_nonneg c₀)
  have ha := abs_sub_le (c₀*Real.exp (-t)) 0 (lag 1 b t)
  simp only [sub_zero,zero_sub,abs_neg,abs_mul,abs_of_pos (Real.exp_pos _)] at ha
  simp only [div_self one_ne_zero,one_mul] at hl
  unfold pidStableState
  nlinarith

-- @paper-step thm:pid_two_rate_optimum/all_three_state_decay_from_reduced_pair
theorem pidRestore_decay {ρ η Ca Cb : ℝ} (hρ : ρ ≠ 1) (hη : η≤1)
    (c₀ : ℝ) {a b : ℝ → ℝ} (hb : Integrable (expWeight η (causalize b)))
    (ha : ∀ t, 0≤t → |a t|≤Ca*Real.exp (-η*t))
    (hbb : ∀ t, 0≤t → |b t|≤Cb*Real.exp (-η*t)) :
    let Cc := |c₀|+∫ s, |expWeight η (causalize b) s|
    ∀ t, 0≤t →
      |(pidRestore ρ ![a t,b t,pidStableState c₀ b t]) 0|≤(Cb+Cc)*Real.exp (-η*t) ∧
      |(pidRestore ρ ![a t,b t,pidStableState c₀ b t]) 1|≤Cc*Real.exp (-η*t) ∧
      |(pidRestore ρ ![a t,b t,pidStableState c₀ b t]) 2|≤
        ((Ca+Cc)/|1-ρ|)*Real.exp (-η*t) := by
  dsimp only
  intro t ht
  have hc := pidStableState_decay c₀ hη hb ht
  have ha' := ha t ht
  have hb' := hbb t ht
  refine ⟨?_,hc,?_⟩
  · change |b t+pidStableState c₀ b t| ≤ _
    have hh := abs_add_le (b t) (pidStableState c₀ b t)
    nlinarith
  · change |(a t-pidStableState c₀ b t)/(1-ρ)| ≤ _
    rw [abs_div]
    have hd : 0 < |1-ρ| := abs_pos.mpr (sub_ne_zero.mpr hρ.symm)
    apply (div_le_iff₀ hd).mpr
    have hh := abs_sub_le (a t) 0 (pidStableState c₀ b t)
    simp only [sub_zero,zero_sub,abs_neg] at hh
    field_simp
    simp only [neg_mul] at hc ha' hb'
    nlinarith

-- @paper-step thm:pid_two_rate_optimum/stable_mode_uniqueness_from_actual_ODE
theorem pidStableState_unique {c b : ℝ → ℝ}
    (hc : ∀ T, 0≤T → AbsolutelyContinuousOnInterval c 0 T)
    (hode : ∀ᵐ t, 0<t → deriv c t = -c t-b t) {t : ℝ} (ht : 0≤t) :
    c t=pidStableState (c 0) b t := by
  have he : AbsolutelyContinuousOnInterval Real.exp 0 t := by
    apply ContDiffOn.absolutelyContinuousOnInterval
    fun_prop
  have hi := (hc t ht).integral_deriv_mul_eq_sub he
  have hi' : (∫ s in 0..t, deriv c s*Real.exp s+c s*deriv Real.exp s)=
      -(∫ s in 0..t, Real.exp s*b s) := by
    rw [← intervalIntegral.integral_neg]
    apply intervalIntegral.integral_congr_ae
    filter_upwards [hode] with s hs hst
    rw [uIoc_of_le ht] at hst
    rw [hs hst.1,Real.deriv_exp]
    ring
  rw [hi',Real.exp_zero,mul_one] at hi
  have hh := congrArg (fun u => Real.exp (-t)*u) hi
  have hcancel : Real.exp (-t)*Real.exp t=1 := by rw [← Real.exp_add]; simp
  unfold pidStableState lag
  simp only [div_one] at ⊢
  have heq : Real.exp (-t)*(c t*Real.exp t)=c t := by
    calc
      _ = (Real.exp (-t)*Real.exp t)*c t := by ring
      _ = c t := by rw [hcancel,one_mul]
  rw [mul_sub,heq] at hh
  linarith

-- @paper-step thm:pid_two_rate_optimum/actual_state_decay_from_reduced_bounds
theorem pid_actual_state_decay {y z ζ : ℝ → ℝ} {ρ η Ca Cb : ℝ}
    (hρ : ρ ≠ 1) (hη : η≤1)
    (hz : ∀ T, 0≤T → AbsolutelyContinuousOnInterval z 0 T)
    (hode : ∀ᵐ t, 0<t → deriv z t = -y t)
    (hb : Integrable (expWeight η (causalize (fun t => y t-z t))))
    (ha : ∀ t, 0≤t → |z t+(1-ρ)*ζ t|≤Ca*Real.exp (-η*t))
    (hbb : ∀ t, 0≤t → |y t-z t|≤Cb*Real.exp (-η*t)) :
    let Cc := |z 0|+∫ s, |expWeight η (causalize (fun t => y t-z t)) s|
    ∀ t, 0≤t → |y t|≤(Cb+Cc)*Real.exp (-η*t) ∧
      |z t|≤Cc*Real.exp (-η*t) ∧
      |ζ t|≤((Ca+Cc)/|1-ρ|)*Real.exp (-η*t) := by
  dsimp only
  intro t ht
  have he : z t=pidStableState (z 0) (fun s => y s-z s) t := by
    apply pidStableState_unique hz _ ht
    filter_upwards [hode] with s hs hst
    rw [hs hst]
    ring
  have hh := pidRestore_decay hρ hη (z 0) hb ha hbb t ht
  rw [← he] at hh
  have hr := pidRestore_reduce hρ ![y t,z t,ζ t]
  change pidRestore ρ ![z t+(1-ρ)*ζ t,y t-z t,z t]=![y t,z t,ζ t] at hr
  rw [hr] at hh
  exact hh

end MIACE
end
