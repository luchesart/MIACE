    (hfg.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hh)
    (hf.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hgh)
    (ae_of_all _ (convolution_causal hfgc hhc)) (ae_of_all _ (convolution_causal hfc hghc))
  intro p hp
  rw [causal_convolution_laplace hfg hh hfgc hhc hp.le,
    causal_convolution_laplace hf hgh hfc hghc hp.le,
    causal_convolution_laplace hf hg hfc hgc hp.le,
    causal_convolution_laplace hg hh hgc hhc hp.le]
  ring

-- @paper-step thm:complete_robust/weighted_control_smaller_exponent
theorem weightedControl_lower {β η C : ℝ} {f : ℝ → ℝ}
