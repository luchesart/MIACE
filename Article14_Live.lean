section
                               
                                        
                           

/-!
# Optimization over the physical delayed PIDF family

All signals, kernels, affine maps, their independence, and their mass are
constructed by `StablePIDFData`.  The remaining hypotheses here are the
engineering constraint set, its stated geometric properties, and nonemptiness
when a minimizer is requested.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open scoped Topology

namespace StablePIDFData
variable {n : Type*} [Fintype n] [DecidableEq n]

/-- The original positive-impulse feasible set of Theorem 14. -/
noncomputable def feasible (d : StablePIDFData n) (X : Set (ℝ × ℝ)) : Set (ℝ × ℝ) :=
  kernelFeasible X d.kernelBase d.kernelDirections

/-- Theorem 17's additional positive centered-command constraint. -/
noncomputable def positiveFeasible (d : StablePIDFData n)
    (X : Set (ℝ × ℝ)) : Set (ℝ × ℝ) :=
  positiveCommandFeasible X d.kernelBase d.kernelDirections
    d.commandBase d.commandDirections

theorem mem_feasible_iff (d : StablePIDFData n) (X : Set (ℝ × ℝ)) (w : ℝ × ℝ) :
    w ∈ d.feasible X ↔ w ∈ X ∧ ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t := by
  change (w ∈ X ∧ (0 : RealL1) ≤ d.kernelBase+d.kernelDirections w) ↔ _
  rw [← d.kernelL1_eq, kernelL1, signalL1_nonnegative_iff]

theorem feasible_kernel_nonnegative (d : StablePIDFData n) {X : Set (ℝ × ℝ)}
    {w : ℝ × ℝ} (hw : w ∈ d.feasible X) : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t :=
  ((d.mem_feasible_iff X w).mp hw).2

theorem mem_positiveFeasible_iff (d : StablePIDFData n)
    (X : Set (ℝ × ℝ)) (w : ℝ × ℝ) :
    w ∈ d.positiveFeasible X ↔
      w ∈ d.feasible X ∧ ∀ᵐ t ∂halfLine, 0 ≤ d.command w t := by
  change (w ∈ d.feasible X ∧ (0 : RealL1) ≤
    d.commandBase+d.commandDirections w) ↔ _
  rw [← d.commandL1_eq, commandL1, signalL1_nonnegative_iff]

theorem positiveFeasible_subset (d : StablePIDFData n) (X : Set (ℝ × ℝ)) :
    d.positiveFeasible X ⊆ d.feasible X := fun _ hw => hw.1

theorem feasible_closed (d : StablePIDFData n) {X : Set (ℝ × ℝ)} (hX : IsClosed X) :
    IsClosed (d.feasible X) := kernelFeasible_closed hX _ _

theorem feasible_convex (d : StablePIDFData n) {X : Set (ℝ × ℝ)} (hX : Convex ℝ X) :
    Convex ℝ (d.feasible X) := kernelFeasible_convex hX _ _

theorem feasible_compact (d : StablePIDFData n) {X : Set (ℝ × ℝ)} (hX : IsClosed X) :
    IsCompact (d.feasible X) := by
  apply kernelFeasible_compact hX d.kernelBase d.kernelDirections d.kernelDirections_injective
  intro w _
  rw [← d.kernelL1_eq]
  exact d.kernel_mass_l1 w

theorem positiveFeasible_closed (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) : IsClosed (d.positiveFeasible X) :=
  positiveCommandFeasible_closed hX _ _ _ _

theorem positiveFeasible_convex (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : Convex ℝ X) : Convex ℝ (d.positiveFeasible X) :=
  positiveCommandFeasible_convex hX _ _ _ _

theorem positiveFeasible_compact (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) : IsCompact (d.positiveFeasible X) :=
  (d.feasible_compact hX).of_isClosed_subset
    (d.positiveFeasible_closed hX) (d.positiveFeasible_subset X)

theorem positiveFeasible_projection_interval (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) (hconv : Convex ℝ X)
    (hne : (d.positiveFeasible X).Nonempty) :
    ∃ lo hi : ℝ, lo ≤ hi ∧ Prod.fst '' d.positiveFeasible X = Icc lo hi :=
  compact_convex_projection_interval (d.positiveFeasible_compact hX)
    (d.positiveFeasible_convex hconv) hne

-- Both signs now come from physical feasibility; the transfer and signed
-- area come from the very same constructed physical trajectory.
theorem positiveMIACEFamily (d : StablePIDFData n) (X : Set (ℝ × ℝ)) :
    PositiveMIACEFamily (d.positiveFeasible X) d.error d.command
      d.transfer d.L d.k d.Kp d.Ti := by
  refine ⟨fun w _ => (d.physical_transfer w).1, ?_, ?_, ?_⟩
  · intro w hw
    have hg : (0 : RealL1) ≤ d.kernelL1 w := by
      rw [d.kernelL1_eq]
      exact hw.1.2
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hb := (positive_kernel_step_bounds (L1.integrable_coeFn (d.kernelL1 w))
      ((Lp.coeFn_nonneg _).mpr hg) (d.kernel_mass_l1 w) t).2
    rw [d.kernelStep_eq_output_l1 w t (le_of_lt ht)] at hb
    exact sub_nonneg.mpr hb
  · intro w hw
    exact ((d.mem_positiveFeasible_iff X w).mp hw).2
  · intro w _
    rw [(d.physical_transfer w).2]
    unfold meanTime trackingMean
    ring

-- Theorem 17 with only physical plant/controller data and closed convex X.
-- The feasible interval and a true MIACE minimizer are derived conclusions.
theorem physical_miace_reduction (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) (hconv : Convex ℝ X)
    (hne : (d.positiveFeasible X).Nonempty) (α : ℝ) (hα : 0 < α)
    (hΓ : 0 ≤ d.gamma) :
    ∃ lo hi : ℝ, lo ≤ hi ∧
      (∀ b, (∃ c, (b,c) ∈ d.positiveFeasible X) ↔ b ∈ Icc lo hi) ∧
      (∃ c, (clampedWeight lo hi (miaceTarget d.k d.Kp d.Ti d.gamma α), c) ∈
        d.positiveFeasible X ∧
        ∀ w ∈ d.positiveFeasible X,
          miace α (d.error (clampedWeight lo hi (miaceTarget d.k d.Kp d.Ti d.gamma α), c))
            (d.command (clampedWeight lo hi (miaceTarget d.k d.Kp d.Ti d.gamma α), c))
            halfLine ≤ miace α (d.error w) (d.command w) halfLine) ∧
      ((∃ w ∈ d.positiveFeasible X,
        miace α (d.error w) (d.command w) halfLine = d.gamma*Real.sqrt (α/(1+α))) ↔
        miaceTarget d.k d.Kp d.Ti d.gamma α ∈ Icc lo hi) := by
  have h := positive_family_compact_convex_reduction (d.positiveMIACEFamily X)
    (d.gamma-d.L) α d.Ti_pos hα (by simpa using hΓ)
    d.transfer_hasDerivAt_zero d.transfer_zero
    (d.positiveFeasible_compact hX) (d.positiveFeasible_convex hconv) hne
  simpa only [sub_add_cancel] using h

-- Every feasible derivative weight over the projected proportional weight
-- gives the same exact minimum of the actual MIACE functional.
theorem physical_miace_every_clipped_fiber (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) (hconv : Convex ℝ X)
    (hne : (d.positiveFeasible X).Nonempty) (α : ℝ) (hα : 0 < α) :
    ∃ lo hi : ℝ, lo ≤ hi ∧ Prod.fst '' d.positiveFeasible X = Icc lo hi ∧
      ∀ wstar ∈ d.positiveFeasible X,
        wstar.1 = clampedWeight lo hi (miaceTarget d.k d.Kp d.Ti d.gamma α) →
        (∀ w ∈ d.positiveFeasible X,
          miace α (d.error wstar) (d.command wstar) halfLine ≤
            miace α (d.error w) (d.command w) halfLine) ∧
        (miace α (d.error wstar) (d.command wstar) halfLine)^2 =
          α*d.gamma^2/(1+α)+(1+α)*d.Ti^2 *
            (clampedWeight lo hi (miaceTarget d.k d.Kp d.Ti d.gamma α)-
              miaceTarget d.k d.Kp d.Ti d.gamma α)^2 := by
  have h := positiveCommandFeasible_every_clipped_fiber hX hconv
    d.kernelBase d.kernelDirections d.commandBase d.commandDirections
    d.kernelDirections_injective (fun w _ => by
      rw [← d.kernelL1_eq]; exact d.kernel_mass_l1 w) hne
    (d.positiveMIACEFamily X) (d.gamma-d.L) α d.Ti_pos hα
    d.transfer_hasDerivAt_zero d.transfer_zero
  simpa only [positiveFeasible, sub_add_cancel] using h

-- The exact gap identity holds for every physical weight pair, including
-- responses with negative error or negative centered command.
theorem physical_miace_gap (d : StablePIDFData n) (w : ℝ × ℝ)
    (α : ℝ) (hα : 0 < α) :
    (miace α (d.error w) (d.command w) halfLine)^2-α*d.gamma^2/(1+α) =
      4*α/(1+α)*(negArea (d.error w) halfLine+negArea (d.command w) halfLine) *
        (d.gamma+(negArea (d.error w) halfLine+negArea (d.command w) halfLine)) +
      (absArea (d.error w) halfLine-α*absArea (d.command w) halfLine)^2/(1+α) := by
  simpa only [sub_add_cancel] using local_transfer_miace_gap
    (d.transfer_response w) α (d.gamma-d.L) hα
    d.transfer_hasDerivAt_zero d.transfer_zero

theorem physical_signed_areas (d : StablePIDFData n) (w : ℝ × ℝ) :
    (∫ t, d.error w t ∂halfLine) = meanTime d.Ti d.k d.Kp w.1 ∧
    (∫ t, d.command w t ∂halfLine) = d.gamma-meanTime d.Ti d.k d.Kp w.1 := by
  refine ⟨d.error_area w, ?_⟩
  have hb := local_transfer_signed_balance (d.transfer_response w) (d.gamma-d.L)
    d.transfer_hasDerivAt_zero d.transfer_zero
  rw [d.error_area, sub_add_cancel] at hb
  linarith

/-- The causal physical step output. Its ordinary impulse integral is proved
below, and agrees with the actual plant state at every nonnegative time. -/
noncomputable def output (d : StablePIDFData n) (w : ℝ × ℝ) (t : ℝ) : ℝ :=
  if 0 ≤ t then finitePlantOutput d.C (d.response w t).1 else 0

theorem kernelL1_causal (d : StablePIDFData n) (w : ℝ × ℝ) :
    Causal (fun t => d.kernelL1 w t) := by
  filter_upwards [signalL1_coe (d.kernel w) (d.kernel_integrable w)] with t ht hneg
  change signalL1 (d.kernel w) (d.kernel_integrable w) t = 0
  rw [ht]
  simp [causalize, not_le.mpr hneg]

theorem output_eq_l1KernelStep (d : StablePIDFData n) (w : ℝ × ℝ) :
    d.output w = l1KernelStep (d.kernelBase+d.kernelDirections w) := by
  rw [← d.kernelL1_eq]
  funext t
  by_cases ht : 0 ≤ t
  · simpa only [output, ite_eq_left ht, l1KernelStep] using
      (d.kernelStep_eq_output_l1 w t ht).symm
  · have hz := causal_kernel_step_zero (d.kernelL1_causal w) (le_of_not_ge ht)
    simpa only [output, ite_eq_right ht, l1KernelStep] using hz.symm

-- Theorem 14(a): positivity is equivalent to monotonicity of the physical
-- step output, with both directions proved for the constructed kernel.
theorem physical_output_monotone_iff (d : StablePIDFData n) (w : ℝ × ℝ) :
    Monotone (d.output w) ↔ ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t := by
  rw [d.output_eq_l1KernelStep, ← d.kernelL1_eq]
  change Monotone (kernelStep (fun t => d.kernelL1 w t)) ↔ _
  rw [kernel_step_monotone_iff (L1.integrable_coeFn (d.kernelL1 w))]
  change (0 : ℝ → ℝ) ≤ᵐ[volume] (d.kernelL1 w : ℝ → ℝ) ↔ _
  rw [Lp.coeFn_nonneg, kernelL1, signalL1_nonnegative_iff]

theorem physical_output_bounds (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} {w : ℝ × ℝ} (hw : w ∈ d.feasible X) (t : ℝ) :
    0 ≤ d.output w t ∧ d.output w t ≤ 1 := by
  rw [d.output_eq_l1KernelStep]
  exact positive_kernel_step_bounds (L1.integrable_coeFn _)
    ((Lp.coeFn_nonneg _).mpr hw.2)
    (by rw [← d.kernelL1_eq]; exact d.kernel_mass_l1 w) t

theorem physical_output_initial (d : StablePIDFData n) (w : ℝ × ℝ) :
    d.output w 0 = 0 := by
  rw [d.output_eq_l1KernelStep, ← d.kernelL1_eq]
  exact causal_kernel_step_zero (d.kernelL1_causal w) le_rfl

theorem physical_output_final (d : StablePIDFData n) (w : ℝ × ℝ) :
    Tendsto (d.output w) atTop (𝓝 1) := by
  rw [d.output_eq_l1KernelStep, ← d.kernelL1_eq]
  exact unit_mass_kernel_step_tendsto_one (L1.integrable_coeFn _) (d.kernel_mass_l1 w)

-- The exact norm is taken from the genuine impulse response's complex
-- Laplace integral; it is equal to one throughout the feasible family.
theorem physical_hinf_eq_one (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} {w : ℝ × ℝ} (hw : w ∈ d.feasible X) :
    kernelHinf (d.kernel w) = 1 := by
  have hg : (0 : RealL1) ≤ d.kernelL1 w := by rw [d.kernelL1_eq]; exact hw.2
  have hn : ∀ᵐ t, 0 ≤ d.kernel w t := by
    filter_upwards [(Lp.coeFn_nonneg _).mpr hg, d.kernelL1_coe_full w] with t ht he
    rwa [← he]
  have hc : Causal (d.kernel w) := by
    filter_upwards [d.kernelL1_causal w, d.kernelL1_coe_full w] with t ht he hneg
    rw [← he]
    exact ht hneg
  have hm : (∫ t, d.kernel w t) = 1 := by
    rw [← integral_congr_ae (d.kernelL1_coe_full w)]
    exact d.kernel_mass_l1 w
  exact positive_kernel_hinf_eq_one (d.kernel_integrable_full w) hc hn hm

-- Proposition 16: a true all-future settling-time optimum exists in the
-- actual physical family; no continuity assumption about settling time.
theorem physical_minimum_settlingTime_exists (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) (hne : (d.feasible X).Nonempty)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ w ∈ d.feasible X, 0 ≤ settlingTime (d.output w) ε ∧
      SettledBy (d.output w) ε (settlingTime (d.output w) ε) ∧
      ∀ z ∈ d.feasible X, settlingTime (d.output w) ε ≤ settlingTime (d.output z) ε := by
  simpa only [d.output_eq_l1KernelStep, feasible] using
    l1_kernel_minimum_settlingTime_exists hX d.kernelBase d.kernelDirections
      d.kernelDirections_injective (fun w _ => by
        rw [← d.kernelL1_eq]; exact d.kernel_mass_l1 w) hne hε

theorem physical_settlingTime_quasiconvex (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hconv : Convex ℝ X) {ε : ℝ} (hε : 0 < ε) :
    QuasiconvexOn ℝ (d.feasible X) (fun w => settlingTime (d.output w) ε) := by
  simpa only [d.output_eq_l1KernelStep, feasible] using
    l1_kernel_settlingTime_quasiconvex hconv d.kernelBase d.kernelDirections
      (fun w _ => by rw [← d.kernelL1_eq]; exact d.kernel_mass_l1 w) hε

-- A finite horizon test is exact for the physical all-future criterion.
theorem physical_settlingTime_le_iff (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} {w : ℝ × ℝ} (hw : w ∈ d.feasible X)
    {ε : ℝ} (hε : 0 < ε) {H : ℝ} (hH : 0 ≤ H) :
    settlingTime (d.output w) ε ≤ H ↔
      1-ε ≤ l1KernelStep d.kernelBase H +
        w.1*l1KernelStep (d.kernelDirections (1,0)) H +
        w.2*l1KernelStep (d.kernelDirections (0,1)) H := by
  rw [d.output_eq_l1KernelStep]
  exact l1_kernel_settlingTime_le_iff hw
    (by rw [← d.kernelL1_eq]; exact d.kernel_mass_l1 w) hε hH

end StablePIDFData
end Article14
end
/- END SOURCE: Article14.PhysicalFamilyOptimization -/

/- BEGIN SOURCE: Article14/PhysicalFamilyMoments.lean -/
section
                                           
                                     

/-!
# Actual moment and lexicographic performance of the stable physical family

All objectives in this file are Lebesgue integrals of the response selected by
`StablePIDFData.response`.  Kernel positivity supplies nonnegative tracking
error, and the physical state equations supply the moment formulas.  In
particular neither the ITAE formula nor injectivity of the objective pair is
assumed in the optimization theorem.
-/
namespace Article14
open MeasureTheory Filter Set MIACE
open PhysicalPlant PhysicalLaplace
open scoped Topology
variable {n : Type*} [Fintype n] [DecidableEq n]
namespace StablePIDFData

/-- Integral absolute tracking error of the actual zero-history step. -/
noncomputable def iae (d : StablePIDFData n) (w : ℝ × ℝ) : ℝ :=
  ∫ t, |d.error w t| ∂halfLine

/-- Integral time-weighted absolute tracking error of the same actual step. -/
noncomputable def itae (d : StablePIDFData n) (w : ℝ × ℝ) : ℝ :=
  ∫ t, t * |d.error w t| ∂halfLine

-- @article14 thm:delay-fastest/physical_family_IAE
/-- The positive impulse condition makes the actual IAE equal its mean. -/
theorem iae_eq_mean (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    d.iae w = meanTime d.Ti d.k d.Kp w.1 := by
  exact stable_step_positive_iae (d.response_dynamics w) d.Ti_pos.ne'
    d.k_pos.ne' d.Kp_pos.ne' d.L_nonneg (d.stable_weights w)
    d.equilibrium d.unit_output d.nonsingular hg

-- @article14 prop:delay-second-moment/physical_signed_time_error_formula
/-- The signed time-error identity already holds before any positivity
constraint is imposed. -/
theorem signed_time_error_eq_second_error_moment (d : StablePIDFData n) (w : ℝ × ℝ) :
    (∫ t, t * d.error w t ∂halfLine) =
      secondErrorMoment d.Kp (d.Kp / d.Ti) (d.Kp * d.Td) d.k d.gamma
        (meanTime d.Ti d.k d.Kp w.1) w.2 := by
  exact stable_step_first_error_moment (d.response_dynamics w) d.Ti_pos.ne'
    d.k_pos.ne' d.Kp_pos.ne' d.Tf_pos d.L_nonneg (d.stable_weights w)
    d.equilibrium d.unit_output d.nonsingular

-- @article14 prop:delay-second-moment/physical_signed_time_error_half_impulse_moment
theorem signed_time_error_eq_half_second_impulse_moment
    (d : StablePIDFData n) (w : ℝ × ℝ) :
    (∫ t, t * d.error w t ∂halfLine) =
      (1 / 2 : ℝ) * (∫ t, t ^ 2 * d.kernel w t ∂halfLine) := by
  rw [d.signed_time_error_eq_second_error_moment w, (d.kernel_moments w).2]
  ring

-- @article14 prop:delay-second-moment/physical_family_ITAE
/-- The physical ITAE is exactly half the physical second impulse moment. -/
theorem itae_eq_second_error_moment (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    d.itae w = secondErrorMoment d.Kp (d.Kp / d.Ti) (d.Kp * d.Td) d.k d.gamma
      (meanTime d.Ti d.k d.Kp w.1) w.2 := by
  exact stable_step_positive_itae (d.response_dynamics w) d.Ti_pos.ne'
    d.k_pos.ne' d.Kp_pos.ne' d.Tf_pos d.L_nonneg (d.stable_weights w)
    d.equilibrium d.unit_output d.nonsingular hg

-- @article14 prop:delay-second-moment/physical_ITAE_half_second_impulse_moment
theorem itae_eq_half_second_impulse_moment (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    d.itae w = (1 / 2 : ℝ) * (∫ t, t ^ 2 * d.kernel w t ∂halfLine) := by
  rw [d.itae_eq_second_error_moment w hg, (d.kernel_moments w).2]
  ring

-- @article14 prop:delay-second-moment/physical_family_strict_variance
theorem positive_kernel_strict_variance (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    (meanTime d.Ti d.k d.Kp w.1) ^ 2 <
      2 * secondErrorMoment d.Kp (d.Kp / d.Ti) (d.Kp * d.Td) d.k d.gamma
        (meanTime d.Ti d.k d.Kp w.1) w.2 := by
  have hfirst : Integrable (fun t => t * d.kernel w t) halfLine := by
    simpa only [pow_one] using d.kernel_weight_integrable w 1
  have hh := kernel_variance_pos (d.kernel_integrable w) hfirst
    (d.kernel_weight_integrable w 2) hg (d.kernel_mass w)
  rwa [(d.kernel_moments w).1, (d.kernel_moments w).2] at hh

-- @article14 prop:delay-second-moment/strict_bound_between_actual_performance_integrals
theorem iae_sq_lt_twice_itae (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    (d.iae w) ^ 2 < 2 * d.itae w := by
  rw [d.iae_eq_mean w hg, d.itae_eq_second_error_moment w hg]
  exact d.positive_kernel_strict_variance w hg

-- @article14 prop:delay-second-moment/physical_family_derivative_weight_bound
theorem positive_kernel_strict_c_bound (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    1 + ((d.Kp / d.Ti) * (meanTime d.Ti d.k d.Kp w.1)^2 / 2 -
      (d.Kp + 1 / d.k) * meanTime d.Ti d.k d.Kp w.1 + d.gamma / d.k) /
        (d.Kp * d.Td) < w.2 := by
  exact stable_step_positive_variance_weight_bound (d.response_dynamics w)
    d.Ti_pos d.k_pos.ne' d.Kp_pos d.Td_pos d.Tf_pos d.L_nonneg
    (d.stable_weights w) d.equilibrium d.unit_output d.nonsingular hg

-- @article14 thm:delay-fastest/physical_family_strict_delay_bound
theorem positive_kernel_mean_gt_delay (d : StablePIDFData n) (w : ℝ × ℝ)
    (hg : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    d.L < meanTime d.Ti d.k d.Kp w.1 := by
  exact stable_step_positive_mean_gt_delay (d.response_dynamics w) d.Ti_pos.ne'
    d.k_pos.ne' d.Kp_pos.ne' d.Tf_pos d.L_nonneg (d.stable_weights w)
    d.equilibrium d.unit_output d.nonsingular hg

-- @article14 thm:delay-fastest/physical_IAE_order_is_reversed_b_order
theorem iae_le_iff (d : StablePIDFData n) {w z : ℝ × ℝ}
    (hw : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t)
    (hz : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel z t) :
    d.iae w ≤ d.iae z ↔ z.1 ≤ w.1 := by
  rw [d.iae_eq_mean w hw, d.iae_eq_mean z hz]
  unfold meanTime
  rw [mul_le_mul_iff_right₀ d.Ti_pos]
  constructor <;> intro h <;> linarith

-- @article14 prop:delay-second-moment/physical_ITAE_order_on_fixed_b
theorem itae_le_iff_of_same_b (d : StablePIDFData n) {w z : ℝ × ℝ}
    (hw : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t)
    (hz : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel z t) (hb : w.1 = z.1) :
    d.itae w ≤ d.itae z ↔ w.2 ≤ z.2 := by
  rw [d.itae_eq_second_error_moment w hw, d.itae_eq_second_error_moment z hz, hb]
  exact (secondErrorMoment_strictMono d.Kp (d.Kp / d.Ti) (d.Kp * d.Td) d.k d.gamma
    (meanTime d.Ti d.k d.Kp z.1) (div_pos d.Kp_pos d.Ti_pos)
    (mul_pos d.Kp_pos d.Td_pos)).le_iff_le

-- @article14 prop:delay-second-moment/actual_objective_pair_identifies_weights
theorem weights_eq_of_iae_itae (d : StablePIDFData n) {w z : ℝ × ℝ}
    (hw : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t)
    (hz : ∀ᵐ t ∂halfLine, 0 ≤ d.kernel z t)
    (hiae : d.iae w = d.iae z) (hitae : d.itae w = d.itae z) : w = z := by
  have hb : w.1 = z.1 := le_antisymm
    ((d.iae_le_iff hz hw).mp hiae.ge) ((d.iae_le_iff hw hz).mp hiae.le)
  apply Prod.ext hb
  exact le_antisymm ((d.itae_le_iff_of_same_b hw hz hb).mp hitae.le)
    ((d.itae_le_iff_of_same_b hz hw hb.symm).mp hitae.ge)

-- @article14 prop:delay-second-moment/actual_lexicographic_optimality
/-- The unique largest-b/smallest-c choice is the unique lexicographic
minimizer of the two actual physical performance integrals.  This assembly
works for any compact positive-kernel engineering set. -/
theorem lexicographic_performance_optimizer (d : StablePIDFData n)
    {F : Set (ℝ × ℝ)} (hF : IsCompact F) (hne : F.Nonempty)
    (hpositive : ∀ w ∈ F, ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    ∃ w ∈ F,
      (∀ z ∈ F, d.iae w ≤ d.iae z) ∧
      (∀ z ∈ F, d.iae z = d.iae w → d.itae w ≤ d.itae z) ∧
      (∀ z ∈ F, d.iae z = d.iae w → d.itae z = d.itae w → z = w) := by
  obtain ⟨w, hw, hbmax, hcmin, _⟩ := lexicographic_weights_exist hF hne
  refine ⟨w, hw, ?_, ?_, ?_⟩
  · intro z hz
    exact (d.iae_le_iff (hpositive w hw) (hpositive z hz)).mpr (hbmax z hz)
  · intro z hz he
    have hb : z.1 = w.1 := meanTime_injective d.Ti d.k d.Kp d.Ti_pos.ne' (by
      simpa only [d.iae_eq_mean z (hpositive z hz), d.iae_eq_mean w (hpositive w hw)] using he)
    exact (d.itae_le_iff_of_same_b (hpositive w hw) (hpositive z hz) hb.symm).mpr
      (hcmin z hz hb)
  · intro z hz he hte
    exact d.weights_eq_of_iae_itae (hpositive z hz) (hpositive w hw) he hte

-- @article14 prop:delay-second-moment/unique_actual_lexicographic_optimizer
/-- Uniqueness is for the actual IAE/ITAE optimization problem, not merely
for a separately specified pair of algebraic coordinates. -/
theorem unique_lexicographic_performance_optimizer (d : StablePIDFData n)
    {F : Set (ℝ × ℝ)} (hF : IsCompact F) (hne : F.Nonempty)
    (hpositive : ∀ w ∈ F, ∀ᵐ t ∂halfLine, 0 ≤ d.kernel w t) :
    ∃! w, w ∈ F ∧
      (∀ z ∈ F, d.iae w ≤ d.iae z) ∧
      (∀ z ∈ F, d.iae z = d.iae w → d.itae w ≤ d.itae z) := by
  obtain ⟨w, hw, hmin, hsecondary, huniq⟩ :=
    d.lexicographic_performance_optimizer hF hne hpositive
  refine ⟨w, ⟨hw, hmin, hsecondary⟩, ?_⟩
  intro z hz
  have he : d.iae z = d.iae w := le_antisymm (hz.2.1 w hw) (hmin z hz.1)
  apply huniq z hz.1 he
  exact le_antisymm (hz.2.2 w hw he.symm) (hsecondary z hz.1 he)

-- @article14 thm:delay-fastest/physical_feasible_IAE_minimization_is_max_b
/-- The physical fastest-mean problem is exactly largest feasible b. -/
theorem feasible_minimum_iae_iff_maximum_b (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} {w : ℝ × ℝ} (hw : w ∈ d.feasible X) :
    (∀ z ∈ d.feasible X, d.iae w ≤ d.iae z) ↔
      (∀ z ∈ d.feasible X, z.1 ≤ w.1) := by
  constructor
  · intro h z hz
    exact (d.iae_le_iff (d.feasible_kernel_nonnegative hw)
      (d.feasible_kernel_nonnegative hz)).mp (h z hz)
  · intro h z hz
    exact (d.iae_le_iff (d.feasible_kernel_nonnegative hw)
      (d.feasible_kernel_nonnegative hz)).mpr (h z hz)

-- @article14 prop:delay-second-moment/physical_feasible_unique_lexicographic_optimizer
/-- The complete physical version of Proposition 15: only the static stable
PIDF data, a closed engineering set, and nonempty feasibility are inputs.
Existence, compactness, and both objective identities have already been proved. -/
theorem feasible_unique_lexicographic_performance_optimizer (d : StablePIDFData n)
    {X : Set (ℝ × ℝ)} (hX : IsClosed X) (hne : (d.feasible X).Nonempty) :
    ∃! w, w ∈ d.feasible X ∧
      (∀ z ∈ d.feasible X, d.iae w ≤ d.iae z) ∧
      (∀ z ∈ d.feasible X, d.iae z = d.iae w → d.itae w ≤ d.itae z) := by
  exact d.unique_lexicographic_performance_optimizer (d.feasible_compact hX) hne
    (fun _ hw => d.feasible_kernel_nonnegative hw)

end StablePIDFData
end Article14
end
