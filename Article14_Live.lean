-- @paper-step thm:pid_two_rate_optimum/assembled_transfer_spectral_optimum
theorem twoRate_transfer_optimum {α ρ ell l m δ : ℝ} (hα : 0 < α)
    (h : TwoRateData ((1+1/α)/(1+δ)) ρ ell l m δ) :
    let i := (1+1/α)/(1+δ)
    ∃ e v : RealL1,
      TwoRateRenewalPair h e v ∧ 0 ≤ e ∧ 0 ≤ v ∧
      TransferResponse e v (fun p => 1/(1+p)) δ ∧
      (∀ p : ℝ, 0<p → 1/p+laplace v p=
        (i*(1+ell-ρ)+i/p+i*(ell-ρ)*(1-ρ)*p/(1+ρ*p))*laplace e p) ∧
      absArea e halfLine=α*(1+δ)/(1+α) ∧
      absArea v halfLine=(1+δ)/(1+α) ∧
      miace α e v halfLine=(1+δ)*minimum α ∧
      (∃ η : ℝ, 0<η ∧ η≤1/2 ∧ Integrable (expWeight η e) volume ∧ Integrable (expWeight η v) volume) ∧
      (∃ η : ℝ, 0<η ∧ η≤1/2 ∧ ∀ p : ℂ, -η≤p.re →
        (pidStateSymbol (i*(1+ell-ρ)) i (i*(ell-ρ)*(1-ρ)) ρ δ p).det ≠ 0) ∧
      (∀ e' v' : ℝ → ℝ, TransferResponse e' v' (fun p => 1/(1+p)) δ →
        miace α e v halfLine ≤ miace α e' v' halfLine) := by
  dsimp only
  obtain ⟨e,v,hs,hen,hvn,hplant,hcontroller,heint,hvint,hw⟩ := twoRate_closed_loop_exists h
  have hearea : absArea e halfLine=α*(1+δ)/(1+α) := by
    rw [← causal_absArea hs.error_causal,positive_l1_area _ hen,heint,(pid_optimal_gain hα h.delay_nonneg).2]
  have hvarea : absArea v halfLine=(1+δ)/(1+α) := by
    rw [← causal_absArea hs.command_causal,positive_l1_area _ hvn,hvint,(pid_optimal_gain hα h.delay_nonneg).2]
    field_simp
    <;> ring
  have hb := transfer_signed_balance hplant 1 firstOrder_transfer_dc (by norm_num)
  have hcost : miace α e v halfLine=(1+δ)*minimum α := by
    apply (signal_miace_equality_iff hplant.error_integrable hplant.command_integrable
      α (1+δ) hα (by linarith [h.delay_nonneg]) hb).mpr
    refine ⟨?_,?_,?_⟩
    · exact ((Lp.coeFn_nonneg _).mpr hen).filter_mono (ae_mono Measure.restrict_le_self)
    · exact ((Lp.coeFn_nonneg _).mpr hvn).filter_mono (ae_mono Measure.restrict_le_self)
    · rw [hearea,hvarea]; ring
  refine ⟨e,v,hs,hen,hvn,hplant,hcontroller,hearea,hvarea,hcost,hw,twoRate_physical_spectrum h,?_⟩
  intro e' v' hc
  rw [hcost]
  exact signal_miace_lower_bound hc.error_integrable hc.command_integrable α (1+δ) hα
    (by linarith [h.delay_nonneg]) (transfer_signed_balance hc 1 firstOrder_transfer_dc (by norm_num))

