-- All hypotheses describe the actual ordinary zero-state cascade and its
-- transfer integrals. The crucial moment condition is a conclusion.
-- @paper-step thm:n_necessary/full_statement
theorem paper_cascade_necessary (N : ℕ) (σ : ℕ → ℝ) (x : ℕ → ℝ → ℝ)
    {v H : ℝ → ℝ} (δ α μ : ℝ) (hδ : 0 ≤ δ) (hα : 0 < α) (hS : 0 < μ+δ)
    (hσ : ∀ j ≤ N, 0 < σ j ∧ σ j ≤ 1) (hfirst : σ 0=1)
    (hx : ∀ j ≤ N, LagResponse (σ j) (x j) (x (j+1)))
    (hw : x 0=fun t => 1+v t)
    (h : TransferResponse (delayedError δ (fun t => 1-x (N+1) t)) v H δ)
    (hH : HasDerivAt H (-μ) 0) (h0 : H 0=1)
    (heq : miace α (delayedError δ (fun t => 1-x (N+1) t)) v halfLine =
      (μ+δ)*minimum α) :
    α > μ+δ-1 ∧ Integrable (fun t => Real.exp t*v t) halfLine ∧
      moment v ≤ 1 ∧ commandArea v < 1 := by
  have hg := paper_general_plant h α μ hα hS hH h0
  obtain ⟨he,hv,_⟩ := hg.2.2.2.2.1.mp heq
  have hxu := undelayed_error_nonnegative hδ he
  have hxy : ∀ t : ℝ, 0 ≤ t → x (N+1) t ≤ 1 := by
    apply lag_ae_upper_bound (hx N le_rfl)
    filter_upwards [hxu] with t ht
    linarith
  obtain ⟨hJ,hM⟩ := cascade_moment_necessary N σ x hσ hfirst hx hw h.command_integrable hv hxy
  have hU := area_lt_one_of_moment h.command_integrable hJ hv hM
  have ha : absArea v halfLine=commandArea v := by
    apply integral_congr_ae
    filter_upwards [hv] with t ht
    exact abs_of_nonneg ht
