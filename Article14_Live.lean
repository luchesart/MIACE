theorem halfLaplace_exp_bound {E : ℝ → ℝ} {C : ℝ}
    (hE : ∀ t, 0≤t → |E t|≤C*Real.exp (-t)) (p : ℂ) {t : ℝ} (ht : 0≤t) :
