theorem remainderTransform_zero (r : ℕ → ℝ) (n : ℕ) (δ : ℝ) :
    remainderTransform r n δ 0=compactMoment (remainderJ r n δ) δ 0 := by
  simp [remainderTransform,compactMoment]

-- @paper-step thm:n_construction/remainder_transform_first_moment
theorem remainderTransform_deriv_zero (r : ℕ → ℝ) (n : ℕ) (δ : ℝ) :
