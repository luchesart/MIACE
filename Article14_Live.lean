      hc.add hvp
    apply hi.congr
    exact ae_of_all _ (fun t => by ring)
  · unfold laplace
    simp_rw [mul_add,mul_one]
    rw [integral_add hc hvp]
    have hs := laplace_step p hp
    simpa only [laplace,mul_one] using congrArg (fun x => x+laplace v p) hs

-- @paper-step thm:pid_two_rate_optimum/actual_pointwise_PID_law
