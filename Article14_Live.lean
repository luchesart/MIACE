  have ht' : t∈Ici (0 : ℝ) := (show 0<t from ht0).le
  simp only [expWeight,causalize,indicator_of_mem ht'] at ht
  exact mul_left_cancel₀ (ne_of_gt (Real.exp_pos _)) ht

