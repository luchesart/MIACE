    (dc/ρ)*(laplace f p-laplace (lag ρ f) p)=_
  rw [hz.2,lag_laplace hf hρ hp.le]
  field_simp [ne_of_gt hρ,ne_of_gt hp,ne_of_gt (by positivity : 0<1+ρ*p)]
  <;> ring

