        (mul_le_mul_of_nonneg_left (Real.exp_le_exp.mpr (by nlinarith)) hC) ht0
      _ ≤ B t := by
        have hh := mul_le_mul_of_nonneg_left (linear_exp_bound hb ht0) hC
        dsimp [B]; nlinarith
  · apply Eventually.of_forall
    intro t q _
    convert (((hasDerivAt_id q).neg.mul_const (t : ℂ)).cexp).mul_const (E t : ℂ) using 1
    · rfl
    · dsimp; ring

-- @paper-step thm:delayed_optimum/analytic_laplace_on_extended_half_plane
theorem halfLaplace_analytic {E : ℝ → ℝ} (hc : Continuous E) {C : ℝ} (hC : 0≤C)
