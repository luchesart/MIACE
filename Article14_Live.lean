  rw [laplace_congr_ae (convOp_coe hK g)]
  exact causal_convolution_laplace hK (L1.integrable_coeFn g) hKc hgc hp

-- @paper-step thm:complete_robust/filter_convolution_commutation
theorem filterAction_convolution (F : IMCFilter) {f g : ℝ → ℝ}
    (hf : Integrable f) (hg : Integrable g) (hfc : Causal f) (hgc : Causal g) :
