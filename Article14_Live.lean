theorem remainder_hermite (r : ℕ → ℝ) (n : ℕ) (δ : ℝ)
    (hr : ∀ j≤n, r j≠0) (z : ℂ) (k : ℕ)
    (hk : k<((remainderB r n).map Complex.ofRealHom).rootMultiplicity z) :
    iteratedDeriv k (fun p : ℂ => (remainderI r δ n).eval₂ Complex.ofRealHom p) z=
      (-(δ : ℂ))^k*Complex.exp (-(δ : ℂ)*z) := by
