      -(z.2 : ℂ)*Complex.exp (-z.1*(z.2 : ℂ))*(J z.2 : ℂ)) := by
    fun_prop
  obtain ⟨C,hC⟩ := (isCompact_closedBall (x := p) (r := (1 : ℝ))).prod (isCompact_uIcc : IsCompact (uIcc (0 : ℝ) δ))
    |>.exists_bound_of_continuousOn hc.continuousOn
