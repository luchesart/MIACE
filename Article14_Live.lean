noncomputable def serialState (σ ξ : ℕ → ℝ) (u : ℝ → ℝ) : ℕ → ℝ → ℝ
  | 0 => u
  | n+1 => lagState (σ n) (ξ n) (serialState σ ξ u n)
noncomputable def serialImpulse (σ : ℕ → ℝ) : ℕ → ℝ → ℝ
  | 0 => lagKernel (σ 0)
  | n+1 => lagKernel (σ (n+1)) ⋆ serialImpulse σ n

def serialRatios (σ : ℕ → ℝ) (n : ℕ) : List ℝ :=
  ((List.range n).map (fun j => σ (j+1))).reverse

-- @paper-step thm:complete_attainment/finite_cascade_local_state_construction
theorem serialState_local {u : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (σ ξ : ℕ → ℝ) (n : ℕ) : LocallyIntegrable (serialState σ ξ u n) volume := by
  induction n with
  | zero => exact hu
  | succ n ih => exact (lagState_evolution ih (σ n) (ξ n)).1.locallyIntegrable

-- @paper-step thm:complete_attainment/finite_cascade_full_state_ODE
theorem serialState_evolution {u : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (σ ξ : ℕ → ℝ) (n : ℕ) :
    Continuous (serialState σ ξ u (n+1)) ∧
      LagEvolution (σ n) (ξ n) (serialState σ ξ u n) (serialState σ ξ u (n+1)) :=
  lagState_evolution (serialState_local hu σ ξ n) (σ n) (ξ n)

-- @paper-step thm:complete_attainment/ordinary_lag_input_linearity
theorem lag_add_local {u v : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (hv : LocallyIntegrable v volume) (σ t : ℝ) :
    lag σ (fun s => u s+v s) t=lag σ u t+lag σ v t := by
  have hui := (locally_integrable_interval hu 0 t).continuousOn_mul
    (by fun_prop : Continuous (fun s : ℝ => Real.exp (s/σ))).continuousOn
  have hvi := (locally_integrable_interval hv 0 t).continuousOn_mul
    (by fun_prop : Continuous (fun s : ℝ => Real.exp (s/σ))).continuousOn
  unfold lag
  simp_rw [mul_add]
  rw [intervalIntegral.integral_add hui hvi]
  ring

-- @paper-step thm:complete_attainment/initial_state_and_forced_state_split
theorem serialState_split {u : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (σ ξ : ℕ → ℝ) (n : ℕ) :
    serialState σ ξ u n=(fun t => serialState σ ξ (fun _ => 0) n t+ordinaryCascade σ u n t) := by
  induction n with
  | zero => funext t; simp [serialState,ordinaryCascade]
  | succ n ih =>
    funext t
    simp only [serialState,lagState,ih,ordinaryCascade]
    rw [lag_add_local (serialState_local (continuous_const.locallyIntegrable) σ ξ n)
      (ordinaryCascade_local hu σ n)]
    ring

-- @paper-step thm:complete_robust/normalized_cascade_impulse_identification
theorem serialImpulse_eq_cascade (σ : ℕ → ℝ) (hfirst : σ 0=1) (n : ℕ) :
    serialImpulse σ n=cascadeKernel (serialRatios σ n) := by
  induction n with
  | zero => simp [serialImpulse,serialRatios,cascadeKernel,hfirst,unitLagImpulse_eq_lagKernel]
  | succ n ih =>
    simp [serialImpulse,serialRatios,List.range_succ,List.map_append,List.reverse_append,cascadeKernel,ih,
      serialRatios]

-- @paper-step thm:complete_robust/finite_cascade_impulse_properties
theorem serialImpulse_properties (σ : ℕ → ℝ) (n : ℕ) (hσ : ∀ j≤n, 0<σ j) :
    Integrable (serialImpulse σ n) ∧ Causal (serialImpulse σ n) := by
  induction n with
  | zero => exact ⟨(lagKernel_properties (hσ 0 le_rfl)).1,(lagKernel_properties (hσ 0 le_rfl)).2.2.2⟩
