    apply integral_congr_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have ht' : t∈Ici (0 : ℝ) := (show 0<t from ht).le
    simp only [expWeight,causalize,indicator_of_mem ht']
    rw [← mul_assoc,← Real.exp_add]
    congr 2
