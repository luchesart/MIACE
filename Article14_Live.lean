namespace MIACE
open MeasureTheory Filter Set
open scoped Topology

noncomputable def cascadeTransfer (σ : ℕ → ℝ) : ℕ → ℝ → ℝ
  | 0 => fun _ => 1
  | n+1 => fun p => cascadeTransfer σ n p/(1+σ n*p)
noncomputable def cascadeMean (σ : ℕ → ℝ) (n : ℕ) : ℝ := ∑ j ∈ Finset.range n, σ j

-- @paper-step thm:complete_attainment/cascade_actual_DC_gain
theorem cascadeTransfer_zero (σ : ℕ → ℝ) (n : ℕ) : cascadeTransfer σ n 0=1 := by
  induction n with
  | zero => rfl
  | succ n ih => simp [cascadeTransfer,ih]

-- @paper-step thm:complete_attainment/cascade_actual_DC_derivative
theorem cascadeTransfer_derivative (σ : ℕ → ℝ) (n : ℕ) :
    HasDerivAt (cascadeTransfer σ n) (-cascadeMean σ n) 0 := by
  induction n with
  | zero => simpa [cascadeTransfer,cascadeMean] using hasDerivAt_const (0 : ℝ) (1 : ℝ)
  | succ n ih =>
    have hd := ih.div (((hasDerivAt_id (0 : ℝ)).const_mul (σ n)).const_add 1) (by norm_num)
    convert hd using 1
    · rfl
    · simp [cascadeTransfer_zero,cascadeMean,Finset.sum_range_succ]
      ring

-- @paper-step thm:complete_attainment/lag_transient_transform
theorem lag_transient_transform {σ p : ℝ} (hσ : 0<σ) (hp : 0≤p) :
    Integrable (fun t : ℝ => Real.exp (-t/σ)) halfLine ∧
      laplace (fun t : ℝ => Real.exp (-t/σ)) p=σ/(1+σ*p) := by
  have he : (fun t : ℝ => Real.exp (-t/σ)) =ᵐ[halfLine] (fun t => σ*lagKernel σ t) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    simp only [lagKernel,indicator_of_mem (show t∈Ioi (0 : ℝ) from ht)]
    have hx : -t/σ=(-1/σ)*t := by ring
    rw [hx]; field_simp
  refine ⟨(((lagKernel_properties hσ).1.const_mul σ).mono_measure Measure.restrict_le_self).congr he.symm,?_⟩
  rw [laplace_congr_halfLine he,laplace_smul,lagKernel_laplace hσ hp]
  ring

-- @paper-step thm:complete_attainment/lag_deficit_transform
theorem lag_deficit_transform {u : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (he : Integrable (fun t => 1-u t) halfLine) {σ p : ℝ} (hσ : 0<σ) (hp : 0≤p) :
    laplace (fun t => 1-lag σ u t) p=(σ+laplace (fun t => 1-u t) p)/(1+σ*p) := by
  have hexp := lag_transient_transform hσ hp
  have hf : (fun t => 1-lag σ u t)=(fun t => Real.exp (-t/σ)+lag σ (fun s => 1-u s) t) :=
    funext (lag_deficit hu hσ)
  rw [hf,laplace]
  simp_rw [mul_add]
  rw [integral_add (laplace_integrable hexp.1 hp)
    (laplace_integrable (lag_integrable he hσ) hp)]
  change laplace (fun t : ℝ => Real.exp (-t/σ)) p+laplace (lag σ (fun s => 1-u s)) p=_
  rw [hexp.2,lag_laplace he hσ hp]
  ring

-- @paper-step thm:complete_attainment/cascade_actual_step_transform
theorem ordinaryCascade_transform {v : ℝ → ℝ} (hv : Integrable v)
    (σ : ℕ → ℝ) (n : ℕ) (hσ : ∀ j<n, 0<σ j) {p : ℝ} (hp : 0<p) :
    1/p-laplace (fun t => 1-ordinaryCascade σ (fun s => 1+v s) n t) p=
