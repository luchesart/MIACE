-- @paper-step thm:complete_attainment/general_cascade_causal_input_kernel
theorem ordinaryCascade_kernel_input {u : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (σ : ℕ → ℝ) (n : ℕ) (hσ : ∀ j≤n, 0<σ j) :
