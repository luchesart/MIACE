    (remainderB r n).derivative.eval 0=∑ j∈Finset.range (n+1), 1/r j := by
  induction n with
  | zero => simp [remainderB]
  | succ n ih =>
    simp only [remainderB,derivative_mul,derivative_add,derivative_C,derivative_X,derivative_one,
      eval_add,eval_mul,eval_C,eval_X,eval_one,eval_zero,mul_zero,zero_mul,zero_add,mul_one,
      one_mul,remainderB_zero,ih,Finset.sum_range_succ]
    ring

-- @paper-step thm:n_construction/derived_integrator_and_exact_residue_denominator
theorem rationalCascade_integrator (r : ℕ → ℝ) (n : ℕ) (δ U : ℝ)
    (hr : ∀ j≤n, r j≠0) :
    (rationalCascadeQ r n δ U).eval 0=0 ∧
    (rationalCascadeQ r n δ U).derivative.eval 0=
      1+(∑ j∈Finset.range (n+1), 1/r j)+δ-U := by
  constructor
  · simp [rationalCascadeQ,remainderB_zero,remainderI_zero r n δ hr]
  · simp only [rationalCascadeQ,derivative_sub,derivative_mul,derivative_add,derivative_C,
      derivative_X,eval_sub,eval_add,eval_mul,eval_C,eval_X,eval_one,eval_zero,mul_zero,
      zero_mul,zero_add,mul_one,one_mul,remainderB_zero,remainderI_derivative_zero r n δ hr,
      remainderB_derivative_zero,rationalCascadeA,rationalCascadeC]
    ring

-- @paper-step thm:n_construction/no_cancellation_at_any_cascade_pole
theorem rationalCascade_no_pole_cancellation (r : ℕ → ℝ) (n : ℕ) (δ U : ℝ)
    (hr : ∀ j≤n, r j≠0) (z : ℂ) (hz : (remainderB r n).eval₂ Complex.ofRealHom z=0) :
    (rationalCascadeQ r n δ U).eval₂ Complex.ofRealHom z≠0 := by
  simp only [rationalCascadeQ,eval₂_sub,eval₂_mul,hz,zero_mul,zero_sub,
    remainder_at_root r n δ hr z hz]
  exact neg_ne_zero.mpr (Complex.exp_ne_zero _)

-- @paper-step thm:n_construction/complex_tail_transform_including_zero
theorem compactLaplace_tail {J : ℝ → ℝ} (hJ : Continuous J) (δ : ℝ) (p : ℂ) :
    p*compactLaplace (compactTail J δ) δ p+compactLaplace J δ p=
      (compactMoment J δ 0 : ℂ) := by
  have hc := compactTail_continuous hJ δ
  have ce : Continuous (fun t : ℝ => Complex.exp (-p*(t : ℂ))) := by fun_prop
  have hd : ∀ t : ℝ, HasDerivAt
      (fun s : ℝ => Complex.exp (-p*(s : ℂ))*(compactTail J δ s : ℂ))
      (-p*(Complex.exp (-p*(t : ℂ))*(compactTail J δ t : ℂ))-
        Complex.exp (-p*(t : ℂ))*(J t : ℂ)) t := by
    intro t
    convert ((((hasDerivAt_id t).ofReal_comp.const_mul (-p)).cexp).mul
      (compactTail_deriv hJ δ t).ofReal_comp) using 1
    · rfl
    · dsimp; push_cast; ring
  have hi₁ : IntervalIntegrable
      (fun t : ℝ => -p*(Complex.exp (-p*(t : ℂ))*(compactTail J δ t : ℂ))) volume 0 δ :=
    ((ce.mul (Complex.continuous_ofReal.comp hc)).const_mul _).intervalIntegrable 0 δ
  have hi₂ : IntervalIntegrable
      (fun t : ℝ => Complex.exp (-p*(t : ℂ))*(J t : ℂ)) volume 0 δ :=
    (ce.mul (Complex.continuous_ofReal.comp hJ)).intervalIntegrable 0 δ
  have he := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t) (hi₁.sub hi₂)
  rw [intervalIntegral.integral_sub hi₁ hi₂,intervalIntegral.integral_const_mul] at he
  simp only [compactTail,intervalIntegral.integral_same,Complex.ofReal_zero,mul_zero,
    Complex.exp_zero,one_mul,zero_sub] at he
  change -p*compactLaplace (compactTail J δ) δ p-compactLaplace J δ p= -((∫ t in 0..δ, J t : ℝ) : ℂ) at he
  simpa only [compactMoment,pow_zero,one_mul] using (show
    p*compactLaplace (compactTail J δ) δ p+compactLaplace J δ p=((∫ t in 0..δ, J t : ℝ) : ℂ) by
      linear_combination -he)

-- @paper-step thm:n_construction/characteristic_resolvent_in_tail_form
theorem rationalCascade_resolvent_tail (r : ℕ → ℝ) (n : ℕ) (δ U : ℝ) (p : ℂ) :
    (rationalCascadeA r n δ U : ℂ)*p+(rationalCascadeC r n δ : ℂ)+
      (-1 : ℂ)^(n+1)*compactLaplace (remainderJ r n δ) δ p=
    1+(rationalCascadeA r n δ U : ℂ)*p-
      (-1 : ℂ)^(n+1)*p*compactLaplace (compactTail (remainderJ r n δ) δ) δ p := by
  have he := compactLaplace_tail (remainderJ_continuous r n δ) δ p
