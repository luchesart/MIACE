    (s := Metric.ball p 1) (bound := fun _ => C) (Metric.ball_mem_nhds p (by norm_num))
    (Filter.Eventually.of_forall (fun q =>
      (by fun_prop : Continuous (fun t : ℝ => Complex.exp (-q*(t : ℂ))*(J t : ℂ))).aestronglyMeasurable))
    (by apply Continuous.intervalIntegrable; fun_prop)
    (by apply Continuous.aestronglyMeasurable; fun_prop) ?_
    (intervalIntegrable_const) ?_).2
  · apply ae_of_all
    intro t ht q hq
    exact hC (q,t) ⟨Metric.ball_subset_closedBall hq,uIoc_subset_uIcc ht⟩
  · apply ae_of_all
    intro t _ q _
    convert (((hasDerivAt_id q).neg.mul_const (t : ℂ)).cexp).mul_const (J t : ℂ)
      using 1
    · funext x; dsimp <;> ring_nf
    · dsimp <;> ring

-- @paper-step lem:n_remainder/entire_compact_transform
theorem compactLaplace_analytic {J : ℝ → ℝ} (hJ : Continuous J) (δ : ℝ) (p : ℂ) :
    AnalyticAt ℂ (compactLaplace J δ) p :=
  Differentiable.analyticAt (fun q => (compactLaplace_deriv hJ δ q).differentiableAt) p

-- @paper-step lem:n_remainder/complex_first_factor_remainder
theorem remainder_first_factor_complex (r : ℕ → ℝ) (δ : ℝ) (p : ℂ) (hr : r 0≠0) :
    Complex.exp (-p*(δ : ℂ))=(Real.exp (r 0*δ) : ℂ)-
      (1+p/(r 0 : ℂ))*compactLaplace (remainderJ r 0 δ) δ p := by
  have hd : ∀ t : ℝ, HasDerivAt
      (fun s : ℝ => Complex.exp (-p*(s : ℂ))*(Real.exp (r 0*(δ-s)) : ℂ))
      (-(1+p/(r 0 : ℂ))*(Complex.exp (-p*(t : ℂ))*(remainderJ r 0 δ t : ℂ))) t := by
    intro t
    have h₁ := ((((hasDerivAt_id t).ofReal_comp).const_mul (-p)).cexp)
    have h₂ := ((((hasDerivAt_id t).const_sub δ).const_mul (r 0)).exp).ofReal_comp
    convert h₁.mul h₂ using 1
    · rfl
    · dsimp [remainderJ,reverseImpulse,id_eq]
      push_cast
      have hr' : (r 0 : ℂ)≠0 := Complex.ofReal_ne_zero.mpr hr
      field_simp [hr']; ring
  have hf := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t)
    (a := 0) (b := δ)
    (by apply Continuous.intervalIntegrable; exact
      (((by fun_prop : Continuous (fun t : ℝ => Complex.exp (-p*(t : ℂ)))).mul
      (Complex.continuous_ofReal.comp (remainderJ_continuous r 0 δ))).const_mul _))
  rw [intervalIntegral.integral_const_mul] at hf
  simp only [Complex.ofReal_zero,mul_zero,sub_self,Real.exp_zero,Complex.ofReal_one,
    Complex.exp_zero,mul_one,sub_zero,one_mul] at hf
