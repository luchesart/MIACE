  obtain ⟨hVi,hVm⟩ := cascadeCommand_integral hc hδ
    (rationalCascadeA r n δ U) ((-1 : ℝ)^(n+1)) hi hm
  refine ⟨R,hR,hi,⟨η,C,hη,hC,hRw,hbound⟩,hRn,hm,hT,hVi,hVn,?_⟩
