-- @paper-step thm:complete_robust/concrete_zero_history_reference_feedback
theorem zeroHistory_reference_feedback (N : ℕ) (σ : ℕ → ℝ) (F : IMCFilter)
    {δ ε : ℝ} (hδ : 0≤δ) (hδε : 0≤δ+ε) (hσ : ∀ j≤N, 0<σ j) (hfirst : σ 0=1)
    {u : ℝ → ℝ} (hu : LocallyIntegrable u volume) (huc : Causal u) :
