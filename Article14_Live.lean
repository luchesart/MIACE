  apply (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := halfLine) (F := fun q t => Complex.exp (-q*(t : ℂ))*(E t : ℂ))
    (F' := fun q t => -(t : ℂ)*(Complex.exp (-q*(t : ℂ))*(E t : ℂ)))
    (s := Metric.ball p b) (bound := B) (Metric.ball_mem_nhds p hb)
    (Eventually.of_forall (fun q => by apply Continuous.aestronglyMeasurable; fun_prop))
    (halfLaplace_integrable hc hE hp)
    (by apply Continuous.aestronglyMeasurable; fun_prop) ?_ hB ?_).2
  · filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht q hq
    have ht0 : 0≤t := (show 0<t from ht).le
    have hqr : |q.re-p.re|≤‖q-p‖ := by simpa using Complex.abs_re_le_norm (q-p)
    have hdist : |q.re-p.re|<b := hqr.trans_lt (by simpa only [Metric.mem_ball,dist_eq_norm] using hq)
    have hqre : b≤q.re+1 := by dsimp [b] at *; linarith [(abs_lt.mp hdist).1]
    rw [norm_mul,norm_neg,Complex.norm_real,Real.norm_of_nonneg ht0]
    calc
      t*‖Complex.exp (-q*(t : ℂ))*(E t : ℂ)‖≤t*(C*Real.exp (-(q.re+1)*t)) :=
        mul_le_mul_of_nonneg_left (halfLaplace_exp_bound hE q ht0) ht0
