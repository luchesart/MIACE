  have hfg := hf.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hg
  have hfgc : Causal (f ⋆ g) := ae_of_all _ (convolution_causal hfc hgc)
  apply causal_laplace_ext (filterAction_integrable F hfg)
    ((filterAction_integrable F hf).integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hg)
    (filterAction_causal F hfgc)
    (ae_of_all _ (convolution_causal (filterAction_causal F hfc) hgc))
  intro p hp
  rw [filterAction_laplace F hfg hfgc hp.le,causal_convolution_laplace hf hg hfc hgc hp.le,
    causal_convolution_laplace (filterAction_integrable F hf) hg (filterAction_causal F hfc) hgc hp.le,
    filterAction_laplace F hf hfc hp.le]
  ring

-- @paper-step thm:complete_robust/filter_feedback_kernel_identity
theorem filterOp_convOp (F : IMCFilter) {K : ℝ → ℝ} (hK : Integrable K) (hKc : Causal K)
    {g : RealL1} (hgc : Causal g) :
    filterOp F (convOp hK g)=convOp (filterAction_integrable F hK) g := by
  apply Lp.ext
  exact (filterOp_coe F _).trans ((filterAction_congr F (convOp_coe hK g)).trans
    ((filterAction_convolution F hK (L1.integrable_coeFn g) hKc hgc).trans (convOp_coe _ g).symm))

