  have hz := laplace_zero_ae (hf.sub hg) (fun p hp => by
    unfold laplace
    simp_rw [Pi.sub_apply,mul_sub]
    rw [integral_sub (laplace_integrable (hf.mono_measure Measure.restrict_le_self) hp.le)
      (laplace_integrable (hg.mono_measure Measure.restrict_le_self) hp.le)]
    exact sub_eq_zero.mpr (he p hp))
  filter_upwards [hz] with t ht
  exact sub_eq_zero.mp ht

