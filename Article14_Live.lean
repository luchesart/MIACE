  have hi : Integrable (fun t : ℝ => Real.exp (-(x-1)*t)) halfLine :=
    integrableOn_exp_mul_Ioi (by linarith : -(x-1) < 0) 0
  refine ⟨?_,?_⟩
  · rw [weighted_expCommand]
    exact hi.const_mul (x-1)
  · unfold moment
    rw [weighted_expCommand,integral_const_mul]
    unfold halfLine
    rw [integral_exp_mul_Ioi (by linarith : -(x-1) < 0)]
    simp
    have hx0 : 1-x ≠ 0 := by linarith
    field_simp
    ring

