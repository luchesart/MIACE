        (oWeights Ti Td σ π).2 Δr state)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (Kp * π / (Ti * Tf) * Δr)) := by
  rw [← oAssigned_feedthrough Kp Ti Td Tf σ π Δr hi hd hf]
  exact oStepCommand_rightLimit output Kp Ti Td Tf _ _ Δr state hcontinuous hzero

-- @paper-step cor:jump-feasible/exact-absolute-jump-bound
theorem assigned_jump_limit_iff (Kp Ti Tf π Δr umax : ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hf : 0 < Tf)
    (hp : 0 ≤ π) (hr : Δr ≠ 0) :
    |Kp * π / (Ti * Tf) * Δr| ≤ umax ↔
      π ≤ umax * Ti * Tf / (Kp * |Δr|) := by
  have hden : 0 < Ti * Tf := mul_pos hi hf
  have habs : 0 < |Δr| := abs_pos.mpr hr
  rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ Kp * π / (Ti * Tf))]
  rw [le_div_iff₀ (mul_pos hk habs)]
  constructor
  · intro h
    have h' := (mul_le_mul_iff_right₀ hden).2 h
    have heq : (Ti * Tf) * (Kp * π / (Ti * Tf) * |Δr|) = π * (Kp * |Δr|) := by
      field_simp
    rw [heq] at h'
    nlinarith
  · intro h
    apply (mul_le_mul_iff_right₀ hden).1
    have heq : (Ti * Tf) * (Kp * π / (Ti * Tf) * |Δr|) = π * (Kp * |Δr|) := by
      field_simp
    rw [heq]
    nlinarith

-- @paper-step cor:jump-feasible/D-physical-jump-bound-equivalence
theorem dAssignedStepCommand_jump_bound_iff {X : Type*}
    [NormedAddCommGroup X] [NormedSpace ℝ X]
    (output : X →L[ℝ] ℝ) (Kp Ti Td Tf σ π Δr umax J : ℝ)
    (state : ℝ → X × ℝ × ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hd : 0 < Td) (hf : 0 < Tf)
    (hp : 0 ≤ π) (hr : Δr ≠ 0)
    (hcontinuous : ContinuousWithinAt state (Set.Ioi 0) 0) (hzero : state 0 = 0)
    (hJ : Filter.Tendsto
      (dStepCommand output Kp Ti Td Tf (dWeights Ti Td Tf σ π).1
        (dWeights Ti Td Tf σ π).2 Δr state)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds J)) :
    |J| ≤ umax ↔ π ≤ umax * Ti * Tf / (Kp * |Δr|) := by
  have hvalue : J = Kp * π / (Ti * Tf) * Δr :=
    tendsto_nhds_unique hJ
      (dAssignedStepCommand_rightLimit output Kp Ti Td Tf σ π Δr state
        hi.ne' hd.ne' hf.ne' hcontinuous hzero)
  rw [hvalue]
  exact assigned_jump_limit_iff Kp Ti Tf π Δr umax hk hi hf hp hr

-- @paper-step cor:jump-feasible/O-physical-jump-bound-equivalence
theorem oAssignedStepCommand_jump_bound_iff {X : Type*}
    [NormedAddCommGroup X] [NormedSpace ℝ X]
    (output : X →L[ℝ] ℝ) (Kp Ti Td Tf σ π Δr umax J : ℝ)
    (state : ℝ → X × ℝ × ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hd : 0 < Td) (hf : 0 < Tf)
    (hp : 0 ≤ π) (hr : Δr ≠ 0)
    (hcontinuous : ContinuousWithinAt state (Set.Ioi 0) 0) (hzero : state 0 = 0)
    (hJ : Filter.Tendsto
      (oStepCommand output Kp Ti Td Tf (oWeights Ti Td σ π).1
        (oWeights Ti Td σ π).2 Δr state)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds J)) :
    |J| ≤ umax ↔ π ≤ umax * Ti * Tf / (Kp * |Δr|) := by
  have hvalue : J = Kp * π / (Ti * Tf) * Δr :=
    tendsto_nhds_unique hJ
      (oAssignedStepCommand_rightLimit output Kp Ti Td Tf σ π Δr state
        hi.ne' hd.ne' hf.ne' hcontinuous hzero)
  rw [hvalue]
  exact assigned_jump_limit_iff Kp Ti Tf π Δr umax hk hi hf hp hr

-- @paper-step cor:damping-floor/nonnegative-proportional-weight
theorem dAssignment_nonnegative_b_frequency_bound
    (Ti Tf ζ ω : ℝ) (hi : 0 < Ti) (hf : 0 < Tf) (hw : 0 < ω)
    (hb : 0 ≤ (2 * ζ / ω - Tf) / Ti) :
    ω ≤ 2 * ζ / Tf := by
  have h : 0 ≤ 2 * ζ / ω - Tf := by
    simpa using (le_div_iff₀ hi).1 hb
  have h' : Tf ≤ 2 * ζ / ω := by linarith
  have h'' := (le_div_iff₀ hw).1 h'
  apply (le_div_iff₀ hf).2
  nlinarith

-- @paper-step cor:damping-floor/frequency-lower-endpoint
theorem assigned_jump_frequency_lower_bound (Kp Ti Tf Δr umax ω : ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hf : 0 < Tf)
    (hr : Δr ≠ 0) (hu : 0 < umax) (hw : 0 < ω)
    (hjump : 1 / ω ^ 2 ≤ umax * Ti * Tf / (Kp * |Δr|)) :
    Real.sqrt (Kp * |Δr| / (umax * Ti * Tf)) ≤ ω := by
  have ha : 0 < Kp * |Δr| := mul_pos hk (abs_pos.mpr hr)
  have hu' : 0 < umax * Ti * Tf := by positivity
  have hw' : 0 < ω ^ 2 := sq_pos_of_pos hw
  have h1 := (div_le_div_iff₀ hw' ha).1 hjump
  have h2 : Kp * |Δr| / (umax * Ti * Tf) ≤ ω ^ 2 := by
    apply (div_le_iff₀ hu').2
    nlinarith
  exact (Real.sqrt_le_iff).2 ⟨hw.le, h2⟩

-- @paper-step cor:damping-floor/damping-lower-bound
theorem damping_floor_from_frequency_interval (Kp Ti Tf Δr umax ζ ω : ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hf : 0 < Tf)
    (hr : Δr ≠ 0) (hu : 0 < umax) (hw : 0 < ω)
    (hlo : Real.sqrt (Kp * |Δr| / (umax * Ti * Tf)) ≤ ω)
    (hup : ω ≤ 2 * ζ / Tf) :
    (1 / 2 : ℝ) * Real.sqrt (Kp * |Δr| * Tf / (umax * Ti)) ≤ ζ := by
  have hz : 0 < ζ := by
    have h := (le_div_iff₀ hf).1 hup
    nlinarith [mul_pos hw hf]
  have hA : 0 ≤ Kp * |Δr| / (umax * Ti * Tf) := by positivity
  have hsq := Real.sq_sqrt hA
  have hsnon := Real.sqrt_nonneg (Kp * |Δr| / (umax * Ti * Tf))
  have h1 : Tf * Real.sqrt (Kp * |Δr| / (umax * Ti * Tf)) ≤ 2 * ζ := by
    have h := (le_div_iff₀ hf).1 hup
    nlinarith
  have heq : Tf ^ 2 * (Kp * |Δr| / (umax * Ti * Tf)) =
      Kp * |Δr| * Tf / (umax * Ti) := by
    field_simp
  have h2 : Kp * |Δr| * Tf / (umax * Ti) ≤ (2 * ζ) ^ 2 := by
    rw [← heq, ← hsq]
    have hh := mul_self_le_mul_self (by positivity : 0 ≤ Tf *
      Real.sqrt (Kp * |Δr| / (umax * Ti * Tf))) h1
    nlinarith only [hh]
  have h3 : Real.sqrt (Kp * |Δr| * Tf / (umax * Ti)) ≤ 2 * ζ :=
    (Real.sqrt_le_iff).2 ⟨by positivity, h2⟩
  linarith

-- @paper-step cor:damping-floor/physical-command-consequence
theorem dAssignedStepCommand_damping_floor {X : Type*}
    [NormedAddCommGroup X] [NormedSpace ℝ X]
    (output : X →L[ℝ] ℝ) (Kp Ti Td Tf ζ ω Δr umax J : ℝ)
    (state : ℝ → X × ℝ × ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hd : 0 < Td) (hf : 0 < Tf)
    (hr : Δr ≠ 0) (hu : 0 < umax) (hw : 0 < ω)
    (hcontinuous : ContinuousWithinAt state (Set.Ioi 0) 0) (hzero : state 0 = 0)
    (hJ : Filter.Tendsto
      (dStepCommand output Kp Ti Td Tf (dWeights Ti Td Tf (2 * ζ / ω) (1 / ω ^ 2)).1
        (dWeights Ti Td Tf (2 * ζ / ω) (1 / ω ^ 2)).2 Δr state)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds J))
    (hbound : |J| ≤ umax)
    (hb : 0 ≤ (dWeights Ti Td Tf (2 * ζ / ω) (1 / ω ^ 2)).1) :
    Real.sqrt (Kp * |Δr| / (umax * Ti * Tf)) ≤ ω ∧
      ω ≤ 2 * ζ / Tf ∧
      (1 / 2 : ℝ) * Real.sqrt (Kp * |Δr| * Tf / (umax * Ti)) ≤ ζ := by
  have hjump := (dAssignedStepCommand_jump_bound_iff output Kp Ti Td Tf
    (2 * ζ / ω) (1 / ω ^ 2) Δr umax J state hk hi hd hf
    (by positivity) hr hcontinuous hzero hJ).1 hbound
  have hlo := assigned_jump_frequency_lower_bound Kp Ti Tf Δr umax ω hk hi hf hr hu hw hjump
  have hup := dAssignment_nonnegative_b_frequency_bound Ti Tf ζ ω hi hf hw hb
  exact ⟨hlo, hup, damping_floor_from_frequency_interval
    Kp Ti Tf Δr umax ζ ω hk hi hf hr hu hw hlo hup⟩

-- @paper-step cor:damping-floor/sharpness-witness-for-nonnegative-weights
/-- The explicit witness at the common frequency endpoint.  The extra condition
`Tf * ω / 2 < 1` makes this positive-damping quadratic a complex target. -/
theorem damping_floor_sharp_witness (Kp Ti Td Tf Δr umax ω : ℝ)
    (hk : 0 < Kp) (hi : 0 < Ti) (hd : 0 < Td) (hf : 0 < Tf)
    (_hr : Δr ≠ 0) (hu : 0 < umax) (hw : 0 < ω)
    (hω : ω ^ 2 = Kp * |Δr| / (umax * Ti * Tf)) :
    0 < 1 / (Ti * Td * ω ^ 2) ∧
      dCoefficients Ti Td Tf 0 (1 / (Ti * Td * ω ^ 2)) =
        (2 * (Tf * ω / 2) / ω, 1 / ω ^ 2) ∧
      |Kp * (1 / ω ^ 2) / (Ti * Tf) * Δr| = umax := by
  have hw0 : ω ≠ 0 := hw.ne'
  have hi0 : Ti ≠ 0 := hi.ne'
  have hd0 : Td ≠ 0 := hd.ne'
  have hf0 : Tf ≠ 0 := hf.ne'
  have hu0 : umax ≠ 0 := hu.ne'
  refine ⟨by positivity, ?_, ?_⟩
  · apply Prod.ext <;> dsimp [dCoefficients]
    · field_simp
      ring
    · field_simp
      ring
  · rw [abs_mul, abs_of_nonneg (by positivity : 0 ≤ Kp * (1 / ω ^ 2) / (Ti * Tf))]
    have hh := (eq_div_iff (by positivity : umax * Ti * Tf ≠ 0)).1 hω
    field_simp
    nlinarith

-- @paper-step cor:damping-floor/sharp-witness-attains-the-square-root-floor
theorem sharp_witness_damping_eq_floor (Kp Ti Tf Δr umax ω : ℝ)
    (hi : 0 < Ti) (hf : 0 < Tf) (hu : 0 < umax) (hw : 0 < ω)
    (hω : ω ^ 2 = Kp * |Δr| / (umax * Ti * Tf)) :
    Tf * ω / 2 = (1 / 2 : ℝ) * Real.sqrt (Kp * |Δr| * Tf / (umax * Ti)) := by
  have heq : Kp * |Δr| * Tf / (umax * Ti) = (Tf * ω) ^ 2 := by
    have hh := (eq_div_iff (by positivity : umax * Ti * Tf ≠ 0)).1 hω
    apply (div_eq_iff (by positivity : umax * Ti ≠ 0)).2
    have hh' := congrArg (fun z : ℝ => z * Tf) hh
    nlinarith only [hh']
  rw [heq, Real.sqrt_sq_eq_abs, abs_of_pos (mul_pos hf hw)]
  ring

-- @paper-step cor:damping-floor/sharp-witness-is-complex-below-unit-damping
theorem sharp_witness_complex (Tf ω : ℝ) (hf : 0 < Tf) (hw : 0 < ω)
    (hz : Tf * ω / 2 < 1) :
    0 < Tf * ω / 2 ∧ (2 * (Tf * ω / 2) / ω) ^ 2 < 4 * (1 / ω ^ 2) := by
  constructor
  · positivity
  · have hz0 : 0 < Tf * ω / 2 := by positivity
    have hsq : (Tf * ω / 2) ^ 2 < 1 := by nlinarith
    have hi : (2 * (Tf * ω / 2) / ω) ^ 2 * ω ^ 2 = 4 * (Tf * ω / 2) ^ 2 := by
      field_simp
      ring
    have hrhs : 4 * (1 / ω ^ 2) * ω ^ 2 = 4 := by field_simp
    apply (mul_lt_mul_iff_left₀ (by positivity : 0 < ω ^ 2)).1
    nlinarith only [hi, hrhs, hsq]

end Article14
