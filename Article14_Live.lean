  let A := twoRateA ρ l m
  have hA := twoRateA_ge_one h.ordered_rates h.filter_lower
  have hn : ∀ᵐ t, 0≤twoRateK A l m δ t := ae_of_all _
    (twoRateK_nonneg hA h.lower_rate h.ordered_rates.le
      (twoRate_rate_condition h.ordered_rates h.filter_upper))
  have hq := twoRateK_small hA h.ordered_rates.le h.delay_nonneg
  refine ⟨by rw [positive_kernel_mass hn]; exact hq,?_⟩
  obtain ⟨η,hη,hle,hw,hqw⟩ := expWeight_small_mass (twoRateK_integrable A l m δ) hq
    (by norm_num : (0 : ℝ)<1/2) (twoRateK_weighted A l m δ (1/2))
  obtain ⟨C,hC,hb⟩ := twoRateK_weighted_bound A l m δ η
  refine ⟨η,C,hη,hle,hC,hw,?_,hb⟩
  rw [positive_kernel_mass (show ∀ᵐ t, 0≤expWeight η (twoRateK A l m δ) t from by
    filter_upwards [hn] with t ht; exact mul_nonneg (Real.exp_nonneg _) ht)]
  exact hqw

-- @paper-step thm:pid_two_rate_optimum/signed_two_rate_ordinary_regularity
theorem twoRate_signed_regularity {f : ℝ → ℝ} (hf : Integrable (causalize f))
    (hfc : Continuous f) (A l m : ℝ) {δ : ℝ} (hδ : 0≤δ) :
    Continuous (signedRenewalRep (twoRateK_integrable A l m δ) hf) := by
  exact hfc.add (twoRateK_convolution_continuous (L1.integrable_coeFn _) A l m hδ)

end MIACE
