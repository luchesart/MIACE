  have hu : LocallyIntegrable (fun t => 1+v t) volume :=
    (continuous_const : Continuous (fun _ : ℝ => (1 : ℝ))).locallyIntegrable.add hv.locallyIntegrable
  have he : Integrable (fun t => 1-(1+v t)) halfLine := by
    convert (hv.mono_measure Measure.restrict_le_self).neg using 1
    ext t; simp
  induction n with
  | zero =>
    have heq : (fun t => 1-ordinaryCascade σ (fun s => 1+v s) 0 t)=(fun t => (-1)*v t) := by
      ext t; simp [ordinaryCascade]
    rw [heq,laplace_smul,cascadeTransfer]
    ring
