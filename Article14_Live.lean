    have hp := lagKernel_properties (hσ (n+1) le_rfl)
    have hh := ih (fun j hj => hσ j (by omega))
    exact ⟨hp.1.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hh.1,
      ae_of_all _ (convolution_causal hp.2.2.2 hh.2)⟩

-- @paper-step thm:complete_attainment/zero_initial_lag_state
