  exact ⟨fun a ha ha1 hq => paper_exponential_delay_robust N σ hδ hδε hα ha ha1 hσ hfirst hq,
    fun c T hc hT hJ hq => paper_pulse_delay_robust N σ hδ hδε hα hc hT hJ hσ hfirst hq⟩

