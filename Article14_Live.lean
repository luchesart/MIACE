    rw [div_mul_eq_mul_div]
    apply (le_div_iff₀ hb).mpr
    linarith
  calc
    t*Real.exp (-b*t)≤((2/b)*Real.exp ((b/2)*t))*Real.exp (-b*t) :=
      mul_le_mul_of_nonneg_right ht' (Real.exp_nonneg _)
    _ = (2/b)*Real.exp (-(b/2)*t) := by
      rw [mul_assoc,← Real.exp_add]
      congr 2; ring

