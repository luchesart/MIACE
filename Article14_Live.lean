    (by exact (Differentiable.analyticAt (fun p => B.differentiableAt) z).contDiffAt : ContDiffAt ℂ k (fun p => B.eval p) z).mul hH.contDiffAt
  have hh := congrArg (fun f : ℂ → ℂ => iteratedDeriv k f z) he
  rw [iteratedDeriv_fun_add hi hb,hz,add_zero,iteratedDeriv_cexp_const_mul] at hh
  simpa only [I,eval_map] using hh.symm

-- @paper-step lem:n_remainder/interpolation_at_every_root
theorem remainder_at_root (r : ℕ → ℝ) (n : ℕ) (δ : ℝ)
    (hr : ∀ j≤n, r j≠0) (z : ℂ)
