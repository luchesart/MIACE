  change HasDerivAt (fun p => ∫ t in 0..δ, Real.exp (-p*t)*remainderJ r n δ t) _ 0
  simpa only [compactLaplace_real,Complex.ofReal_re,compactExpMoment] using hd

-- @paper-step thm:n_construction/interpolant_dc_from_exact_remainder
theorem remainderI_zero (r : ℕ → ℝ) (n : ℕ) (δ : ℝ) (hr : ∀ j≤n, r j≠0) :
    (remainderI r δ n).eval 0=rationalCascadeC r n δ := by
  have he := exact_delay_remainder_real r n δ 0 hr
  rw [remainderB_zero,remainderTransform_zero] at he
  simp only [mul_zero,Real.exp_zero,mul_one] at he
  unfold rationalCascadeC
  linarith

-- @paper-step thm:n_construction/interpolant_dc_derivative_from_first_moment
theorem remainderI_derivative_zero (r : ℕ → ℝ) (n : ℕ) (δ : ℝ)
    (hr : ∀ j≤n, r j≠0) :
    (remainderI r δ n).derivative.eval 0= -δ-
      (-1 : ℝ)^(n+1)*(remainderB r n).derivative.eval 0*compactMoment (remainderJ r n δ) δ 0+
      (-1 : ℝ)^(n+1)*compactMoment (remainderJ r n δ) δ 1 := by
  have he : (fun p : ℝ => Real.exp (-δ*p))=(fun p => (remainderI r δ n).eval p+
