section
                              
                                 

/-! Ordinary representatives of the inverse of R. The differential
equation and initial value are derived from the actual Laplace identity. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

structure CompactResolventEvolution (J : ℝ → ℝ) (δ a c ε : ℝ) (R : ℝ → ℝ) : Prop where
  continuous : Continuous R
  ac : ∀ u v, AbsolutelyContinuousOnInterval R u v
  initial : R 0=1/a
  ode : ∀ᵐ t, 0<t → HasDerivAt R
    (-(c/a)*R t-(ε/a)*(compactKernel J δ ⋆ causalize R) t) t

-- @paper-step thm:n_construction/actual_ordinary_compact_resolvent_equation
theorem compact_resolvent_realization {J : ℝ → ℝ} (hc : Continuous J)
    {δ a c ε : ℝ} (hδ : 0≤δ) (ha : 0<a) (r : RealL1) (hrc : Causal r)
    (htrans : ∀ p : ℝ, 0<p →
      (a*p+c+ε*compactExpMoment J δ (-p))*laplace r p=1) :
    ∃ R : ℝ → ℝ, CompactResolventEvolution J δ a c ε R ∧
      (r : ℝ → ℝ)=ᵐ[volume] causalize R := by
  let H := compactKernel J δ
  let f := fun t => -(c/a)*r t-(ε/a)*(H ⋆ (r : ℝ → ℝ)) t
  have hJ := compactKernel_integrable hc δ
  have hri := L1.integrable_coeFn r
  have hconv := hJ.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hri
  have hfi : Integrable f := (hri.const_mul (-(c/a))).sub (hconv.const_mul (ε/a))
  have hftrans (p : ℝ) (hp : 0<p) : p*laplace r p=1/a+laplace f p := by
    have he : f=(fun t => (-(c/a))*r t+(-(ε/a))*(H ⋆ (r : ℝ → ℝ)) t) := by
      funext t; dsimp [f]; ring
    rw [he,laplace_linear hri hconv (-(c/a)) (-(ε/a)) hp.le,causal_convolution_laplace hJ hri (compactKernel_causal J δ) hrc hp.le,
      compactKernel_laplace J hδ]
    have h := htrans p hp
    have ha0 := ne_of_gt ha
    field_simp
    nlinarith [h]
  let R := integratedState (1/a) f
  have he : (r : ℝ → ℝ)=ᵐ[volume] causalize R :=
    integratedState_identification hri hrc hfi (1/a) hftrans
  obtain ⟨hRc,hR0,hRac,hRd⟩ := integratedState_regular (1/a) hfi
  refine ⟨R,⟨hRc,hRac,hR0,?_⟩,he⟩
  have hce := convolution_congr (ContinuousLinearMap.lsmul ℝ ℝ)
    (EventuallyEq.rfl (f := H)) he
  filter_upwards [hRd,he] with t hd ht ht0
  change HasDerivAt R (-(c/a)*r t-(ε/a)*(H ⋆ (r : ℝ → ℝ)) t) t at hd
  rw [ht,hce] at hd
  simpa only [causalize,indicator_of_mem (show t∈Ici (0 : ℝ) from ht0.le)] using hd

-- @paper-step thm:n_construction/ordinary_nonnegativity_from_positive_series
theorem compact_resolvent_nonneg {J : ℝ → ℝ} {δ a c ε : ℝ} {r : RealL1}
    {R : ℝ → ℝ} (h : CompactResolventEvolution J δ a c ε R)
    (hr : 0≤r) (he : (r : ℝ → ℝ)=ᵐ[volume] causalize R) :
    ∀ t, 0≤t → 0≤R t := by
  apply continuous_halfLine_bound continuous_const h.continuous
  have hh := representative_halfLine_ae he
  have hn := ((Lp.coeFn_nonneg _).mpr hr).filter_mono (ae_mono (Measure.restrict_le_self (s := Ioi (0 : ℝ))))
  filter_upwards [hh,hn] with t he hn
  simpa only [Pi.zero_apply,he] using hn

-- @paper-step thm:n_construction/even_resolvent_integrating_factor_monotone
theorem even_resolvent_tilt_monotone {J : ℝ → ℝ} {δ a c : ℝ}
    (ha : 0<a) (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (h : CompactResolventEvolution J δ a c (-1) R)
    (hR : ∀ t, 0≤t → 0≤R t) :
    MonotoneOn (fun t => Real.exp ((c/a)*t)*R t) (Ici 0) := by
  have hRn : ∀ᵐ t, 0≤causalize R t := ae_of_all _ (fun t => by
    by_cases ht : 0≤t
    · simpa [causalize,ht] using hR t ht
    · simp [causalize,ht])
  intro u hu v hv huv
  have hac : AbsolutelyContinuousOnInterval (fun t => Real.exp ((c/a)*t)*R t) u v := by
    have he : AbsolutelyContinuousOnInterval (fun t : ℝ => Real.exp ((c/a)*t)) u v := by
      apply ContDiffOn.absolutelyContinuousOnInterval; fun_prop
    exact he.mul (h.ac u v)
  have hd : ∀ᵐ t, 0<t → 0≤deriv (fun s => Real.exp ((c/a)*s)*R s) t := by
    filter_upwards [h.ode] with t hd ht
    have hg := (((hasDerivAt_id t).const_mul (c/a)).exp).mul (hd ht)
    change HasDerivAt (fun s => Real.exp ((c/a)*s)*R s) _ t at hg
    rw [hg.deriv]
    have hconv := convolution_pointwise_nonneg (ae_of_all _ (compactKernel_nonneg hn)) hRn t
    dsimp
    have ha0 := ne_of_gt ha
    have hh := mul_nonneg (Real.exp_nonneg ((c/a)*t)) (div_nonneg hconv ha.le)
    convert hh using 1 <;> ring
  have hi : 0≤∫ t in u..v, deriv (fun s => Real.exp ((c/a)*s)*R s) t := by
    rw [intervalIntegral.integral_of_le huv]
    apply integral_nonneg_of_ae
    have hd' := hd.filter_mono (ae_mono (Measure.restrict_le_self (s := Ioc u v)))
    filter_upwards [hd',ae_restrict_mem measurableSet_Ioc] with t ht hmem
    exact ht (lt_of_le_of_lt hu hmem.1)
  rw [hac.integral_deriv_eq_sub] at hi
  linarith

-- @paper-step thm:n_construction/even_resolvent_backward_comparison
theorem even_resolvent_backward {J : ℝ → ℝ} {δ a c : ℝ}
    (ha : 0<a) (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (h : CompactResolventEvolution J δ a c (-1) R)
    (hR : ∀ t, 0≤t → 0≤R t) {s t : ℝ} (hs : 0≤s) (hst : s≤t) :
    R (t-s)≤Real.exp ((c/a)*s)*R t := by
  have hh := even_resolvent_tilt_monotone ha hn h hR
    (sub_nonneg.mpr hst) (hs.trans hst) (by linarith : t-s≤t)
  have he : Real.exp ((c/a)*t)=Real.exp ((c/a)*(t-s))*Real.exp ((c/a)*s) := by
    rw [← Real.exp_add]; congr 1; ring
  dsimp only at hh
  rw [he,mul_assoc] at hh
  exact (mul_le_mul_iff_right₀ (Real.exp_pos _)).mp hh

end MIACE
end
/- END SOURCE: MIACE.CascadeOrdinary -/

/- BEGIN SOURCE: MIACE/CascadeCommandSigns.lean -/
section
                            

/-! The even command estimate is a pointwise theorem for the actual
ordinary resolvent, not an assumption on a transform numerator. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

-- @paper-step thm:n_construction/even_parity_pointwise_tail_convolution_bound
theorem even_resolvent_tail_bound {J : ℝ → ℝ} (hc : Continuous J) {δ a c : ℝ}
    (hδ : 0≤δ) (ha : 0<a) (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (h : CompactResolventEvolution J δ a c (-1) R)
    (hR : ∀ t, 0≤t → 0≤R t) {t : ℝ} (ht : 0≤t) :
    (compactKernel (compactTail J δ) δ ⋆ causalize R) t≤
      compactExpMoment (compactTail J δ) δ (c/a)*R t := by
  let K := compactKernel (compactTail J δ) δ
  have hK (s : ℝ) : 0≤K s := compactKernel_nonneg
    (fun u hu => compactTail_nonneg hu.1 hu.2 hn) s
  have hRn (s : ℝ) : 0≤causalize R s := by
    by_cases hs : 0≤s
    · simpa [causalize,hs] using hR s hs
    · simp [causalize,hs]
  have hb (s : ℝ) : K s*causalize R (t-s)≤expWeight (c/a) K s*R t := by
    by_cases hs : s∈Icc (0 : ℝ) δ
    · by_cases hst : s≤t
      · have hh := mul_le_mul_of_nonneg_left
          (even_resolvent_backward ha hn h hR hs.1 hst) (hK s)
        simp only [causalize,indicator_of_mem (show t-s∈Ici (0 : ℝ) from sub_nonneg.mpr hst)]
        dsimp [expWeight]
        nlinarith
      · rw [show causalize R (t-s)=0 by simp [causalize,show ¬0≤t-s by linarith]]
        simp only [mul_zero]
        exact mul_nonneg (mul_nonneg (Real.exp_nonneg _) (hK s)) (hR t ht)
    · simp [K,compactKernel,hs,expWeight]
  have hi := (compactKernel_weighted (compactTail_continuous hc δ) δ (c/a)).mul_const (R t)
  have hh := integral_mono_of_nonneg
    (ae_of_all _ (fun s => mul_nonneg (hK s) (hRn (t-s)))) hi (ae_of_all _ hb)
  rw [integral_mul_const,compactKernel_moment _ hδ] at hh
  exact hh

-- @paper-step thm:n_construction/even_parity_actual_command_nonnegative
theorem even_resolvent_command_nonneg {J : ℝ → ℝ} (hc : Continuous J) {δ a c : ℝ}
    (hδ : 0≤δ) (ha : 0<a) (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (h : CompactResolventEvolution J δ a c (-1) R)
    (hR : ∀ t, 0≤t → 0≤R t)
    (hcond : compactExpMoment (compactTail J δ) δ (c/a)≤1-a) {t : ℝ} (ht : 0≤t) :
    0≤(1-a)*R t-(compactKernel (compactTail J δ) δ ⋆ causalize R) t := by
  have hb := even_resolvent_tail_bound hc hδ ha hn h hR ht
  have hh := mul_le_mul_of_nonneg_right hcond (hR t ht)
  linarith

-- @paper-step thm:n_construction/odd_parity_actual_command_nonnegative
theorem odd_resolvent_command_nonneg {J : ℝ → ℝ} {δ a : ℝ} (ha : a≤1)
    (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (hR : ∀ t, 0≤t → 0≤R t) {t : ℝ} (ht : 0≤t) :
    0≤(1-a)*R t+(compactKernel (compactTail J δ) δ ⋆ causalize R) t := by
  have hK : ∀ᵐ t, 0≤compactKernel (compactTail J δ) δ t := ae_of_all _
    (compactKernel_nonneg (fun t ht => compactTail_nonneg ht.1 ht.2 hn))
  have hRn : ∀ᵐ t, 0≤causalize R t := ae_of_all _ (fun s => by
    by_cases hs : 0≤s
    · simpa [causalize,hs] using hR s hs
    · simp [causalize,hs])
  exact add_nonneg (mul_nonneg (sub_nonneg.mpr ha) (hR t ht))
    (convolution_pointwise_nonneg hK hRn t)

/-- The exact parity test displayed in Theorem 17, in the n=N-2 convention. -/
def CascadeParityTest (J : ℝ → ℝ) (δ a ε : ℝ) : Prop :=
  (ε=1 ∧ ∃ l : ℝ, 0<l ∧ 1-compactMoment J δ 0+compactExpMoment J δ l≤a*l) ∨
  (ε= -1 ∧ compactExpMoment (compactTail J δ) δ
    ((1+compactMoment J δ 0)/a)≤1-a)

-- @paper-step thm:n_construction/both_parities_ordinary_inverse_and_command_sign
theorem cascade_ordinary_inverse_and_command {J : ℝ → ℝ} (hc : Continuous J)
    {δ a ε : ℝ} (hδ : 0≤δ) (ha : 0<a) (ha1 : a<1)
    (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) (hpar : CascadeParityTest J δ a ε) :
    ∃ R : ℝ → ℝ,
      CompactResolventEvolution J δ a (1-ε*compactMoment J δ 0) ε R ∧
      Integrable (causalize R) ∧
      (∃ η : ℝ, 0<η ∧ Integrable (expWeight η (causalize R))) ∧
      (∀ t, 0≤t → 0≤R t) ∧ (∫ t, R t ∂halfLine)=1 ∧
      (∀ p : ℝ, 0≤p → (a*p+(1-ε*compactMoment J δ 0)+
        ε*compactExpMoment J δ (-p))*laplace R p=1) ∧
      ∀ t, 0≤t → 0≤(1-a)*R t+
        ε*(compactKernel (compactTail J δ) δ ⋆ causalize R) t := by
  rcases hpar with ⟨he,l,hl,hcond⟩|⟨he,hcond⟩
  · subst ε
    obtain ⟨r,hrn,hrc,hrw,hrmass,hrT⟩ := oddCascade_resolvent hc hδ ha hl hn hcond
    obtain ⟨R,hR,heR⟩ := compact_resolvent_realization hc hδ ha r hrc
      (ε := 1) (fun p hp => by simpa using hrT p hp.le)
    have hRn := compact_resolvent_nonneg hR hrn heR
    refine ⟨R,by simpa using hR,(L1.integrable_coeFn r).congr heR,?_,hRn,?_,?_,?_⟩
    · obtain ⟨η,hη,hw⟩ := hrw
      exact ⟨η,hη,weighted_integrable_congr heR hw⟩
    · rw [← integral_congr_ae (representative_halfLine_ae heR),← causal_integral_halfLine hrc]
      exact hrmass
    · intro p hp
      rw [← laplace_congr_halfLine (representative_halfLine_ae heR)]
      simpa using hrT p hp
    · intro t ht
      simpa using odd_resolvent_command_nonneg ha1.le hn hRn ht
  · subst ε
    obtain ⟨r,hrn,hrc,hrw,hrmass,hrT⟩ := evenCascade_resolvent hc hδ ha hn
    obtain ⟨R,hR,heR⟩ := compact_resolvent_realization hc hδ ha r hrc
      (ε := -1) (fun p hp => by simpa [sub_eq_add_neg] using hrT p hp.le)
    have hRn := compact_resolvent_nonneg hR hrn heR
    refine ⟨R,by simpa using hR,(L1.integrable_coeFn r).congr heR,?_,hRn,?_,?_,?_⟩
    · obtain ⟨η,hη,hw⟩ := hrw
      exact ⟨η,hη,weighted_integrable_congr heR hw⟩
    · rw [← integral_congr_ae (representative_halfLine_ae heR),← causal_integral_halfLine hrc]
      exact hrmass
    · intro p hp
      rw [← laplace_congr_halfLine (representative_halfLine_ae heR)]
      simpa [sub_eq_add_neg] using hrT p hp
    · intro t ht
      simpa using even_resolvent_command_nonneg hc hδ ha hn hR hRn hcond ht

end MIACE
end
/- END SOURCE: MIACE.CascadeCommandSigns -/

/- BEGIN SOURCE: MIACE/WeightedACDecay.lean -/
section
                            

/-! A weighted W^{1,1} estimate converts the constructed ordinary
resolvent into a pointwise exponential bound. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

-- @paper-step thm:n_construction/weighted_finite_interval_bound
theorem weighted_interval_abs_bound {f : ℝ → ℝ} {η t u : ℝ} (hη : 0≤η)
    (ht : 0≤t) (htu : t≤u) (hi : IntervalIntegrable f volume t u)
    (hw : Integrable (expWeight η f)) :
    (∫ s in t..u, |f s|)≤Real.exp (-η*t)*(∫ s, |expWeight η f s|) := by
  have hb (s : ℝ) (hs : s∈Icc t u) : |f s|≤Real.exp (-η*t)*|expWeight η f s| := by
    rw [expWeight,abs_mul,abs_of_pos (Real.exp_pos _),← mul_assoc,← Real.exp_add]
    have hh : 1≤Real.exp (-η*t+η*s) := Real.one_le_exp_iff.mpr (by nlinarith [hs.1])
    nlinarith [abs_nonneg (f s)]
  have hh := intervalIntegral.integral_mono_on htu hi.abs
    ((hw.abs.const_mul (Real.exp (-η*t))).intervalIntegrable) hb
  rw [intervalIntegral.integral_const_mul] at hh
  have hpartial : (∫ s in t..u, |expWeight η f s|)≤∫ s, |expWeight η f s| := by
    rw [intervalIntegral.integral_of_le htu]
    exact setIntegral_le_integral hw.abs (ae_of_all _ (fun _ => abs_nonneg _))
  exact hh.trans (mul_le_mul_of_nonneg_left hpartial (Real.exp_nonneg _))

-- @paper-step thm:n_construction/weighted_ordinary_ode_pointwise_decay
theorem weighted_AC_decay {R F : ℝ → ℝ} {η : ℝ} (hη : 0≤η)
    (hR : Continuous R) (hF : Integrable F) (hwR : Integrable (expWeight η (causalize R)))
    (hwF : Integrable (expWeight η F))
    (hftc : ∀ u v, 0≤u → u≤v → (∫ s in u..v, F s)=R v-R u) :
    ∀ t, 0≤t → |R t|≤
      ((∫ s, |expWeight η (causalize R) s|)+(∫ s, |expWeight η F s|))*Real.exp (-η*t) := by
  intro t ht
  let D := Real.exp (-η*t)*(∫ s, |expWeight η F s|)
  have hb (s : ℝ) (hs : s∈Icc t (t+1)) : |R t|≤|R s|+D := by
    have hdiff : |R s-R t|≤D := by
      rw [← hftc t s ht hs.1]
      have hh := intervalIntegral.norm_integral_le_integral_norm (f := F) (μ := volume) hs.1
      simp only [Real.norm_eq_abs] at hh
      exact hh.trans (weighted_interval_abs_bound hη ht hs.1 hF.intervalIntegrable hwF)
    have hh := abs_add_le (R s) (R t-R s)
    rw [add_sub_cancel] at hh
    rw [abs_sub_comm (R t) (R s)] at hh
    linarith
  have hbound := intervalIntegral.integral_mono_on (show t≤t+1 by linarith)
    intervalIntegrable_const ((hR.abs.add continuous_const).intervalIntegrable (μ := volume) t (t+1)) hb
  change (∫ s in t..t+1, |R t|)≤(∫ s in t..t+1, |R s|+D) at hbound
  rw [intervalIntegral.integral_add (hR.abs.intervalIntegrable t (t+1)) intervalIntegrable_const,
    intervalIntegral.integral_const,intervalIntegral.integral_const] at hbound
  simp only [add_sub_cancel_left,smul_eq_mul,one_mul] at hbound
  have hlocal : IntervalIntegrable (causalize R) volume t (t+1) := by
    apply (hR.intervalIntegrable t (t+1)).congr
    intro s hs
    rw [uIoc_of_le (show t≤t+1 by linarith)] at hs
    simp [causalize,show 0≤s from ht.trans hs.1.le]
  have hRbound := weighted_interval_abs_bound hη ht (show t≤t+1 by linarith) hlocal hwR
  have he : (∫ s in t..t+1, |causalize R s|)=(∫ s in t..t+1, |R s|) := by
    apply intervalIntegral.integral_congr
    intro s hs
    rw [uIcc_of_le (show t≤t+1 by linarith)] at hs
    simp [causalize,show 0≤s from ht.trans hs.1]
  rw [he] at hRbound
  dsimp only [D] at hbound
  nlinarith

-- @paper-step thm:n_construction/compact_resolvent_pointwise_exponential_decay
theorem compact_resolvent_decay {J : ℝ → ℝ} (hc : Continuous J) {δ a c ε η : ℝ}
    (hη : 0<η) {R : ℝ → ℝ} (h : CompactResolventEvolution J δ a c ε R)
    (hi : Integrable (causalize R)) (hw : Integrable (expWeight η (causalize R))) :
    ∃ C : ℝ, 0≤C ∧ ∀ t, 0≤t → |R t|≤C*Real.exp (-η*t) := by
  let F := fun t => -(c/a)*causalize R t-(ε/a)*(compactKernel J δ ⋆ causalize R) t
  have hJ := compactKernel_integrable hc δ
  have hF : Integrable F := (hi.const_mul (-(c/a))).sub
    ((hJ.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hi).const_mul (ε/a))
  have hwF : Integrable (expWeight η F) := by
    have hh := (hw.const_mul (-(c/a))).sub
      (((compactKernel_weighted hc δ η).integrable_convolution
        (ContinuousLinearMap.lsmul ℝ ℝ) hw).const_mul (ε/a))
    rw [← expWeight_convolution] at hh
    convert hh using 1
    funext t; dsimp [F,expWeight]; ring
  have hftc (u v : ℝ) (hu : 0≤u) (huv : u≤v) :
      (∫ s in u..v, F s)=R v-R u := by
    rw [← (h.ac u v).integral_deriv_eq_sub]
    apply intervalIntegral.integral_congr_ae
    filter_upwards [h.ode] with t hd ht
    rw [uIoc_of_le huv] at ht
    have ht0 : 0<t := hu.trans_lt ht.1
    rw [(hd ht0).deriv]
    simp only [F,causalize,indicator_of_mem (show t∈Ici (0 : ℝ) from ht0.le)]
  refine ⟨(∫ s, |expWeight η (causalize R) s|)+(∫ s, |expWeight η F s|),
    add_nonneg (integral_nonneg (fun _ => abs_nonneg _)) (integral_nonneg (fun _ => abs_nonneg _)),?_⟩
  exact weighted_AC_decay hη.le h.continuous hF hw hwF hftc

end MIACE
end
/- END SOURCE: MIACE.WeightedACDecay -/

/- BEGIN SOURCE: MIACE/ContinuedImpulse.lean -/
section
                              
                            

/-! The remainder kernel is tied to the ordinary cascade impulse, rather
than an arbitrary positive function. The all-real integrating-factor
recurrence defines its continuation before time zero. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology

noncomputable def continuedImpulse (r : ℕ → ℝ) (n : ℕ) (t : ℝ) : ℝ :=
  (-1 : ℝ)^n*reverseImpulse r n (-t)

-- @paper-step lem:n_remainder/continued_impulse_continuity
theorem continuedImpulse_continuous (r : ℕ → ℝ) (n : ℕ) :
    Continuous (continuedImpulse r n) :=
  ((reverseImpulse_continuous r n).comp continuous_neg).const_mul _

-- @paper-step lem:n_remainder/continued_impulse_actual_lag_ode
theorem continuedImpulse_deriv (r : ℕ → ℝ) (n : ℕ) (t : ℝ) :
    HasDerivAt (continuedImpulse r (n+1))
      (r (n+1)*(continuedImpulse r n t-continuedImpulse r (n+1) t)) t := by
  have hd := ((reverseImpulse_deriv r n (-t)).comp t (hasDerivAt_id t).neg).const_mul ((-1 : ℝ)^(n+1))
  convert hd using 1
  · rfl
  · simp only [continuedImpulse,pow_succ,id_eq]
    ring

-- @paper-step lem:n_remainder/global_lag_integrating_factor
theorem global_lag_formula {u x : ℝ → ℝ} (hu : Continuous u) (hx : Continuous x)
    (r : ℝ) (hr : r≠0) (hx0 : x 0=0)
    (hd : ∀ t, HasDerivAt x (r*(u t-x t)) t) (t : ℝ) : x t=lag (1/r) u t := by
  have hp : ∀ t, HasDerivAt (fun s => Real.exp (r*s)*x s) (r*(Real.exp (r*t)*u t)) t := by
    intro s
    convert (((hasDerivAt_id s).const_mul r).exp).mul (hd s) using 1
    · rfl
    · dsimp; ring
