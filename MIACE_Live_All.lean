positive rate, exponential bounds, exact original-signal areas, and the
finite supremum of the ordinary command. -/
structure NonlinearOptimalFeedback (a : ℝ → ℝ) (α : ℝ)
    (y : ℝ → ℝ) (m M : ℝ) : Prop where
  min_pos : 0 < m
  min_attained : ∃ xm ∈ Icc (0 : ℝ) 1, a xm = m
  max_attained : ∃ xM ∈ Icc (0 : ℝ) 1, a xM = M
  rate_lower : ∀ x ∈ Icc (0 : ℝ) 1, m ≤ a x
  rate_upper : ∀ x ∈ Icc (0 : ℝ) 1, a x ≤ M
