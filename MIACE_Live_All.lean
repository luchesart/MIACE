theorem imc_internal_stability (N : ℕ) (σ : ℕ → ℝ) (F : IMCFilter) {δ ε : ℝ}
    (hδ : 0≤δ) (hδε : 0≤δ+ε) (hσ : ∀ j≤N, 0<σ j ∧ σ j≤1) (hfirst : σ 0=1)
    (hq : imcDelayGain F ε<1) : IMCInternallyStable N σ F δ ε := by
  obtain ⟨η,Cu,hη,hηh,hηF,hCu,hfeedback⟩ :=
    imc_history_feedback_stability N σ F hδ hδε hσ hfirst hq
  obtain ⟨B,hB,hcontrol⟩ := imc_internal_uniform_control N σ F hδ hδε hη.le hηh hηF hCu hσ
  refine ⟨η,B,hη,hB,?_⟩
  intro M H hH
  obtain ⟨u,hu,huc,he,hw,hunique⟩ := hfeedback M H hH
  exact ⟨u,hu,huc,he,hcontrol M H hH u huc hw,hunique⟩

-- @paper-step thm:complete_attainment/nominal_full_state_IMC_stability
theorem imc_nominal_internal_stability (N : ℕ) (σ : ℕ → ℝ) (F : IMCFilter) {δ : ℝ}
    (hδ : 0≤δ) (hσ : ∀ j≤N, 0<σ j ∧ σ j≤1) (hfirst : σ 0=1) :
    IMCInternallyStable N σ F δ 0 := by
  apply imc_internal_stability N σ F hδ (by simpa using hδ) hσ hfirst
  simp [imcDelayGain]

-- @paper-step thm:complete_robust/internal_control_actual_ODE_and_pointwise_decay
theorem imc_control_actual_states (N : ℕ) (σ : ℕ → ℝ) (F : IMCFilter) {δ ε η C : ℝ}
    (hδ : 0≤δ) (hδε : 0≤δ+ε) (hη : 0≤η) (H : IMCHistory) {u : ℝ → ℝ}
    (hu : LocallyIntegrable u volume) (h : IMCInternalControl N σ F δ ε H u η C) :
