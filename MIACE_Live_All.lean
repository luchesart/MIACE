      0<s*δ*((1+Real.sin (s*δ))/(Real.cos (s*δ))^2)) := by
  refine ⟨scalarDelay_response_exists hx hδ,?_,fun hd hs => delayedQuadratic_old_gain hq hd hs⟩
  intro E hE
  have he : (1+Real.sin (x*δ))/(2*x*Real.cos (x*δ))=delayEnergyPsi (x*δ)/(2*x) := by
    unfold delayEnergyPsi; ring
  refine ⟨scalarDelay_response_square_integrable hx hδ hb hE,
    (scalarDelay_command_energy hx hδ hb hE).1,?_,?_,scalarDelay_quadratic_cost hx hδ hb hE q,
    fun t ht => scalarDelay_command_identity hδ hE ht⟩
  · rw [scalarDelay_response_energy hx hδ hb hE,he]
  · rw [(scalarDelay_command_energy hx hδ hb hE).2,he]

