        (-1 : ℝ)^(n+1)*compactExpMoment (remainderJ r n δ) δ (-p))*laplace R p=1) :
    ∀ p : ℝ, 0<p → (rationalCascadeQ r n δ U).eval p*laplace (fun t => 1+v t) p=
