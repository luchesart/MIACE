  output_initial : 1-E 0=0
  integrator_initial : (∫ s in (0 : ℝ)..0, E s)=0
  filter_initial : lag ρ E 0=0
  integrator_ode : ∀ t : ℝ, HasDerivAt (fun u => ∫ s in 0..u, E s) (E t) t
  filter_ode : ∀ t : ℝ, 0<t → HasDerivAt (lag ρ E) ((E t-lag ρ E t)/ρ) t
  integrator_final : Tendsto (fun t => ∫ s in 0..t, E s) atTop (𝓝 (1/i))
  filter_final : Tendsto (lag ρ E) atTop (𝓝 0)
  zero_transport_history : ∀ s : ℝ, s<0 →
    causalize (pidTimeCommand (i*(1+ell-ρ)) i (i*(ell-ρ)*(1-ρ)) ρ E) s=0
  waiting : ∀ t : ℝ, 0≤t → t≤δ → E t=1
  output_monotone : MonotoneOn (fun t => 1-E t) (Ici 0)
