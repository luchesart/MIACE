  have hb := nonlinear_clock_rate_bounds hc hm hlo hup
  have hM : 0 < M := lt_of_lt_of_le (hapos 0) (hup 0 (by norm_num))
  obtain ⟨s, hs0, hsmono, hscont, hsder, hsb⟩ := positiveClock_exists_inverse
    (nonlinearClockRate a c) hq ((c*M)⁻¹) ((c*m)⁻¹) (hb 0).1
    (fun x => (hb x).2.1) (fun x => (hb x).2.2)
  have hsC : ContDiff ℝ 1 s := nonlinear_inverse_clock_contDiff hq hscont
    (fun x => ne_of_gt ((hb x).1.trans_le (hb x).2.1)) hsder
  let y : ℝ → ℝ := fun t => 1 - Real.exp (-s t)
