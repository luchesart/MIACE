  apply hi.congr
  have hl := (hA.locality hfc T).filter_mono (ae_mono (Measure.restrict_le_self (s := k)))
  filter_upwards [hl,ae_restrict_mem hk.measurableSet] with t ht htk
  exact (ht (hT htk)).symm

