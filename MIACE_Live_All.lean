  · exact hw.initial.trans hW.initial.symm
  · change remainderFilter r δ H.controllerInitial w j 0=remainderFilter r δ H.controllerInitial W j 0
    cases j.val <;> simp [remainderFilter,lagState,lag]
  · simp [rationalCoordinate,rationalBState,serialState,lagState,lag]

-- @paper-step thm:n_construction/full_rational_evolution_unrestricted_uniqueness
theorem rational_history_unique (r : ℕ → ℝ) (n : ℕ) {δ a c : ℝ} (hδ : 0≤δ)
    (H : RationalHistory) (hHi : Integrable (historyInput δ H.past)) {w W : ℝ → ℝ}
    (hw : RationalHistoryEvolution r n δ a c H w)
    (hW : RationalHistoryEvolution r n δ a c H W) : ∀ t, 0≤t → w t=W t := by
  classical
  let x := fun k t => rationalCoordinate r n δ H w k t-rationalCoordinate r n δ H W k t
  let f := fun t => ∑ k : RationalIndex n, |x k t|
  let L : RationalIndex n → ℝ
    | .inl _ => |-c/a|+|1/a|+|-(1/a)|
