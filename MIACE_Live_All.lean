    absArea (fun t => x*e t+i t) halfLine=k*IAU/(|a| *τ) := by
  dsimp only
  have hf := pi_state_response h hx hr
  have he := physical_absolute_scaling e a τ 1 hτ zero_lt_one
  simp only [div_one] at he
  have hu := physical_absolute_scaling (fun t => x*e t+i t) a τ k hτ hk
