    rw [heq]
    exact ((he.const_mul pc).add (hz.1.const_mul i)).add ((he.sub hl).const_mul (dc/ρ))
  refine ⟨hi,?_⟩
  have ha := integral_add ((he.const_mul pc).add (hz.1.const_mul i))
      ((he.sub hl).const_mul (dc/ρ))
  simp only [Pi.add_apply,Pi.sub_apply] at ha
  rw [laplace,heq,ha,integral_add (he.const_mul pc) (hz.1.const_mul i),
    integral_const_mul,integral_const_mul,integral_const_mul,integral_sub he hl]
  change pc*laplace f p+i*laplace (fun t => ∫ s in 0..t, f s) p+
    (dc/ρ)*(laplace f p-laplace (lag ρ f) p)=_
