noncomputable def nonlinearClippedPhase (s : ℝ) : ℝ :=
  1 - Real.exp (- max s 0)

noncomputable def nonlinearClockRate (a : ℝ → ℝ) (c s : ℝ) : ℝ :=
  (c * a (nonlinearClippedPhase s))⁻¹

-- @paper-step thm:nonlinear_miace/clock_phase_range
theorem nonlinear_clipped_phase_mem (s : ℝ) :
    nonlinearClippedPhase s ∈ Icc (0 : ℝ) 1 := by
  have he : Real.exp (- max s 0) ≤ 1 := Real.exp_le_one_iff.mpr (by
    have := le_max_right s (0 : ℝ)
    linarith)
  have hp := Real.exp_pos (- max s 0)
  constructor <;> unfold nonlinearClippedPhase <;> linarith

-- @paper-step thm:nonlinear_miace/clock_continuity
theorem nonlinear_clock_rate_continuous {a : ℝ → ℝ} (ha : Continuous a)
    (hapos : ∀ x, 0 < a x) {c : ℝ} (hc : 0 < c) :
    Continuous (nonlinearClockRate a c) := by
  have hp : Continuous nonlinearClippedPhase := by
    unfold nonlinearClippedPhase
    fun_prop
  exact (continuous_const.mul (ha.comp hp)).inv₀ (fun s =>
    ne_of_gt (mul_pos hc (hapos _)))

