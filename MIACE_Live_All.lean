    (causalize (lagState F.timeConstant H.filterInitial (imcFilterInput N σ δ ε H u))) C

-- @paper-step thm:complete_robust/all_internal_states_uniform_history_estimate
theorem imc_internal_uniform_control (N : ℕ) (σ : ℕ → ℝ) (F : IMCFilter) {δ ε η Cu : ℝ}
    (hδ : 0≤δ) (hδε : 0≤δ+ε) (hη : 0≤η) (hηh : η≤1/2)
    (hηF : η<1/F.timeConstant) (hCu : 0≤Cu) (hσ : ∀ j≤N, 0<σ j ∧ σ j≤1) :
    ∃ B : ℝ, 0≤B ∧ ∀ M H, IMCHistoryBound N F δ ε H M →
      ∀ u : ℝ → ℝ, Causal u → WeightedControl η u (Cu*M) →
        IMCInternalControl N σ F δ ε H u η (B*M) := by
  obtain ⟨Cs,hCs,hstates⟩ := serialState_uniform_control σ (N+1) η
    (normalized_storage_exponents σ N hηh hσ)
  obtain ⟨K,hK⟩ := lagKernel_weightedControl F.timeConstant_pos hηF
  let X := Cs*(1+Cu)
  let P := (δ+1+X)*Real.exp (η*δ)
  let Q := (δ+ε+1+X)*Real.exp (η*(δ+ε))
  let Z := F.timeConstant*K+K*(P+Q)
  have hX : 0≤X := by dsimp [X]; positivity
  have hP : 0≤P := by dsimp [P]; positivity
  have hQ : 0≤Q := by dsimp [Q]; positivity
  have hZ : 0≤Z := by dsimp [Z]; have := F.timeConstant_pos; have := hK.nonneg; positivity
  let B := Cu+X+P+Q+Z
  have hB : 0≤B := by dsimp [B]; positivity
  refine ⟨B,hB,?_⟩
  intro M H hH u huc hu
  have hw : WeightedControl η (causalize u) (Cu*M) :=
    weightedControl_congr hu (causalize_eq_ae huc).symm
  have hmodel (j : ℕ) (hj : j≤N+1) :
      WeightedControl η (causalize (serialState σ H.modelInitial u j)) (X*M) := by
    have hh := hstates M (Cu*M) hH.nonneg H.modelInitial
      (fun k hk => hH.model_initial k (by omega)) u hw j hj
    convert hh using 1; dsimp [X]; ring
  have hplant (j : ℕ) (hj : j≤N+1) :
      WeightedControl η (causalize (serialState σ H.plantInitial u j)) (X*M) := by
    have hh := hstates M (Cu*M) hH.nonneg H.plantInitial
      (fun k hk => hH.plant_initial k (by omega)) u hw j hj
    convert hh using 1; dsimp [X]; ring
