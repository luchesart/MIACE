-- @paper-step thm:complete_robust/weighted_small_gain
theorem weighted_small_gain {K : ℝ → ℝ} (hK : Integrable K)
    (hq : absArea K volume < 1) {β : ℝ} (hβ : 0 < β)
    (hKw : Integrable (expWeight β K) volume) :
    ∃ η : ℝ, ∃ hw : Integrable (expWeight η K) volume,
      0 < η ∧ η ≤ β ∧ absArea (expWeight η K) volume < 1 ∧
      let T := convOp hw
