  have hb := even_resolvent_tail_bound hc hδ ha hn h hR ht
  have hh := mul_le_mul_of_nonneg_right hcond (hR t ht)
  linarith

-- @paper-step thm:n_construction/odd_parity_actual_command_nonnegative
theorem odd_resolvent_command_nonneg {J : ℝ → ℝ} {δ a : ℝ} (ha : a≤1)
    (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (hR : ∀ t, 0≤t → 0≤R t) {t : ℝ} (ht : 0≤t) :
    0≤(1-a)*R t+(compactKernel (compactTail J δ) δ ⋆ causalize R) t := by
  have hK : ∀ᵐ t, 0≤compactKernel (compactTail J δ) δ t := ae_of_all _
    (compactKernel_nonneg (fun t ht => compactTail_nonneg ht.1 ht.2 hn))
  have hRn : ∀ᵐ t, 0≤causalize R t := ae_of_all _ (fun s => by
    by_cases hs : 0≤s
