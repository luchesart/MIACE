    rw [← Real.exp_add]; congr 1; nlinarith [h.rate_delay]
  have he2 : Real.exp (-(1/ρ)*(t-δ))=Real.exp (δ/ρ)*Real.exp (-(1/ρ)*t) := by
    rw [← Real.exp_add]; congr 1; ring
  unfold explicitR
  rw [exp_delay_box_convolution h.delay_pos.le ht hl,
    exp_delay_box_convolution h.delay_pos.le ht (one_div_pos.mpr hr)]
  simp only [explicitJ,min_eq_right htd,
    expKernel,causalize,indicator_of_mem (show t∈Ici (0 : ℝ) from ht)]
  rw [he1,he2]
  field_simp
  <;> ring

-- @paper-step thm:pid_explicit_family/command_forcing_nonnegative_on_the_whole_halfline
theorem explicitR_nonneg {i ρ ell l δ : ℝ} (h : ExplicitPIDData i ρ ell l δ) (t : ℝ) :
    0≤explicitR i ρ ell l δ t := by
  by_cases ht : 0≤t
  · by_cases htd : t≤δ
    · exact explicitR_initial_nonneg h ht htd
    · rw [explicitR_tail h (le_of_not_ge htd)]
      have hr := (explicitPID_order h).1
