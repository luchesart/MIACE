          (by nlinarith : 0≤1+ρ*(Real.exp (δ/ρ)-1))) (Real.exp_nonneg _))
  · have hn := lt_of_not_ge ht
    have hz1 := convolution_causal (causalize_causal (fun s => Real.exp (-l*s)))
      (compactKernel_causal (fun _ => 1) δ) t hn
    have hz2 := convolution_causal (causalize_causal (fun s => Real.exp (-(1/ρ)*s)))
