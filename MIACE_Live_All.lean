/-! The converse nonoscillation criterion for the actual ordinary response.
The proof uses only local regularity: neither integrability nor stability
is assumed of a hypothetical nonnegative response.

A nonnegative solution is decreasing and cannot have a first zero.
Integration over half a delay bounds its backward ratios. If l is an
eventual decay rate, the integrating factor improves it to x*exp(l*delta).
The iterated rates are increasing and bounded by the ratio estimate, so
their limit satisfies l=x*exp(l*delta), forcing x*delta<=exp(-1).
Only the sign change needed by Lemma 6 is asserted, not a general theorem
about infinitely many oscillations for every scalar-delay history. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology

-- @paper-step lem:delayed_cancellation/local_nonnegative_response_antitone
theorem scalarDelay_antitone_local {x δ : ℝ} (hx : 0<x) {E : ℝ → ℝ}
    (h : ScalarDelayResponse x δ E) (hn : ∀ t, 0≤t → 0≤E t) :
    AntitoneOn E (Ici 0) := by
  have hf := locally_integrable_interval (scalarDelay_shift_local h.continuous δ)
  have hp (t : ℝ) : 0≤shift δ (causalize E) t := by
    by_cases ht : 0≤t-δ
    · simpa [shift,causalize,ht] using hn (t-δ) ht
    · simp [shift,causalize,ht]
  intro a ha b hb hab
  have hI := intervalIntegral.integral_mono_interval le_rfl ha hab
    (ae_of_all _ hp) (hf 0 b)
  rw [h.integral_eq a ha,h.integral_eq b hb]
  nlinarith

-- @paper-step lem:delayed_cancellation/initial_delay_plateau
theorem scalarDelay_plateau {x δ : ℝ} {E : ℝ → ℝ}
    (h : ScalarDelayResponse x δ E) {t : ℝ} (ht : 0≤t) (htδ : t≤δ) : E t=1 := by
  rw [h.integral_eq t ht]
  have hz : (∫ s in 0..t, shift δ (causalize E) s)=0 := by
    rw [intervalIntegral.integral_of_le ht]
    apply integral_eq_zero_of_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioc,
      (volume.ae_ne δ).filter_mono (ae_mono (Measure.restrict_le_self (s := Ioc 0 t)))] with s hs hne
    have hh : ¬0≤s-δ := by intro hh; apply hne; have := hs.2; linarith
    simp [shift,causalize,hh]
  rw [hz]; ring

-- @paper-step lem:delayed_cancellation/classical_derivative_after_first_delay
theorem scalarDelay_derivative_after {x δ : ℝ} (hδ : 0≤δ) {E : ℝ → ℝ}
    (h : ScalarDelayResponse x δ E) {t : ℝ} (ht : δ<t) :
    HasDerivAt E (-x*E (t-δ)) t := by
  have heq : shift δ (causalize E)=ᶠ[𝓝 t] (fun s => E (s-δ)) := by
    filter_upwards [Ioi_mem_nhds ht] with s hs
    simp [shift,causalize,sub_nonneg.mpr (le_of_lt (show δ<s from hs))]
  have hc : ContinuousAt (shift δ (causalize E)) t :=
    ((h.continuous.comp (continuous_id.sub continuous_const)).continuousAt).congr heq.symm
  have hi := locally_integrable_interval (scalarDelay_shift_local h.continuous δ) 0 t
  have hmeas : StronglyMeasurable (shift δ (causalize E)) :=
    (h.continuous.stronglyMeasurable.indicator measurableSet_Ici).comp_measurable
      (continuous_id.sub continuous_const).measurable
  have hd := ((intervalIntegral.integral_hasDerivAt_right hi
    hmeas.stronglyMeasurableAtFilter hc).const_mul x).const_sub 1
  have hf : E=ᶠ[𝓝 t] (fun s => 1-x*(∫ u in 0..s, shift δ (causalize E) u)) := by
    filter_upwards [Ioi_mem_nhds (hδ.trans_lt ht)] with s hs
    exact h.integral_eq s hs.le
  convert hd.congr_of_eventuallyEq hf using 1
  simp [shift,causalize,sub_nonneg.mpr ht.le]

