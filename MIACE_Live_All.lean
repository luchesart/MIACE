/-! Поправка: ограничението се налага върху действителната команда.
Ниският коефициент x<1 се изключва чрез строго доминиране, а не по предположение. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology

def CommandCap (A x : ℝ) (e i : ℝ → ℝ) : Prop :=
  ∀ t : ℝ, 0 ≤ t → 0 ≤ 1+(x*e t+i t) ∧ 1+(x*e t+i t) ≤ A

noncomputable def l1Scalar (α z : ℝ) : ℝ := z^2+α*(1-z)^2

-- @paper-step thm:amplitude/actual_amplitude_constraint
theorem command_cap_iff {A x r : ℝ} {e i : ℝ → ℝ}
    (h : PIStateResponse x r e i) (hx : 0 < x) (hr : 0 < r)
    (hd : MonotoneDomain x r) (hA : 1 ≤ A) : CommandCap A x e i ↔ x ≤ A := by
  constructor
  · intro hc
    have hh := (hc 0 le_rfl).2
    simpa [h.initial_e,h.initial_i] using hh
  · intro hxA t ht
    exact ⟨pi_command_nonnegative h hx hr hd t ht,
      (pi_command_upper h hx hr hd t ht).trans (max_le hA hxA)⟩

-- @paper-step thm:amplitude/low_gain_strict_dominance
theorem low_gain_dominance {x r : ℝ} (hx : 0 < x) (hr : 0 < r)
    (hx1 : x < 1) (hd : MonotoneDomain x r) :
    1/2 < tracking x r ∧ 1 < r/x := by
  have hden : 0 < (1+x)^2 := by positivity
  have hdom : 4*x/(1+x)^2 ≤ r := by simpa [MonotoneDomain,hx1.le] using hd
  have h4 : (1+x)^2 < 4 := by nlinarith
  have hsmall : x < 4*x/(1+x)^2 := by
    apply (lt_div_iff₀ hden).mpr
    nlinarith [mul_lt_mul_of_pos_left h4 hx]
  have hxr : x < r := hsmall.trans_le hdom
  constructor
  · unfold tracking
    apply (lt_div_iff₀ (by positivity : 0 < 2*x*(1+x))).mpr
    nlinarith
  · exact (one_lt_div hx).mpr hxr

-- @paper-step thm:amplitude/quadratic_clipped_high_gain
theorem quadratic_clipped_high {q s A x r : ℝ} (hq : 0 < q)
    (hs : s^2=1+q) (hs1 : 1 < s) (hA : 1 ≤ A)
    (hx1 : 1 ≤ x) (hxA : x ≤ A) (hr1 : 1 ≤ r) :
    quadratic q (min s A) 1 ≤ quadratic q x r ∧
    (quadratic q x r=quadratic q (min s A) 1 ↔ x=min s A ∧ r=1) := by
  have hx : 0 < x := by linarith
  have hr : 0 < r := by linarith
  have hA0 : 0 < A := by linarith
  by_cases hsa : s ≤ A
  · rw [min_eq_left hsa]
    have hopt : quadratic q s 1=s-1 :=
      (quadratic_equality_iff q s s 1 (by linarith) zero_lt_one (by linarith) hs).mpr ⟨rfl,rfl⟩
    rw [hopt]
    exact ⟨quadratic_lower_bound q s x r hx hr hs,
      quadratic_equality_iff q s x r hx hr (by linarith) hs⟩
  · have has : A < s := lt_of_not_ge hsa
    rw [min_eq_right has.le]
    have hcoef : 0 < s^2*r-x^2 := by
      nlinarith [mul_le_mul_of_nonneg_left hr1 (sq_nonneg s)]
    have hcoef2 : 0 < s^2-A*x := by
      nlinarith [mul_le_mul_of_nonneg_left hxA hA0.le]
    have hg1 : quadratic q x r-quadratic q x 1 =
        (r-1)*(s^2*r-x^2)/(2*r*x*(1+x)) := by
      have hqeq : q=s^2-1 := by linarith
      rw [hqeq]
      unfold quadratic tracking effort
      field_simp
      <;> ring
    have hg2 : quadratic q x 1-quadratic q A 1 = (A-x)*(s^2-A*x)/(2*A*x) := by
      have hqeq : q=s^2-1 := by linarith
      rw [hqeq]
      unfold quadratic tracking effort
      field_simp
      <;> ring
    have hd1 : 0 < 2*r*x*(1+x) := by positivity
    have hd2 : 0 < 2*A*x := by positivity
    have hn1 : 0 ≤ (r-1)*(s^2*r-x^2)/(2*r*x*(1+x)) := by positivity
    have hn2 : 0 ≤ (A-x)*(s^2-A*x)/(2*A*x) := by positivity
    refine ⟨by linarith,?_⟩
    constructor
    · intro heq
      have hz1 : (r-1)*(s^2*r-x^2)/(2*r*x*(1+x))=0 := by linarith
      have hz2 : (A-x)*(s^2-A*x)/(2*A*x)=0 := by linarith
      have hh1 := ((div_eq_zero_iff.mp hz1).resolve_right (ne_of_gt hd1))
      have hh2 := ((div_eq_zero_iff.mp hz2).resolve_right (ne_of_gt hd2))
