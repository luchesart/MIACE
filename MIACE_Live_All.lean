  · have hlocal : (fun s => 1-E s)=ᶠ[𝓝 t] (fun _ => (0 : ℝ)) := by
      filter_upwards [Ioo_mem_nhds ht hw] with s hs
      rw [he s hs.1.le]
      simp [delayedError,hs.2.le]
    have hd := (hasDerivAt_const t (0 : ℝ)).congr_of_eventuallyEq hlocal
