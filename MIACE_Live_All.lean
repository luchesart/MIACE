  dsimp only
  rw [causalize,indicator_of_mem hts,causalize,indicator_of_mem hs0,← mul_assoc,← Real.exp_add]
  congr 2; ring

-- @paper-step thm:pid_two_rate_optimum/integrator_integrability_and_laplace
theorem primitive_laplace {f : ℝ → ℝ} (hf : Integrable f halfLine) {p : ℝ} (hp : 0<p) :
