      nonlinearClockRate a c s ≤ (c * m)⁻¹ := by
  have hl := hlo _ (nonlinear_clipped_phase_mem s)
  have hu := hup _ (nonlinear_clipped_phase_mem s)
  have hap : 0 < a (nonlinearClippedPhase s) := lt_of_lt_of_le hm hl
  have hM : 0 < M := lt_of_lt_of_le hap hu
  refine ⟨inv_pos.mpr (mul_pos hc hM), ?_, ?_⟩
  · exact inv_le_inv₀ (mul_pos hc hM) (mul_pos hc hap) |>.mpr
      (mul_le_mul_of_nonneg_left hu hc.le)
  · exact inv_le_inv₀ (mul_pos hc hap) (mul_pos hc hm) |>.mpr
      (mul_le_mul_of_nonneg_left hl hc.le)

