noncomputable def cascadeTransfer (σ : ℕ → ℝ) : ℕ → ℝ → ℝ
  | 0 => fun _ => 1
  | n+1 => fun p => cascadeTransfer σ n p/(1+σ n*p)
noncomputable def cascadeMean (σ : ℕ → ℝ) (n : ℕ) : ℝ := ∑ j ∈ Finset.range n, σ j

-- @paper-step thm:complete_attainment/cascade_actual_DC_gain
theorem cascadeTransfer_zero (σ : ℕ → ℝ) (n : ℕ) : cascadeTransfer σ n 0=1 := by
  induction n with
