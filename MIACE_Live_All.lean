-- @paper-step thm:complete_robust/weighted_control_difference
theorem weightedControl_sub {η C D : ℝ} {f g : ℝ → ℝ}
    (hf : WeightedControl η f C) (hg : WeightedControl η g D) :
    WeightedControl η (fun t => f t-g t) (C+D) := by
  have hh := weightedControl_add hf (weightedControl_smul hg (-1))
  convert hh using 1
  · funext t; ring
  · norm_num

-- @paper-step thm:complete_robust/actual_internal_input_causality
theorem imcFilterInput_causal (N : ℕ) (σ : ℕ → ℝ) {δ ε : ℝ}
    (hδ : 0≤δ) (hδε : 0≤δ+ε) (H : IMCHistory) (u : ℝ → ℝ) :
    Causal (imcFilterInput N σ δ ε H u) := by
  filter_upwards [plantHistoryOutput_causal N σ H.modelInitial hδ H.modelPast u,
