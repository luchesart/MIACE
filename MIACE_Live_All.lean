theorem nonlinear_flow_exists {a : ℝ → ℝ} (ha : Continuous a)
    (hapos : ∀ x, 0 < a x) {c m M : ℝ} (hc : 0 < c) (hm : 0 < m)
    (hlo : ∀ x ∈ Icc (0 : ℝ) 1, m ≤ a x)
    (hup : ∀ x ∈ Icc (0 : ℝ) 1, a x ≤ M) :
    ∃ y : ℝ → ℝ, ContDiff ℝ 1 y ∧ y 0 = 0 ∧
      (∀ t, 0 ≤ t → HasDerivAt y (c * a (y t) * (1-y t)) t) ∧
      (∀ t, 0 ≤ t → 0 ≤ y t ∧ y t < 1 ∧
