namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

structure ExplicitPIDData (i ρ ell l δ : ℝ) : Prop where
  gain_pos : 0 < i
  gain_lt_one : i < 1
  filter_eq : ρ=1-i
  lead_eq : ell=ρ/i
  rate_pos : 0<l
  delay_pos : 0<δ
  rate_delay : l*δ=1
  kernel_jump : 1≤l*Real.exp (-1)
  command_tail : l*Real.exp 1*(1-i)≤ i*(Real.exp 1-1)

noncomputable def explicitA (ρ ell l : ℝ) : ℝ := (1-l*ell)/(1-l*ρ)
noncomputable def explicitB (ρ ell l : ℝ) : ℝ := (ell-ρ)/(ρ*(1-l*ρ))

-- @paper-step thm:pid_explicit_family/interval_implies_all_explicit_parameter_conditions
theorem explicitPID_data {α δ : ℝ} (hα : Real.exp 1<α)
    (hδ : 1/α<δ) (hδ1 : δ≤1/Real.exp 1)
    (hδ2 : δ≤Real.exp 1/(α+1-Real.exp 1)) :
    ExplicitPIDData (delayedPIGain α δ) (1-delayedPIGain α δ)
      ((1-delayedPIGain α δ)/delayedPIGain α δ) (1/δ) δ := by
