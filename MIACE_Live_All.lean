-- @paper-step thm:pid_two_rate_optimum/balanced_exponential_enclosures
theorem balanced_exp_bounds :
    (28650479 : ℝ)/100000000 < Real.exp (-(5/4 : ℝ)) ∧
    Real.exp (-(5/4 : ℝ)) < 28650480/100000000 ∧
    (22313015 : ℝ)/100000000 < Real.exp (-(3/2 : ℝ)) ∧
    Real.exp (-(3/2 : ℝ)) < 22313017/100000000 := by
  have h₁ := Real.exp_bound (x := -(5/8 : ℝ)) (by norm_num) (n := 12) (by norm_num)
  have h₂ := Real.exp_bound (x := -(3/4 : ℝ)) (by norm_num) (n := 12) (by norm_num)
  norm_num [Finset.sum_range_succ,Nat.factorial] at h₁ h₂
  have hb₁ := (abs_le.mp h₁)
  have hb₂ := (abs_le.mp h₂)
  have ha : (5352614284 : ℝ)/10000000000 < Real.exp (-(5/8 : ℝ)) ∧
      Real.exp (-(5/8 : ℝ)) < 5352614286/10000000000 := by constructor <;> linarith
  have hb : (4723665526 : ℝ)/10000000000 < Real.exp (-(3/4 : ℝ)) ∧
      Real.exp (-(3/4 : ℝ)) < 4723665529/10000000000 := by constructor <;> linarith
  have he₁ : Real.exp (-(5/4 : ℝ))=Real.exp (-(5/8 : ℝ))^2 := by
    rw [pow_two,← Real.exp_add]
    norm_num
  have he₂ : Real.exp (-(3/2 : ℝ))=Real.exp (-(3/4 : ℝ))^2 := by
    rw [pow_two,← Real.exp_add]
    norm_num
  rw [he₁,he₂]
  refine ⟨?_,?_,?_,?_⟩ <;> nlinarith [Real.exp_pos (-(5/8 : ℝ)),Real.exp_pos (-(3/4 : ℝ))]

-- @paper-step thm:pid_two_rate_optimum/balanced_filter_enclosure
theorem balanced_rho_bounds :
    (10711 : ℝ)/100000 < pidRho (8/5) (1/4) 5 6 ∧
      pidRho (8/5) (1/4) 5 6 < 10712/100000 := by
  obtain ⟨ha₁,ha₂,hb₁,hb₂⟩ := balanced_exp_bounds
  have hd : 0 < 5*Real.exp (-(5/4 : ℝ))-6*Real.exp (-(3/2 : ℝ)) := by linarith
  have he : pidRho (8/5) (1/4) 5 6=
      (Real.exp (-(5/4 : ℝ))-Real.exp (-(3/2 : ℝ))-4/75)/
        (5*Real.exp (-(5/4 : ℝ))-6*Real.exp (-(3/2 : ℝ))) := by
    norm_num [pidRho,sub_eq_add_neg]
  rw [he]
  constructor
  · apply (lt_div_iff₀ hd).mpr
    linarith
  · apply (div_lt_iff₀ hd).mpr
    linarith

-- @paper-step thm:pid_two_rate_optimum/balanced_lead_enclosure
theorem balanced_lead_bounds :
    (11683 : ℝ)/100000 < pidLead (8/5) (1/4) 5 (pidRho (8/5) (1/4) 5 6) ∧
      pidLead (8/5) (1/4) 5 (pidRho (8/5) (1/4) 5 6) < 11685/100000 := by
  obtain ⟨hρ₁,hρ₂⟩ := balanced_rho_bounds
  obtain ⟨ha₁,ha₂,_,_⟩ := balanced_exp_bounds
  unfold pidLead
  norm_num
