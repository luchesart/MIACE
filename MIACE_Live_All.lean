  error_area : absArea (fun t => 1-y t) halfLine = α * storageArea a / (1+α)
  command_area : absArea (fun t => (1 + (1-y t)/α)-1) halfLine = storageArea a / (1+α)
  cost : miace α (fun t => 1-y t) (fun t => (1 + (1-y t)/α)-1) halfLine =
    storageArea a * minimum α
  command_bounds : ∀ t, 0 ≤ t → 1 ≤ 1 + (1-y t)/α ∧ 1 + (1-y t)/α ≤ 1 + 1/α
  command_peak : sSup ((fun t => 1 + (1-y t)/α) '' Ici (0 : ℝ)) = 1 + 1/α

