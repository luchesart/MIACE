    {v0 : ℝ → ℝ} (hNom : NominalCascadeIMC N σ F δ v0)
    (hbase : ∀ᵐ t, 0≤filterAction F (lagKernel 1) t) (hDC : filterTransfer F 0=1)
    (hq : imcDelayGain F ε<1) :
    IMCInternallyStable N σ F δ ε ∧
      ∃ w e v : ℝ → ℝ, IMCStepResponse N σ F δ ε w e v ∧
        absArea (fun t => v t-v0 t) halfLine≤(filterGain F)^2*|ε|/(1-imcDelayGain F ε) ∧
        absArea (fun t => e t-cascadeStepError N σ δ v0 t) halfLine≤
          2*filterGain F*|ε|/(1-imcDelayGain F ε) ∧
        |miace α e v halfLine-miace α (cascadeStepError N σ δ v0) v0 halfLine|≤
          filterGain F*|ε| *Real.sqrt (4+α*(filterGain F)^2)/(1-imcDelayGain F ε) := by
  have hs := serialRatios_normalized σ N hσ
  have hsp : ∀ τ∈serialRatios σ N, 0<τ := fun τ hτ => (hs τ hτ).1
  let ss := serialRatios σ N
  let P := shift δ (cascadeKernel ss)
  let Pe := shift (δ+ε) (cascadeKernel ss)
  let D := delayMismatchKernel ss δ ε
  have hK := cascadeKernel_properties ss hsp
  have hP : Integrable P := shift_integrable δ hK.1
  have hPe : Integrable Pe := shift_integrable (δ+ε) hK.1
  have hPc : Causal P := causal_shift hK.2.2.2 hδ
  have hPec : Causal Pe := causal_shift hK.2.2.2 hδε
  have hPF := filtered_delayed_kernel F ss hsp hδ hbase hDC
  obtain ⟨z,hz,hzc,hze,hzB⟩ := imc_step_auxiliary F ss hsp hδ hδε hq
  have hg := delayMismatch_step_properties ss hsp hδ hδε
  have hid := imc_perturbed_step_identity F hP hPe hPc hPec hz hzc hg.1 hze
  let c := filterAction F (filterAction F z)
  let E := filterAction F (fun t => z t-(P ⋆ filterAction F z) t)
  let e0 := causalize (cascadeStepError N σ δ v0)
  let V0 := causalize v0
  let e := fun t => e0 t-E t
  let v := fun t => V0 t-c t
  have hc : Integrable c := filterAction_integrable F (filterAction_integrable F hz)
  have hcc : Causal c := filterAction_causal F (filterAction_causal F hzc)
  have hPb := hP.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) (filterAction_integrable F hz)
  have hPbc : Causal (P ⋆ filterAction F z) :=
    ae_of_all volume (convolution_causal hPc (filterAction_causal F hzc))
  have hEi : Integrable E := filterAction_integrable F (hz.sub hPb)
  have hEc : Causal E := by
    apply filterAction_causal
    filter_upwards [hzc,hPbc] with t ht hs hn
    change z t-(P ⋆ filterAction F z) t=0
    rw [ht hn,hs hn,sub_self]
  have htransfer := ordinaryCascade_transfer_response hNom.command_integrable σ (N+1)
    (fun j hj => (hσ j (by omega)).1) hδ
