  have hb : ∀ t, 0≤t → 0≤X 1 t ∧ X 1 t≤1 := by
    intro t ht; rw [h₁ t ht]; exact hp.2 t ht
  have hstates := cascade_preserves_monotone N (fun j => σ (j+1)) (fun j => X (j+1))
    (fun j hj => hσ (j+1) (by omega))
    (fun j _ => (ordinary_lag_regular (ordinaryCascade_local hu σ j) (σ j)).1.continuousOn)
    (fun _ _ => rfl) hm hb N le_rfl
  have hP := ordinaryCascade_transfer_response hv σ (N+1) (fun j hj => hσ j (by omega)) hδ
  have hy := cascade_delayed_monotone hstates.1 (fun t ht => (hstates.2 t ht).1) (δ := δ)
  have hEn : ∀ t, 0≤t → 0≤E t := by
    intro t ht
    by_cases htd : t≤δ
    · simp [E,delayedError,htd]
    · change 0≤delayedError δ (fun t => 1-X (N+1) t) t
      simp only [delayedError,if_neg htd]
      linarith [(hstates.2 (t-δ) (by linarith)).2]
  have hlim := monotone_error_settles hP.error_integrable hEn
    (fun a _ b _ hab => by have hh := hy hab; dsimp only at hh; linarith)
  refine ⟨hP,hEn,hy,by simp [delayedError,hδ],?_,?_⟩
  · simpa using tendsto_const_nhds.sub hlim
  · have hAe : absArea E halfLine=∫ t, E t ∂halfLine := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact abs_of_nonneg (hEn t (show 0<t from ht).le)
    have hAv : absArea v halfLine=∫ t, v t ∂halfLine := by
      apply integral_congr_ae
      filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
      exact abs_of_nonneg (hvn t (show 0<t from ht).le)
    change absArea E halfLine=cascadeMean σ (N+1)+δ-absArea v halfLine
    rw [hAe,hAv]
    have hh := transfer_signed_balance hP (cascadeMean σ (N+1))
      (cascadeTransfer_derivative σ (N+1)) (cascadeTransfer_zero σ (N+1))
    linarith

