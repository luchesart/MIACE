-- @paper-step thm:miace/physical_step_normalization
theorem pi_physical_absolute_areas {x r : ℝ} {e i : ℝ → ℝ}
    (h : PIStateResponse x r e i) (hx : 0 < x) (hr : 0 < r)
    (a τ k : ℝ) (ha : a ≠ 0) (hτ : 0 < τ) (hk : 0 < k) :
