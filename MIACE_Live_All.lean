      ∀ p : ℂ, -η ≤ p.re →
        ‖complexLaplace (twoRateK (twoRateA ρ l m) l m δ) p‖<1 ∧
        pidCharacteristic i ρ ell δ p ≠ 0 ∧
        (p+1)*pidCharacteristic i ρ ell δ p/(ρ : ℂ) ≠ 0 := by
  let A := twoRateA ρ l m
  have hK := twoRateK_integrable A l m δ
  have hc := twoRateK_causal A l m δ
  have hA := twoRateA_ge_one h.ordered_rates h.filter_lower
  have hn : ∀ᵐ t, 0 ≤ twoRateK A l m δ t := ae_of_all volume
    (twoRateK_nonneg hA h.lower_rate h.ordered_rates.le
      (twoRate_rate_condition h.ordered_rates h.filter_upper))
  obtain ⟨η,hη,hle,hw,hq⟩ := expWeight_small_mass hK
    (twoRateK_small hA h.ordered_rates.le h.delay_nonneg)
    (by norm_num : (0 : ℝ)<1/2) (twoRateK_weighted A l m δ (1/2))
  refine ⟨η,hη,hle,?_⟩
  intro p hp
  have hlp := complex_rate_ne_zero (by linarith [h.lower_rate] : η<l) hp
  have hmp := complex_rate_ne_zero (by linarith [h.lower_rate,h.ordered_rates] : η<m) hp
  have h1p : p+1 ≠ 0 := by simpa using complex_rate_ne_zero (by linarith : η<(1 : ℝ)) hp
  have hr : (ρ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt h.filter_pos)
  have hchar : pidCharacteristic i ρ ell δ p ≠ 0 := by
    rw [twoRate_complex_characteristic_factor h hlp hmp]
    exact mul_ne_zero (mul_ne_zero (mul_ne_zero hr hlp) hmp)
      (complex_resolvent_ne_zero hc hn hw hq hp)
  exact ⟨(complex_laplace_norm_le hc hn hw hp).trans_lt hq,hchar,
    div_ne_zero (mul_ne_zero h1p hchar) hr⟩

