noncomputable def rationalCascadeTimes (r : ℕ → ℝ) : ℕ → ℝ
  | 0 => 1
  | j+1 => 1/r j

noncomputable def rationalCascadeError (r : ℕ → ℝ) (n : ℕ) (δ : ℝ)
    (v : ℝ → ℝ) : ℝ → ℝ :=
  delayedError δ (fun t => 1-ordinaryCascade (rationalCascadeTimes r)
    (fun s => 1+v s) (n+2) t)

-- @paper-step thm:n_construction/physical_cascade_positive_time_constants
theorem rationalCascadeTimes_pos (r : ℕ → ℝ) (n : ℕ) (hr : ∀ j≤n, 0<r j) :
    ∀ j≤n+1, 0<rationalCascadeTimes r j := by
  intro j hj
  cases j with
  | zero => norm_num [rationalCascadeTimes]
  | succ j => exact one_div_pos.mpr (hr j (by omega))

-- @paper-step thm:n_construction/physical_cascade_mean_matches_article
theorem rationalCascadeMean (r : ℕ → ℝ) (n : ℕ) :
    cascadeMean (rationalCascadeTimes r) (n+2)=1+∑ j∈Finset.range (n+1), 1/r j := by
  induction n with
  | zero => simp [cascadeMean,Finset.sum_range_succ,rationalCascadeTimes]
  | succ n ih =>
    have he : cascadeMean (rationalCascadeTimes r) (n+1+2)=
        cascadeMean (rationalCascadeTimes r) (n+2)+1/r (n+1) := by
      simp [cascadeMean,Finset.sum_range_succ,rationalCascadeTimes]
    rw [he,ih]
    simp only [Finset.sum_range_succ]
    ring

-- @paper-step thm:n_construction/physical_cascade_transfer_matches_article
theorem rationalCascadeTransfer (r : ℕ → ℝ) (n : ℕ) (p : ℝ) :
    cascadeTransfer (rationalCascadeTimes r) (n+2) p=
      1/((1+p)*(remainderB r n).eval p) := by
  induction n with
  | zero => simp [cascadeTransfer,rationalCascadeTimes,remainderB]; ring
  | succ n ih =>
    change cascadeTransfer (rationalCascadeTimes r) (n+2) p /
      (1+(1/r (n+1))*p)=_
    rw [ih,remainderB,eval_mul,eval_add,eval_mul,eval_C,eval_X,eval_one]
    rw [div_div]
    congr 1
    ring

-- @paper-step thm:n_construction/positive_real_axis_cascade_denominator
theorem remainderB_eval_pos (r : ℕ → ℝ) (n : ℕ) (hr : ∀ j≤n, 0<r j)
    {p : ℝ} (hp : 0≤p) : 0<(remainderB r n).eval p := by
