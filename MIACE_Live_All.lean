    (convolution_pointwise_nonneg hK hRn t)

/-- The exact parity test displayed in Theorem 17, in the n=N-2 convention. -/
def CascadeParityTest (J : ℝ → ℝ) (δ a ε : ℝ) : Prop :=
  (ε=1 ∧ ∃ l : ℝ, 0<l ∧ 1-compactMoment J δ 0+compactExpMoment J δ l≤a*l) ∨
  (ε= -1 ∧ compactExpMoment (compactTail J δ) δ
    ((1+compactMoment J δ 0)/a)≤1-a)

-- @paper-step thm:n_construction/both_parities_ordinary_inverse_and_command_sign
theorem cascade_ordinary_inverse_and_command {J : ℝ → ℝ} (hc : Continuous J)
    {δ a ε : ℝ} (hδ : 0≤δ) (ha : 0<a) (ha1 : a<1)
    (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) (hpar : CascadeParityTest J δ a ε) :
    ∃ R : ℝ → ℝ,
      CompactResolventEvolution J δ a (1-ε*compactMoment J δ 0) ε R ∧
      Integrable (causalize R) ∧
      (∃ η : ℝ, 0<η ∧ Integrable (expWeight η (causalize R))) ∧
      (∀ t, 0≤t → 0≤R t) ∧ (∫ t, R t ∂halfLine)=1 ∧
