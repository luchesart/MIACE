-- Uniform exponential stability of the ordinary IMC realization. The state
-- functions are the actual variation-of-constants solutions, including every
-- plant/model storage state, filter storage state and all finite delay histories.
def IMCInternallyStable (N : ℕ) (σ : ℕ → ℝ) (F : IMCFilter) (δ ε : ℝ) : Prop :=
  ∃ η C : ℝ, 0<η ∧ 0≤C ∧ ∀ M H, IMCHistoryBound N F δ ε H M →
    ∃ u : ℝ → ℝ, Integrable u ∧ Causal u ∧ u=ᵐ[volume] imcFeedback N σ F δ ε H u ∧
      IMCInternalControl N σ F δ ε H u η (C*M) ∧
      ∀ v : ℝ → ℝ, LocallyIntegrable v volume → Causal v →
        v=ᵐ[volume] imcFeedback N σ F δ ε H v → v=ᵐ[volume] u

