theorem boundary_pulse_moment {c : ℝ} (hc : 0<c) :
    moment (pulse c (Real.log (1+1/c)))=1 := by
  have hlog : 0≤Real.log (1+1/c) := Real.log_nonneg (by linarith [one_div_pos.mpr hc])
  rw [pulse_moment c _ hlog,Real.exp_log (by positivity : 0<1+1/c)]
