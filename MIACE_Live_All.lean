      (serialState σ H.plantInitial u (j+1)) ∧
      ∀ t, 0≤t → |serialState σ H.plantInitial u (j+1) t|≤C*Real.exp (-η*t)) ∧
    (∀ j≤N, LagEvolution (σ j) (H.modelInitial j) (serialState σ H.modelInitial u j)
      (serialState σ H.modelInitial u (j+1)) ∧
      ∀ t, 0≤t → |serialState σ H.modelInitial u (j+1) t|≤C*Real.exp (-η*t)) ∧
