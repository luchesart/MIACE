    have hden : 1+σ n*p≠0 := ne_of_gt (by positivity)
    field_simp [ne_of_gt hp,hden] at hi ⊢
    nlinarith

-- @paper-step thm:complete_attainment/ordinary_cascade_transfer_response
theorem ordinaryCascade_transfer_response {v : ℝ → ℝ} (hv : Integrable v)
    (σ : ℕ → ℝ) (n : ℕ) (hσ : ∀ j<n, 0<σ j) {δ : ℝ} (hδ : 0≤δ) :
    TransferResponse (delayedError δ (fun t => 1-ordinaryCascade σ (fun s => 1+v s) n t))
