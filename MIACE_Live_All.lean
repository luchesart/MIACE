    hHi.locallyIntegrable.add (scalarDelay_shift_local hw.continuous δ)
  have hI := remainderFilter_evolution hw.continuous.locallyIntegrable r δ H.controllerInitial
  constructor
  · intro k
    rcases k with u | (j | j)
    · exact hw.continuous
    · exact remainderFilter_local hw.continuous.locallyIntegrable r δ H.controllerInitial j
    · exact (serialState_evolution hu (fun j => 1/r j) H.plantInitial j).1
  · intro k T hT
    rcases k with u | (j | j)
    · exact hw.ac T hT
    · cases hj : j.val with
      | zero => exact (hj ▸ hI.1).ac T hT
      | succ m => exact (hj ▸ hI.2 m).ac T hT
    · exact (serialState_evolution hu (fun j => 1/r j) H.plantInitial j).2.ac T hT

