  refine ⟨div_pos (by linarith) hden,div_pos (sub_pos.mpr hrl) (mul_pos hr hden),?_,?_⟩
  · unfold explicitA explicitB
    field_simp
    <;> ring
  · unfold explicitA explicitB
    field_simp
    <;> ring

-- @paper-step thm:pid_explicit_family/positive_physical_controller_coefficients
theorem explicitPID_controller_coefficients {i ρ ell l δ : ℝ} (h : ExplicitPIDData i ρ ell l δ) :
    0< i+ρ^2 ∧ 0< i*ρ^2 ∧
