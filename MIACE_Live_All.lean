    hHi.locallyIntegrable.add (scalarDelay_shift_local hw.continuous δ)
  have huW : LocallyIntegrable (rationalDelayed δ H W) volume :=
    hHi.locallyIntegrable.add (scalarDelay_shift_local hW.continuous δ)
  have hIw := remainderFilter_evolution hw.continuous.locallyIntegrable r δ H.controllerInitial
  have hIW := remainderFilter_evolution hW.continuous.locallyIntegrable r δ H.controllerInitial
