  have ha : 0<α := lt_trans he hα
  have hd : 0<δ := lt_trans (one_div_pos.mpr ha) hδ
  have hd1 : 0<1+δ := by linarith
  have hg : delayedPIGain α δ=(α+1)/(α*(1+δ)) := by unfold delayedPIGain; field_simp
  have hi := delayedPIGain_pos ha hd.le
  have hi1 : delayedPIGain α δ<1 := by
    rw [delayedPIGain,div_lt_iff₀ hd1]; linarith
  refine ⟨hi,hi1,rfl,rfl,one_div_pos.mpr hd,hd,by field_simp,?_,?_⟩
  · rw [Real.exp_neg,← one_div,div_mul_eq_mul_div]
    apply (le_div_iff₀ hd).mpr
    simpa using hδ1
  · have hden : 0<α+1-Real.exp 1 := by linarith
    have hh := (le_div_iff₀ hden).mp hδ2
    rw [hg]
    field_simp
    nlinarith

-- @paper-step thm:pid_explicit_family/strict_filter_and_lead_order
theorem explicitPID_order {i ρ ell l δ : ℝ} (h : ExplicitPIDData i ρ ell l δ) :
    0<ρ ∧ ρ<ell ∧ ell<1/l ∧ ρ<1 ∧ 0<1-l*ρ := by
