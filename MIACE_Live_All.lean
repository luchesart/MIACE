    fun_prop
  refine ⟨y, hyC, ?_, ?_, ?_⟩
  · simp [y, hs0]
  · intro t ht
    have hs := (hsb t ht).1
    convert ((hsder t).neg.exp).const_sub (1 : ℝ) using 1
    dsimp [y]
    simp only [nonlinearClockRate, nonlinearClippedPhase, max_eq_left hs, inv_inv]
