    apply mul_pos (ih (fun j hj => hr j (by omega)))
    have := one_div_pos.mpr (hr (n+1) le_rfl)
    positivity

-- @paper-step thm:n_construction/actual_rational_controller_feedback_transform
theorem rationalCascade_feedback_identity (r : ℕ → ℝ) (n : ℕ) {δ U : ℝ}
    (hr : ∀ j≤n, 0<r j) {R v : ℝ → ℝ}
    (hP : TransferResponse (rationalCascadeError r n δ v) v
      (cascadeTransfer (rationalCascadeTimes r) (n+2)) δ)
    (hT : ∀ p : ℝ, 0<p → (1+p)*laplace R p=1+p*laplace v p)
