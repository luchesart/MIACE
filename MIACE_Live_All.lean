    rw [(explicitPID_scaled_coefficients h).1]
    have hiEq : i=1-ρ := by linarith [h.filter_eq]
    rw [hiEq]
    have hdn : 1-ρ*l≠0 := by nlinarith
    field_simp [ne_of_gt hden,hdn]
    <;> ring
  rw [hc]
  exact div_nonneg (sub_nonneg.mpr h.command_tail) (mul_pos hl hden).le

-- @paper-step thm:pid_explicit_family/tail_command_forcing_formula
theorem explicitR_tail {i ρ ell l δ t : ℝ} (h : ExplicitPIDData i ρ ell l δ)
    (htd : δ≤t) :
    explicitR i ρ ell l δ t=
      (i*explicitA ρ ell l*(1+(Real.exp 1-1)/l)-1)*Real.exp (-l*t)+
      i*explicitB ρ ell l*(1+ρ*(Real.exp (δ/ρ)-1))*Real.exp (-(1/ρ)*t) := by
  have ht : 0≤t := h.delay_pos.le.trans htd
  have hr := (explicitPID_order h).1
  have hl := h.rate_pos
