theorem twoRate_derivative (A l m t : ℝ) :
    HasDerivAt (twoRateG A l m) (-twoRateD A l m t) t := by
  have hl := (((hasDerivAt_id t).const_mul (-l)).exp).const_mul A
  have hm := (((hasDerivAt_id t).const_mul (-m)).exp).const_mul (1-A)
  convert hl.add hm using 1
  · rfl
  · dsimp [twoRateD]
    ring

-- @paper-step thm:pid_two_rate_optimum/continuity
theorem twoRate_continuous (A l m : ℝ) :
