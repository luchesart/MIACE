noncomputable def restPolynomial (ss : List ℝ) (p : ℝ) : ℝ :=
  (ss.map (fun σ => 1+σ*p)).prod
noncomputable def imcControllerTransfer (F : IMCFilter) (P : ℝ → ℝ) (p : ℝ) : ℝ :=
  filterTransfer F p/(1-P p*filterTransfer F p)

-- @paper-step thm:complete_attainment/remaining_lag_polynomial_bound
theorem restPolynomial_ge_one (ss : List ℝ) (hs : ∀ σ∈ss, 0<σ) {p : ℝ} (hp : 0≤p) :
    1≤restPolynomial ss p := by
  induction ss with
  | nil => simp [restPolynomial]
  | cons σ ss ih =>
    have hσ := hs σ (by simp)
    have hb := ih (fun τ hτ => hs τ (by simp [hτ]))
    have hsp := mul_nonneg hσ.le hp
    change 1≤(1+σ*p)*restPolynomial ss p
    nlinarith

-- @paper-step thm:complete_attainment/finite_inverse_lag_product
theorem inverse_lag_product (ss : List ℝ) (p : ℝ) :
    (ss.map (fun σ => 1/(1+σ*p))).prod=1/restPolynomial ss p := by
  induction ss with
  | nil => simp [restPolynomial]
  | cons σ ss ih =>
    change (1/(1+σ*p))*(ss.map (fun τ => 1/(1+τ*p))).prod=
      1/((1+σ*p)*restPolynomial ss p)
    rw [ih]
    exact one_div_mul_one_div _ _

-- @paper-step thm:complete_attainment/actual_cascade_polynomial_transfer
theorem cascadeKernel_polynomial_transfer (ss : List ℝ) (hs : ∀ σ∈ss, 0<σ)
    {p : ℝ} (hp : 0≤p) :
    laplace (cascadeKernel ss) p=1/((1+p)*restPolynomial ss p) := by
  rw [cascadeKernel_laplace ss hs hp,inverse_lag_product]
  exact one_div_mul_one_div _ _

-- @paper-step thm:complete_attainment/ordinary_IMC_to_output_feedback_algebra
theorem imc_output_feedback_algebra (F P E U : ℝ) (h : U=F*(E+P*U))
    (hden : 1-P*F≠0) : U=(F/(1-P*F))*E := by
  rw [div_mul_eq_mul_div]
  apply (eq_div_iff hden).mpr
  nlinarith

-- @paper-step thm:complete_attainment/exact_nominal_output_transfer
theorem exponentialIMC_output_transfer (ss : List ℝ) (hs : ∀ σ∈ss, 0<σ)
    {a δ p : ℝ} (ha : 0<a) (hδ : 0≤δ) (hp : 0≤p) :
    laplace (shift δ (cascadeKernel ss)) p*filterTransfer (exponentialIMC a ha) p=
      Real.exp (-δ*p)/(restPolynomial ss p*(1+a*p)) := by
