  refine ⟨hm,by simp [delayedError,hδ],?_,?_,fun t => hm.deriv_nonneg,?_⟩
  · have hshift : Tendsto (fun t : ℝ => t-δ) atTop atTop := by
      apply tendsto_atTop.2
      intro b
      filter_upwards [eventually_ge_atTop (b+δ)] with t ht
      linarith
    apply (hfinal.comp hshift).congr'
    filter_upwards [eventually_gt_atTop δ] with t ht
    simp [delayedError,not_le.mpr ht]
  · intro t
    by_cases ht : t ≤ δ
    · simp [delayedError,ht]
    · simp only [delayedError,ht,ite_false,sub_sub_cancel]
      exact ⟨hcs.1 (t-δ) (by linarith),hupper (t-δ) (by linarith)⟩
  · unfold backwardMotion negArea
    apply integral_eq_zero_of_ae
    exact Eventually.of_forall (fun t => max_eq_right (neg_nonpos.mpr hm.deriv_nonneg))
end MIACE

