namespace MIACE
open Matrix
open scoped Matrix

noncomputable def pidStateA0 (ρ : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![-1,0,0; -1,0,0; -1/ρ,0,-1/ρ]
noncomputable def pidStateA1 (pc i dc ρ : ℝ) : Matrix (Fin 3) (Fin 3) ℝ :=
  !![-(pc+dc/ρ),i,-dc/ρ; 0,0,0; 0,0,0]
noncomputable def pidHomogeneousCommand (pc i dc ρ : ℝ) (x : Fin 3 → ℝ) : ℝ :=
  -pc*x 0+i*x 1+(dc/ρ)*(-x 0-x 2)
noncomputable def pidStateSymbol (pc i dc ρ δ : ℝ) (p : ℂ) : Matrix (Fin 3) (Fin 3) ℂ :=
  p • (1 : Matrix (Fin 3) (Fin 3) ℂ)-(pidStateA0 ρ).map Complex.ofReal-
    Complex.exp (-(δ : ℂ)*p) • (pidStateA1 pc i dc ρ).map Complex.ofReal

-- @paper-step thm:pid_two_rate_optimum/physical_three_state_equations
theorem pid_state_equations (pc i dc ρ : ℝ) (x xd : Fin 3 → ℝ) :
    (pidStateA0 ρ).mulVec x+(pidStateA1 pc i dc ρ).mulVec xd=
      ![-x 0+pidHomogeneousCommand pc i dc ρ xd,-x 0,(-x 0-x 2)/ρ] := by
  ext k
  fin_cases k <;> simp [pidStateA0,pidStateA1,pidHomogeneousCommand,Matrix.mulVec,
    dotProduct,Fin.sum_univ_succ] <;> ring

-- @paper-step thm:pid_two_rate_optimum/full_physical_characteristic_determinant
theorem pid_state_determinant (pc i dc δ : ℝ) {ρ : ℝ} (hρ : ρ ≠ 0) (p : ℂ) :
    (pidStateSymbol pc i dc ρ δ p).det=
