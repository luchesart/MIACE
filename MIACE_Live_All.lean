  refine ⟨(((lagKernel_properties hσ).1.const_mul σ).mono_measure Measure.restrict_le_self).congr he.symm,?_⟩
  rw [laplace_congr_halfLine he,laplace_smul,lagKernel_laplace hσ hp]
  ring

-- @paper-step thm:complete_attainment/lag_deficit_transform
theorem lag_deficit_transform {u : ℝ → ℝ} (hu : LocallyIntegrable u volume)
    (he : Integrable (fun t => 1-u t) halfLine) {σ p : ℝ} (hσ : 0<σ) (hp : 0≤p) :
    laplace (fun t => 1-lag σ u t) p=(σ+laplace (fun t => 1-u t) p)/(1+σ*p) := by
