    funext (lag_deficit hu hσ)
  rw [hf,laplace]
  simp_rw [mul_add]
  rw [integral_add (laplace_integrable hexp.1 hp)
    (laplace_integrable (lag_integrable he hσ) hp)]
  change laplace (fun t : ℝ => Real.exp (-t/σ)) p+laplace (lag σ (fun s => 1-u s)) p=_
  rw [hexp.2,lag_laplace he hσ hp]
  ring

-- @paper-step thm:complete_attainment/cascade_actual_step_transform
theorem ordinaryCascade_transform {v : ℝ → ℝ} (hv : Integrable v)
    (σ : ℕ → ℝ) (n : ℕ) (hσ : ∀ j<n, 0<σ j) {p : ℝ} (hp : 0<p) :
    1/p-laplace (fun t => 1-ordinaryCascade σ (fun s => 1+v s) n t) p=
      cascadeTransfer σ n p*(1/p+laplace v p) := by
