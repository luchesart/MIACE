    fun hf => causal_linear (hA.causal hf) (hB.causal hf) a b,?_,?_⟩
  · intro f g he
    filter_upwards [hA.congr he,hB.congr he] with t ht hs
    rw [ht,hs]
  · intro f hf T
    filter_upwards [hA.locality hf T,hB.locality hf T] with t ht hs htT
    rw [ht htT,hs htT]

-- @paper-step thm:complete_robust/local_kernel_difference_identity
theorem local_kernel_sub {K H u : ℝ → ℝ}
    (hK : Integrable K) (hH : Integrable H) (hKc : Causal K) (hHc : Causal H)
    (hu : LocallyIntegrable u volume) (huc : Causal u) :
    ((fun t => K t-H t) ⋆ u)=ᵐ[volume] (fun t => (K ⋆ u) t-(H ⋆ u) t) := by
  have hDc : Causal (fun t => K t-H t) := by
    filter_upwards [hKc,hHc] with t ht hs hn; simp [ht hn,hs hn]
  have hB := causalLocalOperator_linear (convolution_local_operator hK hKc)
    (convolution_local_operator hH hHc) 1 (-1)
  have hh := causalLocalOperator_ext (convolution_local_operator (hK.sub hH) hDc) hB
    (fun f hf hfc => by
      filter_upwards [hK.ae_convolution_exists (ContinuousLinearMap.lsmul ℝ ℝ) hf,
        hH.ae_convolution_exists (ContinuousLinearMap.lsmul ℝ ℝ) hf] with t ht hs
      change (∫ s, (K s-H s)*f (t-s))=1*(∫ s, K s*f (t-s))+(-1)*(∫ s, H s*f (t-s))
