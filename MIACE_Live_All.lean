theorem scalarDelay_strict_positive {x δ : ℝ} (hx : 0<x) (hδ : 0<δ)
    {E : ℝ → ℝ} (h : ScalarDelayResponse x δ E)
    (hn : ∀ t, 0≤t → 0≤E t) : ∀ t, 0≤t → 0<E t := by
  intro t ht
  by_contra hp
  have hz : E t=0 := le_antisymm (le_of_not_gt hp) (hn t ht)
  let Z := Icc (0 : ℝ) t ∩ E ⁻¹' {0}
  have hZ : IsCompact Z := isCompact_Icc.inter_right
    (isClosed_singleton.preimage h.continuous)
  obtain ⟨c,hc,hmin⟩ := hZ.exists_isMinOn ⟨t,⟨⟨ht,le_rfl⟩,hz⟩⟩ continuous_id.continuousOn
  have hc0 : 0≤c := hc.1.1
  have hcz : E c=0 := hc.2
  have hcδ : δ<c := by
    by_contra hh
    have hh := scalarDelay_plateau h hc0 (le_of_not_gt hh)
    linarith
  have hprev : 0<E (c-δ) := by
    have hp0 := hn (c-δ) (by linarith)
    by_contra hh
    have he : E (c-δ)=0 := le_antisymm (le_of_not_gt hh) hp0
    have hh := hmin (show c-δ∈Z from ⟨⟨by linarith,by have := hc.1.2; linarith⟩,he⟩)
    change c≤c-δ at hh
    linarith
  have hlocal : IsLocalMin E c := by
    filter_upwards [Ioi_mem_nhds (hδ.trans hcδ)] with s hs
    simpa [hcz] using hn s hs.le
  have hd := hlocal.hasDerivAt_eq_zero (scalarDelay_derivative_after hδ.le h hcδ)
  nlinarith

-- @paper-step lem:delayed_cancellation/local_delay_increment_identity
theorem scalarDelay_increment {x δ : ℝ} (hδ : 0≤δ) {E : ℝ → ℝ}
    (h : ScalarDelayResponse x δ E) {t u : ℝ} (ht : δ≤t) (hu : δ≤u) :
    E t-E u=x*(∫ s in (t-δ)..(u-δ), E s) := by
  have he (s : ℝ) (hs : δ≤s) : E s=1-x*(∫ v in 0..(s-δ), E v) := by
    have hh := h.integral_eq ((s-δ)+δ) (by linarith : 0≤(s-δ)+δ)
    rw [scalarDelay_shift_primitive E hδ (by linarith)] at hh
    simpa using hh
  rw [he t ht,he u hu]
  have hi := intervalIntegral.integral_add_adjacent_intervals
    (h.continuous.intervalIntegrable (μ := volume) 0 (t-δ))
    (h.continuous.intervalIntegrable (t-δ) (u-δ))
  linear_combination -x*hi

-- @paper-step lem:delayed_cancellation/uniform_half_delay_ratio_bound
theorem scalarDelay_half_bound {x δ : ℝ} (hx : 0<x) (hδ : 0<δ)
    {E : ℝ → ℝ} (h : ScalarDelayResponse x δ E)
    (hn : ∀ t, 0≤t → 0≤E t) {t : ℝ} (ht : δ≤t) :
    (x*δ/2)*E (t-δ/2)≤E t := by
  have hm := scalarDelay_antitone_local hx h hn
  have hi := intervalIntegral.integral_mono_on (by linarith : t-δ≤t-δ/2)
    (intervalIntegrable_const (μ := volume) (c := E (t-δ/2)))
    (h.continuous.intervalIntegrable (t-δ) (t-δ/2))
    (fun s hs => hm (by change 0≤s; have := hs.1; linarith)
      (by change 0≤t-δ/2; linarith) hs.2)
