  have hp1 : 1+p≠0 := by positivity
  have ha1 : 1+a*p≠0 := by positivity
  rw [laplace_shift (cascadeKernel_properties ss hs).2.2.2 hδ p,
    cascadeKernel_polynomial_transfer ss hs hp,exponentialIMC_transfer ha hp]
  field_simp <;> ring

-- @paper-step thm:complete_attainment/exact_displayed_controller_transfer
theorem exponentialIMC_controller_transfer (ss : List ℝ) (hs : ∀ σ∈ss, 0<σ)
    {a δ p : ℝ} (ha : 0<a) (hδ : 0≤δ) (hp : 0<p) :
    imcControllerTransfer (exponentialIMC a ha) (laplace (shift δ (cascadeKernel ss))) p=
      (1+p)*restPolynomial ss p/((1+a*p)*restPolynomial ss p-Real.exp (-δ*p)) := by
  have hB1 := restPolynomial_ge_one ss hs hp.le
  have hB : restPolynomial ss p≠0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hB1)
  have hp1 : 1+p≠0 := by positivity
  have ha1 : 1+a*p≠0 := by positivity
