    (fun u hu => compactTail_nonneg hu.1 hu.2 hn) s
  have hRn (s : ℝ) : 0≤causalize R s := by
    by_cases hs : 0≤s
    · simpa [causalize,hs] using hR s hs
    · simp [causalize,hs]
  have hb (s : ℝ) : K s*causalize R (t-s)≤expWeight (c/a) K s*R t := by
    by_cases hs : s∈Icc (0 : ℝ) δ
