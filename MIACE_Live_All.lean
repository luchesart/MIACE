      (pidRho (8/5) (1/4) 5 6) (pidLead (8/5) (1/4) 5 (pidRho (8/5) (1/4) 5 6)) 5 6 (1/4) := by
    convert balanced_twoRate_data using 1 <;> norm_num
  obtain ⟨E,V,hs,he,hv,hc,_⟩ := twoRate_ordinary_optimum (by norm_num : (0 : ℝ)<1) h
  refine ⟨E,V,?_,?_,?_,?_⟩
