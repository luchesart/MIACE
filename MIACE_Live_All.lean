-- @paper-step thm:complete_cap/full_boundary_command_uniqueness
theorem paper_complete_cap_unique (N : ℕ) (σ : ℕ → ℝ) {δ c : ℝ} {v : ℝ → ℝ}
    (hδ : 0≤δ) (hc : 0<c) (hσ : ∀ j≤N, 0<σ j ∧ σ j≤1) (hfirst : σ 0=1)
    (hv : Integrable v) (hcap : ∀ᵐ t ∂halfLine, 0≤v t ∧ v t≤c)
    (he : ∀ t, 0≤t → 0≤cascadeStepError N σ δ v t)
    (harea : commandArea v=c*Real.log (1+1/c)) :
    v=ᵐ[halfLine] pulse c (Real.log (1+1/c)) := by
  have hm := cascade_nonovershoot_moment N σ hδ hσ hfirst hv (hcap.mono (fun _ ht => ht.1)) he
  have hlog : 0≤Real.log (1+1/c) := Real.log_nonneg (by linarith [one_div_pos.mpr hc])
  have hmin := pulse_minimizes_moment c (Real.log (1+1/c)) hlog hv.integrableOn hm.1 hcap harea
  have hpm := boundary_pulse_moment hc
  have hl : 1≤moment v := by
    rw [← pulse_moment c _ hlog] at hmin
    rwa [hpm] at hmin
  apply pulse_unique_of_equal_moment c _ hv.integrableOn hm.1 hcap
  · rwa [pulse_area c _ hlog]
  · rw [hpm]; exact le_antisymm hm.2 hl

