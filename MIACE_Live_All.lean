-- @paper-step thm:pid_two_rate_optimum/exponential_finite_integral
theorem finite_exp_integral {r : ℝ} (hr : r ≠ 0) (δ : ℝ) :
    (∫ t in 0..δ, Real.exp (-r*t))=(1-Real.exp (-r*δ))/r := by
  have hd (t : ℝ) : HasDerivAt (fun s : ℝ => Real.exp (-r*s)/(-r)) (Real.exp (-r*t)) t := by
    convert ((((hasDerivAt_id t).const_mul (-r)).exp).div_const (-r)) using 1
    · rfl
    · dsimp
      field_simp
  have he := intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hd t)
    ((by fun_prop : Continuous (fun t : ℝ => Real.exp (-r*t))).intervalIntegrable 0 δ)
  rw [he]
  simp only [mul_zero,Real.exp_zero]
  field_simp
  <;> ring

-- @paper-step thm:pid_two_rate_optimum/forcing_finite_integral
theorem twoRateG_finite_integral (A : ℝ) {l m : ℝ} (hl : l ≠ 0) (hm : m ≠ 0) (δ : ℝ) :
