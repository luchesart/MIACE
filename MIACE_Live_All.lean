-- @paper-step thm:n_construction/even_parity_pointwise_tail_convolution_bound
theorem even_resolvent_tail_bound {J : ℝ → ℝ} (hc : Continuous J) {δ a c : ℝ}
    (hδ : 0≤δ) (ha : 0<a) (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
    (h : CompactResolventEvolution J δ a c (-1) R)
    (hR : ∀ t, 0≤t → 0≤R t) {t : ℝ} (ht : 0≤t) :
    (compactKernel (compactTail J δ) δ ⋆ causalize R) t≤
      compactExpMoment (compactTail J δ) δ (c/a)*R t := by
