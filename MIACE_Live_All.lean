      have hl : Integrable (fun t => Real.exp t*v t-Real.exp t*pulse c T t) halfLine := hJ.sub hJp
      have hr : Integrable (fun t => Real.exp T*(v t-pulse c T t)) halfLine := (hv.sub hp).const_mul _
