-- @paper-step thm:miace/physical_absolute_scaling
theorem physical_absolute_scaling (f : ℝ → ℝ) (a τ k : ℝ) (hτ : 0 < τ) (hk : 0 < k) :
    absArea (fun t => a*f (t/τ)/k) halfLine=(|a| *τ/k)*absArea f halfLine := by
