structure DelayedPIAsymptoticallyStable (x δ : ℝ) : Prop where
  history_exists : ∀ φ ψ : ℝ → ℝ,
    ContinuousOn φ (Icc (-δ) 0) → ContinuousOn ψ (Icc (-δ) 0) →
    ∃ y z : ℝ → ℝ, DelayedPIEvolution x δ y z ∧
      EqOn y φ (Icc (-δ) 0) ∧ EqOn z ψ (Icc (-δ) 0)
  history_unique : ∀ y z Y Z : ℝ → ℝ,
    DelayedPIEvolution x δ y z → DelayedPIEvolution x δ Y Z →
    EqOn y Y (Icc (-δ) 0) → EqOn z Z (Icc (-δ) 0) →
    EqOn y Y (Ici 0) ∧ EqOn z Z (Ici 0)
  uniform_stability : ∃ K : ℝ, 0<K ∧ ∀ (M : ℝ) (y z : ℝ → ℝ),
    0≤M → DelayedPIEvolution x δ y z →
    (∀ t∈Icc (-δ) 0, |y t|≤M ∧ |z t|≤M) →
    ∀ t, 0≤t → (y t)^2+(z t)^2≤K*M^2
  attraction : ∀ y z : ℝ → ℝ, DelayedPIEvolution x δ y z →
    Tendsto y atTop (𝓝 0) ∧ Tendsto z atTop (𝓝 0)
  transport_attraction : ∀ y z : ℝ → ℝ, DelayedPIEvolution x δ y z →
    ∀ ε : ℝ, 0<ε → ∃ T : ℝ, ∀ t, T≤t → ∀ s∈Icc (-δ) 0,
      |y (t+s)|<ε ∧ |z (t+s)|<ε

