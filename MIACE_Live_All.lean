        (P (τ*s)*C (τ*s))/(1+P (τ*s)*C (τ*s)) := by
  have he : (k*P (τ*s))*(C (τ*s)/k)=P (τ*s)*C (τ*s) := by field_simp
  exact ⟨he,by rw [he]⟩

