-- @paper-step thm:complete_robust/weighted_triangle
theorem weighted_triangle (α a b c d : ℝ) (hα : 0 ≤ α) :
    Real.sqrt (a^2+α*b^2) ≤
      Real.sqrt (c^2+α*d^2) + Real.sqrt ((a-c)^2+α*(b-d)^2) := by
