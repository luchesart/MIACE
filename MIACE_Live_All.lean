theorem delayedPI_history_unique {x δ : ℝ} (hx : 0<x) (hδ : 0≤δ)
    {y z Y Z : ℝ → ℝ} (he : DelayedPIEvolution x δ y z)
    (hE : DelayedPIEvolution x δ Y Z)
