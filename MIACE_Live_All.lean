/-! Stage 13. Concrete causal filters: feedthrough, a finite transport,
and one stable lag. The two filters in the paper are instances. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

noncomputable def shiftOp (δ : ℝ) : RealL1 →L[ℝ] RealL1 :=
  (Lp.compMeasurePreservingₗᵢ ℝ (fun t : ℝ => t-δ)
    (measurePreserving_sub_right (volume : Measure ℝ) δ)).toContinuousLinearMap

-- @paper-step thm:complete_robust/actual_translation_operator
theorem shiftOp_coe (δ : ℝ) (g : RealL1) :
    (shiftOp δ g : ℝ → ℝ)=ᵐ[volume] shift δ g :=
  Lp.coeFn_compMeasurePreserving g (measurePreserving_sub_right (volume : Measure ℝ) δ)

-- @paper-step thm:complete_robust/translation_operator_norm
theorem shiftOp_norm (δ : ℝ) : ‖shiftOp δ‖≤1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ zero_le_one
  intro g
  simpa [shiftOp] using (le_refl ‖g‖)

structure IMCFilter where
  direct : ℝ
  delayed : ℝ
  residue : ℝ
  delay : ℝ
  timeConstant : ℝ
  delay_nonneg : 0≤delay
  timeConstant_pos : 0<timeConstant

noncomputable def filterAction (F : IMCFilter) (g : ℝ → ℝ) (t : ℝ) : ℝ :=
  F.direct*g t+F.delayed*shift F.delay g t+F.residue*(lagKernel F.timeConstant ⋆ g) t
noncomputable def filterOp (F : IMCFilter) : RealL1 →L[ℝ] RealL1 :=
  F.direct • (1 : RealL1 →L[ℝ] RealL1)+F.delayed • shiftOp F.delay+
    F.residue • convOp (lagKernel_properties F.timeConstant_pos).1
noncomputable def filterGain (F : IMCFilter) : ℝ := |F.direct|+|F.delayed|+|F.residue|
noncomputable def filterTransfer (F : IMCFilter) (p : ℝ) : ℝ :=
  F.direct+F.delayed*Real.exp (-F.delay*p)+F.residue/(1+F.timeConstant*p)

-- @paper-step thm:complete_robust/filter_operator_ordinary_semantics
theorem filterOp_coe (F : IMCFilter) (g : RealL1) :
    (filterOp F g : ℝ → ℝ)=ᵐ[volume] filterAction F g := by
  change (↑(F.direct • g+F.delayed • shiftOp F.delay g+
    F.residue • convOp (lagKernel_properties F.timeConstant_pos).1 g) : ℝ → ℝ)=ᵐ[volume] _
  filter_upwards [Lp.coeFn_add (F.direct • g+F.delayed • shiftOp F.delay g)
    (F.residue • convOp (lagKernel_properties F.timeConstant_pos).1 g),
    Lp.coeFn_add (F.direct • g) (F.delayed • shiftOp F.delay g),
    Lp.coeFn_smul F.direct g,Lp.coeFn_smul F.delayed (shiftOp F.delay g),
    Lp.coeFn_smul F.residue (convOp (lagKernel_properties F.timeConstant_pos).1 g),
    shiftOp_coe F.delay g,convOp_coe (lagKernel_properties F.timeConstant_pos).1 g]
    with t ht ha hd hb hk hs hc
  simp only [ht,Pi.add_apply,ha,hd,hb,hk,Pi.smul_apply,smul_eq_mul,hs,hc,filterAction]

-- @paper-step thm:complete_robust/filter_operator_total_variation_bound
theorem filterOp_bound (F : IMCFilter) : ‖filterOp F‖≤filterGain F := by
  have hk : ‖convOp (lagKernel_properties F.timeConstant_pos).1‖≤1 := by
    calc
      _ ≤ absArea (lagKernel F.timeConstant) volume := convOp_norm _
      _ = 1 := by rw [positive_kernel_mass (ae_of_all _ (lagKernel_properties F.timeConstant_pos).2.1),
        (lagKernel_properties F.timeConstant_pos).2.2.1]
  have h₁ := norm_add_le (F.direct • (1 : RealL1 →L[ℝ] RealL1)) (F.delayed • shiftOp F.delay)
