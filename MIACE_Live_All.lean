  constructor
  · unfold stabilityV
    apply (le_div_iff₀ hd).2
    have heq : a/(2*b)*(z^2+w^2)*(2*b*c) = a*c*(z^2+w^2) := by field_simp <;> ring
    rw [heq]
    nlinarith [sq_nonneg (b*z+a*w),mul_nonneg (sq_nonneg c) (sq_nonneg z)]
  · unfold stabilityV stabilityC
    rw [div_mul_eq_mul_div]
    apply (div_le_div_iff_of_pos_right hd).2
    nlinarith [sq_nonneg (b*z-a*w),mul_nonneg (sq_nonneg a) (sq_nonneg z),
      mul_nonneg (sq_nonneg b) (sq_nonneg w),
      mul_nonneg (mul_pos hc (add_pos ha hc)).le (sq_nonneg w),
      mul_nonneg (mul_pos ha hc).le (sq_nonneg z)]

