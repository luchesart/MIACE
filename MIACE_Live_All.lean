      laplace a p=(ρ*a₀-laplace b p)/(1+ρ*p) := by
    have he := laplace_linear hLi
      (hLi.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hbi) (ρ*a₀) (-1) hp
    simp only [neg_one_mul,← sub_eq_add_neg] at he
    change laplace a p=_ at he
    rw [causal_convolution_laplace hLi hbi hLc hbc hp,lagKernel_laplace hρ hp] at he
    rw [he]
    ring
  have hBchar (p : ℝ) (hp : 0≤p) :
      (p*(1+ρ*p)+i*(1+ell*p)*Real.exp (-δ*p))*laplace b p=
      (1+ρ*p)*(b₀+laplace H p)+i*(ρ-ell)*a₀*Real.exp (-δ*p) := by
