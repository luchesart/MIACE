        simp only [mul_zero]
        exact mul_nonneg (mul_nonneg (Real.exp_nonneg _) (hK s)) (hR t ht)
    · simp [K,compactKernel,hs,expWeight]
  have hi := (compactKernel_weighted (compactTail_continuous hc δ) δ (c/a)).mul_const (R t)
  have hh := integral_mono_of_nonneg
    (ae_of_all _ (fun s => mul_nonneg (hK s) (hRn (t-s)))) hi (ae_of_all _ hb)
  rw [integral_mul_const,compactKernel_moment _ hδ] at hh
  exact hh

-- @paper-step thm:n_construction/even_parity_actual_command_nonnegative
theorem even_resolvent_command_nonneg {J : ℝ → ℝ} (hc : Continuous J) {δ a c : ℝ}
    (hδ : 0≤δ) (ha : 0<a) (hn : ∀ t∈Icc (0 : ℝ) δ, 0≤J t) {R : ℝ → ℝ}
