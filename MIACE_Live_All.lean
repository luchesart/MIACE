    ((hg.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hbox).const_mul _)).add
    ((hh.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hbox).const_mul _)).const_mul i |>.sub hg

