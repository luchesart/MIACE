abbrev RationalIndex (n : ℕ) := Unit ⊕ (Fin (n+1) ⊕ Fin (n+1))
noncomputable def rationalCoordinate (r : ℕ → ℝ) (n : ℕ) (δ : ℝ)
    (H : RationalHistory) (w : ℝ → ℝ) : RationalIndex n → ℝ → ℝ
  | .inl _ => w
  | .inr (.inl j) => rationalIState r δ H w j
  | .inr (.inr j) => rationalBState r δ H w j

-- @paper-step thm:n_construction/three_term_uniform_coordinate_estimate
theorem linear_three_bound (a b c x y z S : ℝ) (hx : |x|≤S) (hy : |y|≤S) (hz : |z|≤S) :
    |a*x+b*y+c*z|≤(|a|+|b|+|c|)*S := by
  have hh := (abs_add_le (a*x+b*y) (c*z)).trans
    (add_le_add (abs_add_le (a*x) (b*y)) (le_refl _))
  simp only [abs_mul] at hh
  nlinarith [mul_le_mul_of_nonneg_left hx (abs_nonneg a),
    mul_le_mul_of_nonneg_left hy (abs_nonneg b),mul_le_mul_of_nonneg_left hz (abs_nonneg c)]

-- @paper-step thm:n_construction/ordinary_full_coordinates_regular
 theorem rational_coordinates_regular (r : ℕ → ℝ) (n : ℕ) {δ a c : ℝ} (H : RationalHistory)
