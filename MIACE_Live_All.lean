-- @paper-step thm:complete_attainment/lag_transient_transform
theorem lag_transient_transform {σ p : ℝ} (hσ : 0<σ) (hp : 0≤p) :
    Integrable (fun t : ℝ => Real.exp (-t/σ)) halfLine ∧
      laplace (fun t : ℝ => Real.exp (-t/σ)) p=σ/(1+σ*p) := by
