  have hc : Causal (k ⋆ g) := ae_of_all volume
    (convolution_causal (causalize_causal _) (causalize_causal _))
  have he : (k ⋆ g)=ᵐ[halfLine] (fun t => Real.exp (-p*t)*(∫ s in 0..t, f s)) := by
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    exact damped_primitive_convolution f p (show 0<t from ht).le
  refine ⟨((hk.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hg).mono_measure
    Measure.restrict_le_self).congr he,?_⟩
  change (∫ t, Real.exp (-p*t)*(∫ s in 0..t, f s) ∂halfLine)=_
