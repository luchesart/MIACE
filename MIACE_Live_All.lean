-- @paper-step thm:complete_robust/causal_convolution_local_operator
theorem convolution_local_operator {K : ℝ → ℝ} (hK : Integrable K) (hKc : Causal K) :
    CausalLocalOperator (fun f => K ⋆ f) := by
  refine ⟨fun hf => hK.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hf,
