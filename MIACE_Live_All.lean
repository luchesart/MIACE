-- @paper-step thm:nonlinear_miace/global_minimum
theorem nonlinear_miace_global_minimum {a : ℝ → ℝ}
    (ha : Continuous a) (hapos : ∀ x, 0 < a x) {α : ℝ} (hα : 0 < α) :
    IsLeast {C : ℝ | ∃ y w : ℝ → ℝ, NonlinearResponse a y w ∧
        C = miace α (fun t => 1-y t) (fun t => w t-1) halfLine}
      (storageArea a * minimum α) := by
  obtain ⟨y, m, M, hw⟩ := nonlinear_optimal_feedback_exists ha hapos hα
  constructor
  · exact ⟨y, (fun t => 1 + (1-y t)/α), hw.response, hw.cost.symm⟩
  · rintro C ⟨z, w, hr, rfl⟩
    exact nonlinear_response_miace_lower_bound ha hapos hr α hα

-- This is the complete numbered statement under the manuscript's locally
-- Lipschitz hypothesis. The constituent results above in fact need only
-- continuity and positivity. Existence is constructed by an inverse clock;
-- it is not an assumption and makes no claim of uniqueness of all minimizers.
-- @paper-step thm:nonlinear_miace/full_statement
theorem paper_nonlinear_miace {a y w : ℝ → ℝ}
    (ha : LocallyLipschitz a) (hapos : ∀ x, 0 < a x)
    (h : NonlinearResponse a y w) (α : ℝ) (hα : 0 < α) :
    0 < storageArea a ∧
    ((∫ t, (1-y t) ∂halfLine) + (∫ t, (w t-1) ∂halfLine) = storageArea a) ∧
    (absArea (fun t => 1-y t) halfLine + absArea (fun t => w t-1) halfLine =
      storageArea a + 2 * (negArea (fun t => 1-y t) halfLine +
        negArea (fun t => w t-1) halfLine)) ∧
    ((miace α (fun t => 1-y t) (fun t => w t-1) halfLine)^2 -
        (storageArea a)^2 * (minimum α)^2 =
      4 * (minimum α)^2 *
        (negArea (fun t => 1-y t) halfLine + negArea (fun t => w t-1) halfLine) *
        (storageArea a + (negArea (fun t => 1-y t) halfLine +
          negArea (fun t => w t-1) halfLine)) +
      (absArea (fun t => 1-y t) halfLine -
        α * absArea (fun t => w t-1) halfLine)^2 / (1+α)) ∧
    (storageArea a * minimum α ≤
      miace α (fun t => 1-y t) (fun t => w t-1) halfLine) ∧
    (miace α (fun t => 1-y t) (fun t => w t-1) halfLine = storageArea a * minimum α ↔
      (∀ᵐ t ∂halfLine, 0 ≤ 1-y t) ∧ (∀ᵐ t ∂halfLine, 0 ≤ w t-1) ∧
      absArea (fun t => 1-y t) halfLine = α * absArea (fun t => w t-1) halfLine) ∧
    (miace α (fun t => 1-y t) (fun t => w t-1) halfLine = storageArea a * minimum α →
      MonotoneOn y (Ici 0) ∧ (∀ t : ℝ, 0 ≤ t → 0 ≤ y t ∧ y t ≤ 1)) ∧
    IsLeast {C : ℝ | ∃ z u : ℝ → ℝ, NonlinearResponse a z u ∧
        C = miace α (fun t => 1-z t) (fun t => u t-1) halfLine}
      (storageArea a * minimum α) ∧
    (∃ z m M, NonlinearOptimalFeedback a α z m M) := by
  have hc : Continuous a := ha.continuous
  exact ⟨storageArea_pos hc hapos, nonlinear_response_signed_balance hc hapos h,
    nonlinear_response_area_balance hc hapos h, nonlinear_response_miace_gap hc hapos h α hα,
    nonlinear_response_miace_lower_bound hc hapos h α hα,
    nonlinear_response_miace_equality_iff hc hapos h α hα,
    nonlinear_minimizer_monotone hc hapos h α hα,
    nonlinear_miace_global_minimum hc hapos hα,
    nonlinear_optimal_feedback_exists hc hapos hα⟩

end MIACE

