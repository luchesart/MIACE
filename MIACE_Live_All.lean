  rw [intervalIntegral.integral_add (hR.abs.intervalIntegrable t (t+1)) intervalIntegrable_const,
    intervalIntegral.integral_const,intervalIntegral.integral_const] at hbound
  simp only [add_sub_cancel_left,smul_eq_mul,one_mul] at hbound
  have hlocal : IntervalIntegrable (causalize R) volume t (t+1) := by
    apply (hR.intervalIntegrable t (t+1)).congr
    intro s hs
    rw [uIoc_of_le (show t≤t+1 by linarith)] at hs
