-- @paper-step thm:pid_two_rate_optimum/balanced_residue_enclosure
theorem balanced_A_bounds :
    (433 : ℝ)/100 < twoRateA (pidRho (8/5) (1/4) 5 6) 5 6 ∧
      twoRateA (pidRho (8/5) (1/4) 5 6) 5 6 < 434/100 := by
  obtain ⟨hρ₁,hρ₂⟩ := balanced_rho_bounds
