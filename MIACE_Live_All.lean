structure TwoRateData (i ρ ell l m δ : ℝ) : Prop where
  integral_pos : 0 < i
  filter_pos : 0 < ρ
  filter_lt_one : ρ < 1
  lead_gt_filter : ρ < ell
  delay_nonneg : 0 ≤ δ
  lower_rate : 1 < l
  ordered_rates : l < m
  filter_lower : m ≤ 1/ρ
  filter_upper : 1/ρ ≤ l+m-1
