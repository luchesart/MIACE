    ((he.integrator_continuous.sub he.output_continuous).const_mul x)
    ((hE.integrator_continuous.sub hE.output_continuous).const_mul x)
    (fun t ht => by simp [hy t ht,hz t ht])
    (delayedPI_command_deriv he) (delayedPI_command_deriv hE)
