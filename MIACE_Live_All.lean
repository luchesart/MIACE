theorem delayedPI_internal_stability_iff {x δ : ℝ} (hx : 0<x) (hδ : 0≤δ) :
    DelayedPIAsymptoticallyStable x δ ↔ x*δ<Real.pi/2 := by
  constructor
  · intro h
    exact delayedPI_attraction_necessary hx hδ h.attraction
  · intro hb
    refine ⟨fun φ ψ hφ hψ => delayedPI_finite_history_exists hx hδ hφ hψ,
      fun y z Y Z he hE hy hz => delayedPI_finite_history_unique hx hδ he hE hy hz,
      ⟨delayedPIHistoryGain x δ,delayedPIHistoryGain_pos hx hδ hb,?_⟩,
      fun y z he => delayedPI_states_tendsto_zero hx hδ hb he,
      fun y z he => delayedPI_transport_attraction hx hδ hb he⟩
    intro M y z hM he hh t ht
    exact delayedPI_uniform_history_bound hx hδ hb hM he hh ht

