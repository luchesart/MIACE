      (div_lt_iff₀ hρ).mpr (by linarith)
    simp only [one_div] at hh
    linarith

-- @paper-step thm:pid_two_rate_optimum/balanced_command_sign_check
theorem balanced_forcing_check :
    ∀ t ∈ Icc (0 : ℝ) (1/4),
      0 ≤ twoRateR (twoRateA (pidRho (8/5) (1/4) 5 6) 5 6) 5 6 (1/4) t := by
  obtain ⟨hA₁,hA₂⟩ := balanced_A_bounds
