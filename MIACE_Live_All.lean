      (∀ x ∈ Icc (0 : ℝ) 1, a x ≤ M) := by
  obtain ⟨xm, hxm, hmin⟩ := isCompact_Icc.exists_isMinOn
    (show (Icc (0 : ℝ) 1).Nonempty from ⟨0, by norm_num⟩) ha.continuousOn
  obtain ⟨xM, hxM, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (show (Icc (0 : ℝ) 1).Nonempty from ⟨0, by norm_num⟩) ha.continuousOn
  exact ⟨a xm, a xM, hapos xm, ⟨xm, hxm, rfl⟩, ⟨xM, hxM, rfl⟩,
    fun x hx => hmin hx, fun x hx => hmax hx⟩

