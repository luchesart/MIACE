  have hl := h.rate_pos
  have hord : l≤1/ρ := by apply (le_div_iff₀ hr).mpr; nlinarith
  have hint := intervalIntegral.integral_mono_on ht
    ((by fun_prop : Continuous (fun s : ℝ => Real.exp (-(1/ρ)*s))).intervalIntegrable (μ:=volume) 0 t)
    ((by fun_prop : Continuous (fun s : ℝ => Real.exp (-l*s))).intervalIntegrable (μ:=volume) 0 t)
    (fun s hs => Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_right (neg_le_neg hord) hs.1))
  rw [finite_exp_integral (ne_of_gt (one_div_pos.mpr hr)),finite_exp_integral (ne_of_gt hl)] at hint
