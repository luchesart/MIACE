    (continuous_const : Continuous (fun _ : ℝ => (1 : ℝ))).locallyIntegrable.add hv.locallyIntegrable
  have he : Integrable (fun t => 1-(1+v t)) halfLine := by
    convert (hv.mono_measure Measure.restrict_le_self).neg using 1
