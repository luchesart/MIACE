  simp only [pidStateSymbol,pidStateA0,pidStateA1,Matrix.sub_apply,Matrix.smul_apply,
    Matrix.map_apply,smul_eq_mul]
  norm_num
  field_simp
  <;> ring

-- @paper-step thm:pid_two_rate_optimum/uncancelled_physical_factorization
theorem pid_state_factorization {i ρ ell l m δ : ℝ} (h : TwoRateData i ρ ell l m δ) (p : ℂ) :
    (pidStateSymbol (i*(1+ell-ρ)) i (i*(ell-ρ)*(1-ρ)) ρ δ p).det=
      (p+1)*pidCharacteristic i ρ ell δ p/(ρ : ℂ) := by
  rw [pid_state_determinant _ _ _ _ (ne_of_gt h.filter_pos)]
  unfold pidCharacteristic
  push_cast
