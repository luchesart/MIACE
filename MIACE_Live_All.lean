  have hr1 : ρ<1 := by rw [h.filter_eq]; linarith
  have hrl : ρ<ell := by rw [h.lead_eq,lt_div_iff₀ hi]; nlinarith
  have hle : l*ρ< i := by
    have hh := h.command_tail
    rw [← h.filter_eq] at hh
    nlinarith
  have hell : ell<1/l := by
    rw [h.lead_eq,div_lt_div_iff₀ hi hl]
    nlinarith
  have hlr : 0<1-l*ρ := by nlinarith
  exact ⟨hr,hrl,hell,hr1,hlr⟩

-- @paper-step thm:pid_explicit_family/positive_partial_fraction_coefficients
theorem explicitPID_coefficients {i ρ ell l δ : ℝ} (h : ExplicitPIDData i ρ ell l δ) :
    0<explicitA ρ ell l ∧ 0<explicitB ρ ell l ∧
