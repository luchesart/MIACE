        ((shift_integrable δ hJi).const_mul (i*(ρ-ell)*a₀)))
        (hGi.integrable_convolution (ContinuousLinearMap.lsmul ℝ ℝ) hHi) 1 1 hp
      simp only [one_mul,Pi.add_apply] at h₁
      change laplace f p=_ at h₁
      rw [h₁]
      change laplace (fun t => b₀*G t+(i*(ρ-ell)*a₀)*shift δ J t) p+laplace (G ⋆ H) p=_
      rw [laplace_linear hGi (shift_integrable δ hJi) b₀ (i*(ρ-ell)*a₀) hp,
        laplace_shift hJc hδ p,
        causal_convolution_laplace hLi hGi hLc hGc hp,
        causal_convolution_laplace hGi hHi hGc hHc hp]
    change (p*(1+ρ*p)+i*(1+ell*p)*Real.exp (-δ*p))*laplace f p=_
    rw [hFhat,show laplace L p=1/(1+ρ*p) from lagKernel_laplace hρ hp]
    have hg := hGT p hp
