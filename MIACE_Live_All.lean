theorem pidTimeCommand_transform {f : ℝ → ℝ} (hf : Integrable f halfLine)
    (pc i dc : ℝ) {ρ p : ℝ} (hρ : 0<ρ) (hp : 0<p) :
    Integrable (fun t => Real.exp (-p*t)*pidTimeCommand pc i dc ρ f t) halfLine ∧
    laplace (pidTimeCommand pc i dc ρ f) p=
