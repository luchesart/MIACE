theorem nonlinear_clock_rate_bounds {a : ℝ → ℝ} {c m M : ℝ}
    (hc : 0 < c) (hm : 0 < m)
    (hlo : ∀ x ∈ Icc (0 : ℝ) 1, m ≤ a x)
    (hup : ∀ x ∈ Icc (0 : ℝ) 1, a x ≤ M) (s : ℝ) :
