/-! Етап 11: обикновени представители на подписаната резолвента.
    Оценките се отнасят до зададената функция f, а не до произволен
    представител на нейния клас в L¹. Изборът на η зависи само от ядрото. -/
namespace MIACE
open MeasureTheory Filter Set
open scoped Topology Convolution

noncomputable def signedRenewalRep {K f : ℝ → ℝ} (hK : Integrable K)
    (hf : Integrable (causalize f)) (t : ℝ) : ℝ :=
  f t + (K ⋆ ((∑' n : ℕ, (convOp hK)^n) (hf.toL1 (causalize f)) : RealL1)) t

-- @paper-step thm:pid_two_rate_optimum/signed_ordinary_identification
theorem signedRenewalRep_ae {K f : ℝ → ℝ} (hK : Integrable K)
    (hKc : Causal K) (hq : absArea K volume<1) (hf : Integrable (causalize f)) :
    ((∑' n : ℕ, (convOp hK)^n) (hf.toL1 (causalize f)) : RealL1) =ᵐ[volume]
      causalize (signedRenewalRep hK hf) := by
  have hgc := causal_congr (causalize_causal f) hf.coeFn_toL1.symm
  exact renewal_representative_ae hK hKc hf
    (causal_renewal_series hK hKc ((convOp_norm hK).trans_lt hq) hgc)
    (signed_renewal_l1 hK hq _).2.1

-- @paper-step thm:pid_two_rate_optimum/signed_ordinary_integral_equation
theorem signedRenewalRep_equation {K f : ℝ → ℝ} (hK : Integrable K)
    (hKc : Causal K) (hq : absArea K volume<1) (hf : Integrable (causalize f))
    {t : ℝ} (ht : 0≤t) :
