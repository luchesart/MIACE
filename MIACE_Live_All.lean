      rw [he]
      exact linear_three_bound _ _ _ _ _ _ _ (hbnow _ t) (hbnow _ t) (hbnow _ t)
    · cases hj : j.val with
      | zero =>
        filter_upwards [hIw.1.ode,hIW.1.ode] with t ht hT ht0
        have hh := ((ht ht0).sub (hT ht0)).deriv
        change deriv (fun s => remainderFilter r δ H.controllerInitial w 0 s-remainderFilter r δ H.controllerInitial W 0 s) t=_ at hh
        have hder : deriv (x (.inr (.inl j))) t=
            r j*0+(r j*remainderFeed r δ j)*x (.inl ()) t+(-r j)*x (.inr (.inl j)) t := by
          change deriv (fun s => remainderFilter r δ H.controllerInitial w j s-remainderFilter r δ H.controllerInitial W j s) t=_
          simp only [hj]
          rw [hh]
          simp only [div_div_eq_mul_div,div_one]
          dsimp [x,rationalCoordinate,rationalIState]
          rw [hj]
          ring
        rw [hder]
        exact linear_three_bound _ _ _ _ _ _ _ (hzero t) (hbnow _ t) (hbnow _ t)
      | succ m =>
        filter_upwards [(hIw.2 m).ode,(hIW.2 m).ode] with t ht hT ht0
        have hh := ((ht ht0).sub (hT ht0)).deriv
        have hm : m<n+1 := by omega
