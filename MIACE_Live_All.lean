noncomputable def stabilityV (a b c z w : ℝ) : ℝ :=
  ((b*z+a*w)^2+c*(a+c)*z^2+a*c*w^2)/(2*b*c)
noncomputable def stabilityC (a b c : ℝ) : ℝ :=
  (2*b^2+2*a^2+c*(a+c)+a*c)/(2*b*c)

