    · have hpw := (serialState_evolution huw (fun j => 1/r j) H.plantInitial j).2
      have hpW := (serialState_evolution huW (fun j => 1/r j) H.plantInitial j).2
      filter_upwards [hpw.ode,hpW.ode] with t ht hT ht0
      have hh := ((ht ht0).sub (hT ht0)).deriv
      change deriv (x (.inr (.inr j))) t=_ at hh
      cases hj : j.val with
