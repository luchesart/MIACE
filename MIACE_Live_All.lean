    Finset.single_le_sum (f := fun j => |x j t|) (fun j _ => abs_nonneg _) (Finset.mem_univ k)
  have hf (t : ℝ) : 0≤f t := Finset.sum_nonneg (fun _ _ => abs_nonneg _)
