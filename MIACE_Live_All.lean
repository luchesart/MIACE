    miace α (expError (1+1/α)) (expCommand (1+1/α)) halfLine = minimum α := by
  have hx : 1 ≤ 1+1/α := by
    have : 0 < 1/α := by positivity
    linarith
  have ha := exponential_areas (1+1/α) hx
  unfold miace minimum costSq
  rw [ha.1,ha.2]
  congr 1
  have h0 : α ≠ 0 := ne_of_gt hα
  have h1 : 1+α ≠ 0 := by linarith
  field_simp
  <;> ring

-- @paper-step thm:miace_shape_gap/unsquared_minimum
 theorem response_miace_lower_bound {e v : ℝ → ℝ} (h : FirstOrderResponse e v)
    (α : ℝ) (hα : 0 < α) : minimum α ≤ miace α e v halfLine := by
  apply Real.sqrt_le_sqrt
  have hb := cost_lower_bound α 1 (absArea e halfLine) (absArea v halfLine)
