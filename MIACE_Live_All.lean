      have heq : t ≤ s t / (c*m) := by
        simpa only [div_eq_mul_inv, mul_comm] using hsu
      have hi := (le_div_iff₀ (mul_pos hc hm)).mp heq
      nlinarith
    have hupS : s t ≤ c*M*t := by
      have heq : s t / (c*M) ≤ t := by
        simpa only [div_eq_mul_inv, mul_comm] using hsl
      have hi := (div_le_iff₀ (mul_pos hc hM)).mp heq
      nlinarith
    have hep : 0 < Real.exp (-s t) := Real.exp_pos _
    have he1 : Real.exp (-s t) ≤ 1 := Real.exp_le_one_iff.mpr (by linarith)
    have hel : Real.exp (-c*M*t) ≤ Real.exp (-s t) :=
      Real.exp_le_exp.mpr (by nlinarith)
    have heu : Real.exp (-s t) ≤ Real.exp (-c*m*t) :=
      Real.exp_le_exp.mpr (by nlinarith)
    dsimp [y]
    exact ⟨by linarith, by linarith, by linarith, by linarith⟩

-- @paper-step thm:nonlinear_miace/global_flow_admissibility
theorem nonlinear_flow_exists_admissible {a : ℝ → ℝ} (ha : Continuous a)
    (hapos : ∀ x, 0 < a x) {c m M : ℝ} (hc : 0 < c) (hm : 0 < m)
